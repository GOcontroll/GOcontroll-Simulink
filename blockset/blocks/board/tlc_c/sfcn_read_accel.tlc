%implements sfcn_read_accel "C"

%% Function: BlockTypeSetup ==========================================================
%%
%% Purpose:
%%      Add the controller info header to the generated code includes.
%%
%function BlockTypeSetup(block, system) void
	%<LibAddToCommonIncludes("GO_board.h")>
%endfunction

%% Function: BlockInstanceSetup ======================================================
%%
%% Purpose:
%%      Enforce that only one accelerometer block is present in the model.
%%      Set the global flag used by ert_stm_main.tlc to start the ControllerInfo task.
%%
%function BlockInstanceSetup(block, system) void
	%if EXISTS(::read_accel) == 0
		%assign ::read_accel = 1
	%else
		%<LibBlockReportError(block, "There cannot be more than one read accelerometer blocks in a model")>
	%endif
%endfunction

%% Function: Start ==========================================================
%%
%% Purpose:
%%      No initialisation - the ControllerInfo task is started from ert_stm_main.tlc.
%%
%function Start(block, system) Output
	%%
%endfunction

%% Function: Outputs ==========================================================
%%
%% Purpose:
%%      Read the latest accelerometer/gyroscope/temperature data from the
%%      ControllerInfo task and forward it to the block output signals.
%%
%function Outputs(block, system) Output
	{
		GOcontrollControllerInfo_t _ci_data;
		GO_board_controller_info_get_data(&_ci_data);
		%<LibBlockOutputSignal(0, "", "", 0)> = _ci_data.acc_x;
		%<LibBlockOutputSignal(1, "", "", 0)> = _ci_data.acc_y;
		%<LibBlockOutputSignal(2, "", "", 0)> = _ci_data.acc_z;
		%<LibBlockOutputSignal(3, "", "", 0)> = _ci_data.gyro_x;
		%<LibBlockOutputSignal(4, "", "", 0)> = _ci_data.gyro_y;
		%<LibBlockOutputSignal(5, "", "", 0)> = _ci_data.gyro_z;
	}
%endfunction

%% Function: Terminate ==========================================================
%%
%% Purpose:
%%      No termination - the ControllerInfo task runs for the lifetime of the application.
%%
%function Terminate(block, system) Output
	%%
%endfunction

%%******************************* end of sfcn_read_accel.tlc ***************************
