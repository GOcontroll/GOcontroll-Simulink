        <Value>0 - 5 V</Value>
        <TypeOptions>
          <Option>0 - 5 V</Option>
          <Option>0 - 10V (external sensor supply)</Option>
          <Option>0 - 24V (external sensor supply)</Option>
        </TypeOptions>
      </MaskParameter>
      <MaskParameter Name="C5afil" Type="edit">
