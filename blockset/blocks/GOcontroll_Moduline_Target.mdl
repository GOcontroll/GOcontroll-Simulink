  </Block>
  <Block BlockType="M-S-Function" Name="MQTT Broker" SID="4346">
    <PortCounts/>
    <P Name="Position">[330, 232, 485, 308]</P>
    <P Name="ZOrder">474</P>
    <P Name="BackgroundColor">[1.000000, 0.666667, 0.000000]</P>
    <List ListType="RTWdata">
      <P Name="broker"/>
      <P Name="port">0</P>
      <P Name="user"/>
      <P Name="password"/>
      <P Name="client"/>
      <P Name="ttl">60</P>
      <P Name="apn">super</P>
      <P Name="pin"/>
    </List>
    <P Name="CopyFcn">go_block_platform_check(gcb, &apos;STM&apos;, &apos;notify&apos;);</P>
    <P Name="FunctionName">sfcn_MQTT_broker</P>
    <Mask SelfModifiable="on">
      <Type>MQTT Broker</Type>
      <Display RunInitForIconRedraw="on" IconUnits="pixels">if isempty(broker)
fprintf(&quot;Broker: from controller&quot;);
else
fprintf(broker + &quot;\nPort: %d&quot;, port);
end
%port_label(&apos;input&apos;, 1, &apos;message&apos;);
text(2, 6, GOcontroll_Simulink_version());</Display>
      <Description>&lt;p&gt;&lt;b&gt;MQTT Broker&lt;/b&gt;&lt;/p&gt;

&lt;p&gt;
Configures the connection to an MQTT broker. This block is required in every model
that uses MQTT Publish or MQTT Subscribe blocks.
Only one MQTT Broker block may be used per model.
&lt;/p&gt;

&lt;p&gt;&lt;b&gt;Settings on the controller&lt;/b&gt;&lt;/p&gt;

&lt;p&gt;
The broker URL, port, user and password, and the SIM pin code, can also be set on the
Moduline S1 itself during commissioning (GOcontroll Deployment Tool). Every field you leave
empty here (port: 0) is taken from those controller settings, so the application never has
to contain credentials. A value filled in here takes precedence over the controller setting.
User and password go together: fill in both here, or leave both empty.
&lt;/p&gt;

&lt;p&gt;&lt;b&gt;Parameters&lt;/b&gt;&lt;/p&gt;

&lt;p&gt;
&lt;b&gt;Provider APN&lt;/b&gt; — access point name of the mobile data provider (e.g. super, internet).&lt;br/&gt;
&lt;b&gt;SIM pin code&lt;/b&gt; — PIN code of the SIM card. Leave empty to use the PIN set on the controller (default 0000). The controller enters it only when the SIM asks for a PIN, and never retries a PIN the SIM refused.&lt;br/&gt;
&lt;b&gt;Client&lt;/b&gt; — unique client identifier for this device on the broker. Leave empty to use the controller serial number.&lt;br/&gt;
&lt;b&gt;Broker URL&lt;/b&gt; — hostname or IP address of the MQTT broker, optionally prefixed mqtt:// or mqtts://. Leave empty to use the broker set on the controller.&lt;br/&gt;
&lt;b&gt;Broker port&lt;/b&gt; — TCP port of the MQTT broker. 0 = the port set on the controller; without one 1883 (8883 for mqtts://).&lt;br/&gt;
&lt;b&gt;User&lt;/b&gt; — username for broker authentication. Leave empty to use the user and password set on the controller.&lt;br/&gt;
&lt;b&gt;Password&lt;/b&gt; — password for broker authentication, used together with User.&lt;br/&gt;
&lt;b&gt;Time to live (s)&lt;/b&gt; — keep-alive interval in seconds. The controller sends a ping to the broker at this interval to maintain the connection.
&lt;/p&gt;&lt;p&gt;&lt;b&gt;For the Moduline S1 only.&lt;/b&gt;&lt;/p&gt;</Description>
      <Initialization>go_block_platform_check(gcb, &apos;STM&apos;);
mdl = bdroot;
cs  = getActiveConfigSet(mdl);
try
t = go_target_name(get_param(cs,&apos;tlcGOcontrollTarget&apos;));
catch
t = &quot;Unknown controller&quot;;
end
msk = Simulink.Mask.get(gcb);
c = msk.getParameter(&apos;ContrType&apos;);
c.Value = t;

if contains(t, &apos;Moduline S1&apos;)

else

end

    % update RTWdata to call WriteRTW again
    modelRTWFields = struct( &apos;broker&apos;, broker,&apos;port&apos;, num2str(port), &apos;user&apos;, user, &apos;password&apos; , password, &apos;client&apos;, client, &apos;ttl&apos;, num2str(ttl),...
        &apos;apn&apos;, apn, &apos;pin&apos;, pin);

    % Insert modelRTWFields in the I/O block S-Function containing the Tag starting with &apos;HANcoder_TARGET_&apos;
    HANcoder_TARGET_DataBlock = find_system(gcb, &apos;RegExp&apos;, &apos;on&apos;, &apos;FollowLinks&apos;, &apos;on&apos;, &apos;LookUnderMasks&apos;, &apos;all&apos;, &apos;BlockType&apos;, &apos;M-S-Function&apos;);
    set_param(HANcoder_TARGET_DataBlock{1}, &apos;RTWdata&apos;, modelRTWFields);</Initialization>
      <Help>&lt;html&gt;&lt;body style=&quot;font-family:sans-serif&quot;&gt;&lt;h2&gt;MQTT Broker&lt;/h2&gt;&lt;p&gt;Connects the Moduline S1 to an MQTT broker over its 4G modem. Needed once in every model that publishes or subscribes.&lt;/p&gt;&lt;h3&gt;How to use it&lt;/h3&gt;&lt;ul&gt;&lt;li&gt;&lt;b&gt;Provider APN&lt;/b&gt; and &lt;b&gt;SIM pin code&lt;/b&gt;: the settings of the SIM card.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Broker URL&lt;/b&gt; and &lt;b&gt;Broker port&lt;/b&gt;: the address of the broker, optionally starting with mqtt:// or mqtts://. Without a port: 1883, or 8883 for mqtts://.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Client&lt;/b&gt;, &lt;b&gt;User&lt;/b&gt;, &lt;b&gt;Password&lt;/b&gt;: how the controller logs in. An empty &lt;i&gt;Client&lt;/i&gt; uses the serial number. Fill in &lt;i&gt;User&lt;/i&gt; and &lt;i&gt;Password&lt;/i&gt; together or leave both empty.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Time to live (s)&lt;/b&gt;: the keep-alive time.&lt;/li&gt;&lt;li&gt;Every field you leave empty (port 0) is taken from the settings stored on the controller during commissioning. That way the application does not have to contain passwords. A value filled in here wins.&lt;/li&gt;&lt;li&gt;Only one MQTT Broker block per model.&lt;/li&gt;&lt;/ul&gt;&lt;h3&gt;Controllers&lt;/h3&gt;&lt;p&gt;Moduline S1 only. In a model for a Linux controller (Moduline M1, L4, HMI1) the block gives an error. The greyed-out field &lt;i&gt;Controller type&lt;/i&gt;, when the block has one, shows the controller chosen under &lt;i&gt;Configuration Parameters &amp;gt; Code Generation &amp;gt; GOcontroll options &amp;gt; Target&lt;/i&gt;; the choices in the block follow it.&lt;/p&gt;&lt;h3&gt;GOcontroll knowledge base&lt;/h3&gt;&lt;ul&gt;&lt;li&gt;&lt;a href=&quot;https://gocontroll.com/knowledge-base/modular-hardware/controllers/s1/&quot;&gt;Moduline S1&lt;/a&gt;&lt;br&gt;https://gocontroll.com/knowledge-base/modular-hardware/controllers/s1/&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;https://gocontroll.com/knowledge-base/getting-started/programming/simulink/blockset-information/&quot;&gt;Using the blockset&lt;/a&gt;&lt;br&gt;https://gocontroll.com/knowledge-base/getting-started/programming/simulink/blockset-information/&lt;/li&gt;&lt;/ul&gt;&lt;/body&gt;&lt;/html&gt;</Help>
      <MaskParameter Name="ContrType" Type="edit" Evaluate="off" Enabled="off">
        <Prompt>Controller type</Prompt>
        <Value>Unknown controller</Value>
      </MaskParameter>
      <MaskParameter Name="apn" Type="edit" Evaluate="off">
        <Prompt>Provider APN</Prompt>
        <Value>super</Value>
      </MaskParameter>
      <MaskParameter Name="pin" Type="edit" Evaluate="off">
        <Prompt>SIM pin code</Prompt>
      </MaskParameter>
      <MaskParameter Name="client" Type="edit" Evaluate="off">
        <Prompt>Client</Prompt>
      </MaskParameter>
      <MaskParameter Name="broker" Type="edit" Evaluate="off">
        <Prompt>Broker URL</Prompt>
      </MaskParameter>
      <MaskParameter Name="port" Type="edit">
        <Prompt>Broker port</Prompt>
        <Value>0</Value>
      </MaskParameter>
      <MaskParameter Name="user" Type="edit" Evaluate="off">
        <Prompt>User</Prompt>
      </MaskParameter>
      <MaskParameter Name="password" Type="edit" Evaluate="off">
        <Prompt>Password</Prompt>
      </MaskParameter>
      <MaskParameter Name="ttl" Type="edit">
        <Prompt>Time to live (s)</Prompt>
        <Value>60</Value>
      </MaskParameter>
      <DialogControl Type="Group" Name="DescGroupVar">
        <Prompt>%&lt;MaskType&gt;</Prompt>
        <DialogControl Type="Text" Name="DescTextVar">
          <Prompt>%&lt;MaskDescription&gt;</Prompt>
        </DialogControl>
      </DialogControl>
      <DialogControl Type="Group" Name="modemContainer">
        <Prompt>Modem details</Prompt>
        <DialogControl Type="Edit" Name="ContrType">
          <Prompt>Controller type</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="Edit" Name="apn">
          <Prompt>Provider APN</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="Edit" Name="pin">
          <Prompt>SIM pin code</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
      </DialogControl>
      <DialogControl Type="Group" Name="ParameterGroupVar">
        <Prompt>Broker details</Prompt>
        <DialogControl Type="Edit" Name="client">
          <Prompt>Client</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="Edit" Name="broker">
          <Prompt>Broker URL</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="Edit" Name="port">
          <Prompt>Broker port</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="Edit" Name="user">
          <Prompt>User</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="Edit" Name="password">
          <Prompt>Password</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="Edit" Name="ttl">
          <Prompt>Time to live (s)</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
      </DialogControl>
    </Mask>
  </Block>
  <Block BlockType="M-S-Function" Name="MQTT Publish" SID="4347">
    <PortCounts in="2"/>
    <P Name="Position">[330, 342, 485, 418]</P>
    <P Name="ZOrder">475</P>
    <P Name="BackgroundColor">[1.000000, 0.666667, 0.000000]</P>
    <List ListType="RTWdata">
      <P Name="qos">0</P>
      <P Name="retain">0</P>
      <P Name="len_source">1</P>
    </List>
    <P Name="CopyFcn">go_block_platform_check(gcb, &apos;STM&apos;, &apos;notify&apos;);</P>
    <P Name="FunctionName">sfcn_MQTT_publish</P>
    <P Name="Parameters">tsamp, len_source</P>
    <Mask SelfModifiable="on">
      <Type>MQTT Publish</Type>
      <Display RunInitForIconRedraw="on" IconUnits="pixels">fprintf(&quot;MQTT publish&quot;);
port_label(&apos;input&apos;, 1, &apos;Topic&apos;);
port_label(&apos;input&apos;, 2, &apos;Payload&apos;);
if len_source == 2
    port_label(&apos;input&apos;, 3, &apos;Len&apos;);
end
text(2, 6, GOcontroll_Simulink_version());</Display>
      <Description>&lt;p&gt;&lt;b&gt;MQTT Publish&lt;/b&gt;&lt;/p&gt;

&lt;p&gt;
Publishes a payload to an MQTT topic each model step.
Requires an MQTT Broker block in the model.
&lt;/p&gt;

&lt;p&gt;&lt;b&gt;Input ports&lt;/b&gt;&lt;/p&gt;

&lt;p&gt;
&lt;b&gt;Topic&lt;/b&gt; — uint8 array (null-terminated string, max 64 characters). The topic to publish to.&lt;br/&gt;
&lt;b&gt;Payload&lt;/b&gt; — any data type and width. The raw bytes to publish.&lt;br/&gt;
&lt;b&gt;Len&lt;/b&gt; (optional) — uint16 scalar. Actual byte count to publish.
Only present when &lt;i&gt;Payload length&lt;/i&gt; is set to &lt;b&gt;From port&lt;/b&gt;.
Connect to the &lt;b&gt;Len&lt;/b&gt; output of the JSON Constructor block.
&lt;/p&gt;

&lt;p&gt;&lt;b&gt;Parameters&lt;/b&gt;&lt;/p&gt;

&lt;p&gt;
&lt;b&gt;Sample time&lt;/b&gt; — model sample time in seconds.&lt;br/&gt;
&lt;b&gt;Payload length&lt;/b&gt; — &lt;b&gt;Auto&lt;/b&gt;: use sizeof(payload type) × signal width (suitable for typed signals).
&lt;b&gt;From port&lt;/b&gt;: use the value on the &lt;i&gt;Len&lt;/i&gt; input port (suitable for variable-length payloads such as JSON strings).&lt;br/&gt;
&lt;b&gt;Quality of service&lt;/b&gt; — MQTT QoS level: 0 (at most once), 1 (at least once), or 2 (exactly once).&lt;br/&gt;
&lt;b&gt;Retain&lt;/b&gt; — when set to Retain message, the broker stores the last message and delivers it to new subscribers immediately upon connection.
&lt;/p&gt;&lt;p&gt;&lt;b&gt;For the Moduline S1 only.&lt;/b&gt;&lt;/p&gt;</Description>
      <Initialization>go_block_platform_check(gcb, &apos;STM&apos;);
mdl = bdroot;
cs  = getActiveConfigSet(mdl);
try
t = go_target_name(get_param(cs,&apos;tlcGOcontrollTarget&apos;));
catch
t = &quot;Unknown controller&quot;;
end
msk = Simulink.Mask.get(gcb);
c = msk.getParameter(&apos;ContrType&apos;);
c.Value = t;

    % update RTWdata
    modelRTWFields = struct( &apos;qos&apos;, num2str(qos - 1), &apos;retain&apos;, num2str(retain - 1), &apos;len_source&apos;, num2str(len_source));

    % Insert modelRTWFields in the I/O block S-Function
    HANcoder_TARGET_DataBlock = find_system(gcb, &apos;RegExp&apos;, &apos;on&apos;, &apos;FollowLinks&apos;, &apos;on&apos;, &apos;LookUnderMasks&apos;, &apos;all&apos;, &apos;BlockType&apos;, &apos;M-S-Function&apos;);
    set_param(HANcoder_TARGET_DataBlock{1}, &apos;RTWdata&apos;, modelRTWFields);</Initialization>
      <Help>&lt;html&gt;&lt;body style=&quot;font-family:sans-serif&quot;&gt;&lt;h2&gt;MQTT Publish&lt;/h2&gt;&lt;p&gt;Publishes a message on an MQTT topic. The model needs an &lt;i&gt;MQTT Broker&lt;/i&gt; block.&lt;/p&gt;&lt;h3&gt;How to use it&lt;/h3&gt;&lt;ul&gt;&lt;li&gt;Input &lt;b&gt;Topic&lt;/b&gt;: the topic as text (uint8 array ending in 0, at most 64 characters).&lt;/li&gt;&lt;li&gt;Input &lt;b&gt;Payload&lt;/b&gt;: the data, any type and width.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Payload length&lt;/b&gt;: &lt;i&gt;Auto&lt;/i&gt; sends the whole signal; &lt;i&gt;From port&lt;/i&gt; adds an input &lt;b&gt;Len&lt;/b&gt;, used for JSON text from the &lt;i&gt;JSON Constructor&lt;/i&gt; block.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Quality of service&lt;/b&gt; (0, 1, 2) and &lt;b&gt;Retain&lt;/b&gt;.&lt;/li&gt;&lt;li&gt;The &lt;b&gt;Sample time&lt;/b&gt; is the publish rate (default 5 s). Mobile data costs money: do not publish faster than needed.&lt;/li&gt;&lt;/ul&gt;&lt;h3&gt;Controllers&lt;/h3&gt;&lt;p&gt;Moduline S1 only. In a model for a Linux controller (Moduline M1, L4, HMI1) the block gives an error. The greyed-out field &lt;i&gt;Controller type&lt;/i&gt;, when the block has one, shows the controller chosen under &lt;i&gt;Configuration Parameters &amp;gt; Code Generation &amp;gt; GOcontroll options &amp;gt; Target&lt;/i&gt;; the choices in the block follow it.&lt;/p&gt;&lt;h3&gt;GOcontroll knowledge base&lt;/h3&gt;&lt;ul&gt;&lt;li&gt;&lt;a href=&quot;https://gocontroll.com/knowledge-base/modular-hardware/controllers/s1/&quot;&gt;Moduline S1&lt;/a&gt;&lt;br&gt;https://gocontroll.com/knowledge-base/modular-hardware/controllers/s1/&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;https://gocontroll.com/knowledge-base/getting-started/programming/simulink/blockset-information/&quot;&gt;Using the blockset&lt;/a&gt;&lt;br&gt;https://gocontroll.com/knowledge-base/getting-started/programming/simulink/blockset-information/&lt;/li&gt;&lt;/ul&gt;&lt;/body&gt;&lt;/html&gt;</Help>
      <MaskParameter Name="ContrType" Type="edit" Evaluate="off" Enabled="off">
        <Prompt>Controller type</Prompt>
        <Value>Unknown controller</Value>
      </MaskParameter>
      <MaskParameter Name="tsamp" Type="edit">
        <Prompt>Sample time</Prompt>
        <Value>5</Value>
      </MaskParameter>
      <MaskParameter Name="len_source" Type="popup">
        <Prompt>Payload length</Prompt>
        <Value>Auto</Value>
        <TypeOptions>
          <Option>Auto</Option>
          <Option>From port</Option>
        </TypeOptions>
      </MaskParameter>
      <MaskParameter Name="qos" Type="popup">
        <Prompt>Quality of service</Prompt>
        <Value>0</Value>
        <TypeOptions>
          <Option>0</Option>
          <Option>1</Option>
          <Option>2</Option>
        </TypeOptions>
      </MaskParameter>
      <MaskParameter Name="retain" Type="popup">
        <Prompt>Retain</Prompt>
        <Value>Do not retain</Value>
        <TypeOptions>
          <Option>Do not retain</Option>
          <Option>Retain message</Option>
        </TypeOptions>
      </MaskParameter>
      <DialogControl Type="Group" Name="DescGroupVar">
        <Prompt>%&lt;MaskType&gt;</Prompt>
        <DialogControl Type="Text" Name="DescTextVar">
          <Prompt>%&lt;MaskDescription&gt;</Prompt>
        </DialogControl>
      </DialogControl>
      <DialogControl Type="Group" Name="ParameterGroupVar">
        <Prompt>Parameters</Prompt>
        <DialogControl Type="Edit" Name="ContrType">
          <Prompt>Controller type</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="Edit" Name="tsamp">
          <Prompt>Sample time</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="Popup" Name="len_source">
          <Prompt>Payload length</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="Popup" Name="qos">
          <Prompt>Quality of service</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="Popup" Name="retain">
          <Prompt>Retain</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
      </DialogControl>
    </Mask>
  </Block>
  <Block BlockType="M-S-Function" Name="MQTT Subscribe" SID="4349">
    <PortCounts in="1" out="3"/>
    <P Name="Position">[330, 452, 485, 528]</P>
    <P Name="ZOrder">477</P>
    <P Name="BackgroundColor">[1.000000, 0.666667, 0.000000]</P>
    <List ListType="RTWdata">
      <P Name="payload_size">150</P>
      <P Name="qos">1</P>
    </List>
    <P Name="CopyFcn">go_block_platform_check(gcb, &apos;STM&apos;, &apos;notify&apos;);</P>
    <P Name="FunctionName">sfcn_MQTT_subscribe</P>
    <P Name="Parameters">tsamp, payload_size</P>
    <Mask SelfModifiable="on">
      <Type>MQTT Subscribe</Type>
      <Display RunInitForIconRedraw="on" IconUnits="pixels">fprintf(&quot;MQTT subscribe&quot;);
port_label(&apos;input&apos;, 1, &apos;Topic&apos;);
%port_label(&apos;input&apos;, 2, &apos;Payload&apos;);
text(2, 6, GOcontroll_Simulink_version());</Display>
      <Description>&lt;p&gt;&lt;b&gt;MQTT Subscribe&lt;/b&gt;&lt;/p&gt;

&lt;p&gt;
Subscribes to an MQTT topic and outputs the received payload each model step.
Requires an MQTT Broker block in the model.
&lt;/p&gt;

&lt;p&gt;&lt;b&gt;Input ports&lt;/b&gt;&lt;/p&gt;

&lt;p&gt;
&lt;b&gt;Topic&lt;/b&gt; — uint8 array (null-terminated string, max 64 characters).
Read once at model initialisation to set the subscription topic.
&lt;/p&gt;

&lt;p&gt;&lt;b&gt;Output ports&lt;/b&gt;&lt;/p&gt;

&lt;p&gt;
&lt;b&gt;New data&lt;/b&gt; — uint8 scalar, 1 if a new message has arrived since the last step, 0 otherwise.&lt;br/&gt;
&lt;b&gt;Length&lt;/b&gt; — uint16 scalar, number of valid bytes in the last received message.&lt;br/&gt;
&lt;b&gt;Payload&lt;/b&gt; — uint8 vector, length set by the Payload size parameter.
&lt;/p&gt;

&lt;p&gt;&lt;b&gt;Parameters&lt;/b&gt;&lt;/p&gt;

&lt;p&gt;
&lt;b&gt;Sample time&lt;/b&gt; — model sample time in seconds.&lt;br/&gt;
&lt;b&gt;Payload size&lt;/b&gt; — maximum payload length in bytes; sets the width of the Payload output port.&lt;br/&gt;
&lt;b&gt;Quality of service&lt;/b&gt; — MQTT QoS level: 0 (at most once), 1 (at least once), or 2 (exactly once).
&lt;/p&gt;&lt;p&gt;&lt;b&gt;For the Moduline S1 only.&lt;/b&gt;&lt;/p&gt;</Description>
      <Initialization>go_block_platform_check(gcb, &apos;STM&apos;);
mdl = bdroot;
cs  = getActiveConfigSet(mdl);
try
t = go_target_name(get_param(cs,&apos;tlcGOcontrollTarget&apos;));
catch
t = &quot;Unknown controller&quot;;
end
msk = Simulink.Mask.get(gcb);
c = msk.getParameter(&apos;ContrType&apos;);
c.Value = t;

if contains(t, &apos;Moduline S1&apos;)

else

end

    % update RTWdata to call WriteRTW again
    modelRTWFields = struct(&apos;payload_size&apos;, num2str(payload_size), &apos;qos&apos;, num2str(qos));

    % Insert modelRTWFields in the I/O block S-Function containing the Tag starting with &apos;HANcoder_TARGET_&apos;
    HANcoder_TARGET_DataBlock = find_system(gcb, &apos;RegExp&apos;, &apos;on&apos;, &apos;FollowLinks&apos;, &apos;on&apos;, &apos;LookUnderMasks&apos;, &apos;all&apos;, &apos;BlockType&apos;, &apos;M-S-Function&apos;);
    set_param(HANcoder_TARGET_DataBlock{1}, &apos;RTWdata&apos;, modelRTWFields);</Initialization>
      <Help>&lt;html&gt;&lt;body style=&quot;font-family:sans-serif&quot;&gt;&lt;h2&gt;MQTT Subscribe&lt;/h2&gt;&lt;p&gt;Receives the messages of one MQTT topic. The model needs an &lt;i&gt;MQTT Broker&lt;/i&gt; block.&lt;/p&gt;&lt;h3&gt;How to use it&lt;/h3&gt;&lt;ul&gt;&lt;li&gt;Input &lt;b&gt;Topic&lt;/b&gt;: the topic as text; it is read once when the application starts.&lt;/li&gt;&lt;li&gt;Outputs: &lt;b&gt;New data&lt;/b&gt; (1 for one sample when a message arrived), &lt;b&gt;Length&lt;/b&gt; and &lt;b&gt;Payload&lt;/b&gt; (uint8).&lt;/li&gt;&lt;li&gt;&lt;b&gt;Payload size (bytes)&lt;/b&gt;: the largest message you expect (default 150).&lt;/li&gt;&lt;li&gt;Connect the three outputs to a &lt;i&gt;JSON Parser&lt;/i&gt; block to read values from a JSON message.&lt;/li&gt;&lt;/ul&gt;&lt;h3&gt;Controllers&lt;/h3&gt;&lt;p&gt;Moduline S1 only. In a model for a Linux controller (Moduline M1, L4, HMI1) the block gives an error. The greyed-out field &lt;i&gt;Controller type&lt;/i&gt;, when the block has one, shows the controller chosen under &lt;i&gt;Configuration Parameters &amp;gt; Code Generation &amp;gt; GOcontroll options &amp;gt; Target&lt;/i&gt;; the choices in the block follow it.&lt;/p&gt;&lt;h3&gt;GOcontroll knowledge base&lt;/h3&gt;&lt;ul&gt;&lt;li&gt;&lt;a href=&quot;https://gocontroll.com/knowledge-base/modular-hardware/controllers/s1/&quot;&gt;Moduline S1&lt;/a&gt;&lt;br&gt;https://gocontroll.com/knowledge-base/modular-hardware/controllers/s1/&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;https://gocontroll.com/knowledge-base/getting-started/programming/simulink/blockset-information/&quot;&gt;Using the blockset&lt;/a&gt;&lt;br&gt;https://gocontroll.com/knowledge-base/getting-started/programming/simulink/blockset-information/&lt;/li&gt;&lt;/ul&gt;&lt;/body&gt;&lt;/html&gt;</Help>
      <MaskParameter Name="ContrType" Type="edit" Evaluate="off" Enabled="off">
        <Prompt>Controller type</Prompt>
        <Value>Unknown controller</Value>
      </MaskParameter>
      <MaskParameter Name="tsamp" Type="edit">
        <Prompt>Sample time</Prompt>
        <Value>1</Value>
      </MaskParameter>
      <MaskParameter Name="payload_size" Type="edit">
        <Prompt>Payload size (bytes)</Prompt>
        <Value>150</Value>
      </MaskParameter>
      <MaskParameter Name="qos" Type="popup">
        <Prompt>Quality of service</Prompt>
        <Value>0</Value>
        <TypeOptions>
          <Option>0</Option>
          <Option>1</Option>
          <Option>2</Option>
        </TypeOptions>
      </MaskParameter>
      <DialogControl Type="Group" Name="DescGroupVar">
        <Prompt>%&lt;MaskType&gt;</Prompt>
        <DialogControl Type="Text" Name="DescTextVar">
          <Prompt>%&lt;MaskDescription&gt;</Prompt>
        </DialogControl>
      </DialogControl>
      <DialogControl Type="Group" Name="ParameterGroupVar">
        <Prompt>Parameters</Prompt>
        <DialogControl Type="Edit" Name="ContrType">
          <Prompt>Controller type</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="Edit" Name="tsamp">
          <Prompt>Sample time</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="Edit" Name="payload_size">
          <Prompt>Payload size (bytes)</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="Popup" Name="qos">
          <Prompt>Quality of service</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
      </DialogControl>
    </Mask>
  </Block>
</System>

__MWOPC_PART_BEGIN__ /simulink/systems/system_3919.xml
<?xml version="1.0" encoding="utf-8"?>
<System>
  <P Name="Location">[2596, 984, 3730, 1960]</P>
  <P Name="PaperType">usletter</P>
  <P Name="ZoomFactor">109</P>
  <Block BlockType="SubSystem" Name="Input Module" SID="3989">
    <PortCounts/>
    <P Name="Position">[290, -236, 400, -194]</P>
    <P Name="ZOrder">95</P>
    <P Name="BackgroundColor">[1.000000, 0.666667, 0.000000]</P>
    <P Name="UserDataPersistent">on</P>
    <Mask>
      <Display RunInitForIconRedraw="on" IconUnits="pixels">fprintf(&apos;Input Module&apos;);
</Display>
    </Mask>
    <System Ref="system_3989"/>
