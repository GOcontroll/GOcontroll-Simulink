__MWOPC_PART_BEGIN__ /simulink/systems/system_3975.xml
<?xml version="1.0" encoding="utf-8"?>
<System>
  <P Name="Location">[2563, 1084, 3697, 2071]</P>
  <P Name="PaperType">usletter</P>
  <P Name="ZoomFactor">228</P>
  <Block BlockType="M-S-Function" Name="Enclosure LED" SID="4102">
    <PortCounts in="1"/>
    <P Name="Position">[-20, -166, 130, -124]</P>
    <P Name="ZOrder">96</P>
    <P Name="BackgroundColor">[1.000000, 0.666667, 0.000000]</P>
    <List ListType="RTWdata">
      <P Name="led">1</P>
      <P Name="color">1</P>
    </List>
    <P Name="FunctionName">sfcn_gocontroll_status_led</P>
    <P Name="Parameters">tsamp</P>
    <Mask SelfModifiable="on">
      <Type>Enclosure LED&apos;s</Type>
      <Display RunInitForIconRedraw="on" IconUnits="pixels">if ContrType == &quot;Unknown controller&quot;
fprintf(&apos;Status LED control&apos;);
else
fprintf(&apos;Status LED %d\nColor: %s&apos;,led,colorInfoStr);
end
text(2, 6, GOcontroll_Simulink_version());</Display>
      <Description>&lt;p&gt;&lt;b&gt;Status LED Configuration&lt;/b&gt;&lt;/p&gt;
&lt;p&gt;
&lt;table border=&quot;1&quot; cellpadding=&quot;4&quot; cellspacing=&quot;0&quot;&gt;
  &lt;tr&gt;
    &lt;td&gt;Moduline L4&lt;/td&gt;
    &lt;td&gt;4 RGB LEDs&lt;/td&gt;
  &lt;/tr&gt;
  &lt;tr&gt;
    &lt;td&gt;Moduline M1&lt;/td&gt;
    &lt;td&gt;4 RGB LEDs&lt;/td&gt;
  &lt;/tr&gt;
  &lt;tr&gt;
    &lt;td&gt;Moduline HMI1&lt;/td&gt;
    &lt;td&gt;No LEDs&lt;/td&gt;
  &lt;/tr&gt;
  &lt;tr&gt;
    &lt;td&gt;Moduline S1&lt;/td&gt;
    &lt;td&gt;1 RGB LED&lt;/td&gt;
  &lt;/tr&gt;
&lt;/table&gt;
&lt;/p&gt;

&lt;p&gt;&lt;b&gt;Control Method&lt;/b&gt;&lt;/p&gt;

&lt;p&gt;
To control the LEDs, configure the mask parameters for LED selection and color. 
The brightness can be controlled with a value from 0 (0%) to 255 (100%) (uint8).
&lt;/p&gt;

&lt;p&gt;&lt;b&gt;Mask Parameters&lt;/b&gt;&lt;/p&gt;

&lt;p&gt;
LED: Select the LED that needs to be controlled.
&lt;/p&gt;

&lt;p&gt;
Color: Select the color the LED should illuminate.
&lt;/p&gt;</Description>
      <Initialization>    % Get model context and target (t)
    mdl = bdroot;
    cs  = getActiveConfigSet(mdl);
    try
    t = go_target_name(get_param(cs,&apos;tlcGOcontrollTarget&apos;));
    catch
    t = &quot;Unknown controller&quot;;
    end
    % Get mask context
    msk = Simulink.Mask.get(gcb);
    l = msk.getParameter(&apos;led&apos;);
    c = msk.getParameter(&apos;ContrType&apos;);
    % Set controller type
    c.Value = t;
    
    if contains(t,&apos;Moduline S1&apos;)
        l.TypeOptions = {&apos;1&apos;};
    else
        l.TypeOptions = {&apos;1&apos;,&apos;2&apos;,&apos;3&apos;,&apos;4&apos;};
    end

    colorInfoString = {&apos;Red&apos;, &apos;Green&apos;, &apos;Blue&apos;};
    colorInfoStr = colorInfoString{color};

    % update RTWdata to run WriteRTW again
    modelRTWFields = struct(&apos;led&apos;, int2str(led),&apos;color&apos;, int2str(color));
    % Insert modelRTWFields in the I/O block S-Function containing the Tag starting with &apos;HANcoder_TARGET_&apos;
    HANcoder_TARGET_DataBlock = find_system(gcb, &apos;RegExp&apos;, &apos;on&apos;, &apos;FollowLinks&apos;, &apos;on&apos;, &apos;LookUnderMasks&apos;, &apos;all&apos;, &apos;BlockType&apos;, &apos;M-S-Function&apos;);
    set_param(HANcoder_TARGET_DataBlock{1}, &apos;RTWdata&apos;, modelRTWFields);</Initialization>
      <Help>&lt;html&gt;&lt;body style=&quot;font-family:sans-serif&quot;&gt;&lt;h2&gt;Enclosure LED&apos;s&lt;/h2&gt;&lt;p&gt;Drives one colour of one LED in the enclosure of the controller.&lt;/p&gt;&lt;h3&gt;How to use it&lt;/h3&gt;&lt;ul&gt;&lt;li&gt;Input: the brightness, 0 (off) to 255 (full), as uint8.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Led&lt;/b&gt;: which LED. The Moduline S1 has one LED, the M1 and L4 have four, the HMI1 has none.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Color&lt;/b&gt;: Red, Green or Blue.&lt;/li&gt;&lt;li&gt;Use one block per LED and colour. Three blocks on the same LED, one per colour, mix a colour.&lt;/li&gt;&lt;li&gt;The LED goes off when the application stops.&lt;/li&gt;&lt;/ul&gt;&lt;h3&gt;Controllers&lt;/h3&gt;&lt;p&gt;All controllers: Moduline S1, M1, L4 and HMI1. The greyed-out field &lt;i&gt;Controller type&lt;/i&gt;, when the block has one, shows the controller chosen under &lt;i&gt;Configuration Parameters &amp;gt; Code Generation &amp;gt; GOcontroll options &amp;gt; Target&lt;/i&gt;; the choices in the block follow it.&lt;/p&gt;&lt;h3&gt;GOcontroll knowledge base&lt;/h3&gt;&lt;ul&gt;&lt;li&gt;&lt;a href=&quot;https://gocontroll.com/knowledge-base/modular-hardware/controllers/s1/&quot;&gt;Moduline S1&lt;/a&gt;&lt;br&gt;https://gocontroll.com/knowledge-base/modular-hardware/controllers/s1/&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;https://gocontroll.com/knowledge-base/modular-hardware/controllers/m1/&quot;&gt;Moduline M1&lt;/a&gt;&lt;br&gt;https://gocontroll.com/knowledge-base/modular-hardware/controllers/m1/&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;https://gocontroll.com/knowledge-base/modular-hardware/controllers/l4/&quot;&gt;Moduline L4&lt;/a&gt;&lt;br&gt;https://gocontroll.com/knowledge-base/modular-hardware/controllers/l4/&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;https://gocontroll.com/knowledge-base/modular-hardware/controllers/hmi1/&quot;&gt;Moduline HMI1&lt;/a&gt;&lt;br&gt;https://gocontroll.com/knowledge-base/modular-hardware/controllers/hmi1/&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;https://gocontroll.com/knowledge-base/getting-started/programming/simulink/external-control/&quot;&gt;Controlling a model with HANtune over XCP&lt;/a&gt;&lt;br&gt;https://gocontroll.com/knowledge-base/getting-started/programming/simulink/external-control/&lt;/li&gt;&lt;/ul&gt;&lt;/body&gt;&lt;/html&gt;</Help>
      <MaskParameter Name="ContrType" Type="edit" Evaluate="off" Enabled="off">
        <Prompt>Controller type</Prompt>
        <Value>Unknown controller</Value>
      </MaskParameter>
      <MaskParameter Name="tsamp" Type="edit">
        <Prompt>Sample time</Prompt>
        <Value>0.1</Value>
      </MaskParameter>
      <MaskParameter Name="led" Type="popup" Tunable="off">
        <Prompt>Led</Prompt>
        <Value>1</Value>
        <TypeOptions>
          <Option>1</Option>
          <Option>2</Option>
          <Option>3</Option>
          <Option>4</Option>
        </TypeOptions>
      </MaskParameter>
      <MaskParameter Name="color" Type="popup" Tunable="off">
        <Prompt>Color</Prompt>
        <Value>Red</Value>
        <TypeOptions>
          <Option>Red</Option>
          <Option>Green</Option>
          <Option>Blue</Option>
        </TypeOptions>
      </MaskParameter>
      <DialogControl Type="Group" Name="DescGroupVar">
        <Prompt>%&lt;MaskType&gt;</Prompt>
        <DialogControl Type="Text" Name="DescTextVar">
          <Prompt>%&lt;MaskDescription&gt;</Prompt>
        </DialogControl>
      </DialogControl>
      <DialogControl Type="Group" Name="ParameterGroupVar">
        <Prompt>Parameters</Prompt>
        <DialogControl Type="Edit" Name="ContrType">
          <Prompt>Controller type</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="Edit" Name="tsamp">
          <Prompt>Sample time</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="Popup" Name="led">
          <Prompt>Led</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="Popup" Name="color">
          <Prompt>Color</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
      </DialogControl>
    </Mask>
  </Block>
</System>

__MWOPC_PART_BEGIN__ /simulink/systems/system_3980.xml
<?xml version="1.0" encoding="utf-8"?>
<System>
  <P Name="Location">[2661, 1122, 3795, 2098]</P>
  <P Name="PaperType">usletter</P>
  <P Name="ZoomFactor">97</P>
  <Block BlockType="M-S-Function" Name="Controller Active" SID="4097">
    <PortCounts in="1"/>
    <P Name="Position">[110, 334, 260, 376]</P>
    <P Name="ZOrder">10</P>
    <P Name="BackgroundColor">[1.000000, 0.666667, 0.000000]</P>
    <P Name="FunctionName">sfcn_gocontroll_controller_active</P>
    <P Name="Parameters">tsamp</P>
    <Mask SelfModifiable="on">
      <Type>Controller Active</Type>
      <Display RunInitForIconRedraw="on" IconUnits="pixels">fprintf(&apos;Controller Active&apos;);
text(2, 6, GOcontroll_Simulink_version());</Display>
      <Description>&lt;p&gt;&lt;b&gt;Power Latching &amp; Shutdown Behavior&lt;/b&gt;&lt;/p&gt;

&lt;p&gt;
GOcontroll Moduline controllers support an internal power-latching mechanism 
that allows the device to remain powered under software control.
&lt;/p&gt;

&lt;p&gt;&lt;b&gt;Conditions to Remain Powered&lt;/b&gt;&lt;/p&gt;

&lt;p&gt;The controller will remain powered as long as:&lt;/p&gt;

&lt;ul&gt;
  &lt;li&gt;K30 supply voltage is present on the designated K30 power pins&lt;/li&gt;
  &lt;li&gt;The input of the Controller Active function block is set high (boolean)&lt;/li&gt;
&lt;/ul&gt;

&lt;p&gt;
Under these conditions, the controller will stay powered even if the 
K15 ignition inputs are no longer active.
&lt;/p&gt;

&lt;p&gt;&lt;b&gt;Software Shutdown Behavior&lt;/b&gt;&lt;/p&gt;

&lt;p&gt;
If the controller is switched off by software (Controller Active = low), 
the device will fully power down.
&lt;/p&gt;

&lt;p&gt;
A restart is only possible after reactivation via one of the designated 
K15 ignition inputs.
&lt;/p&gt;

&lt;p&gt;&lt;b&gt;Detecting External Shutdown (Ignition Off)&lt;/b&gt;&lt;/p&gt;

&lt;p&gt;
To detect when an external shutdown occurs (K15 voltage drops), use the 
K15 Voltage function block in your Simulink model.
&lt;/p&gt;</Description>
      <Initialization>mdl = bdroot;
cs  = getActiveConfigSet(mdl);
try
t = go_target_name(get_param(cs,&apos;tlcGOcontrollTarget&apos;));
catch
t = &quot;Unknown controller&quot;;
end
msk = Simulink.Mask.get(gcb);
c = msk.getParameter(&apos;ContrType&apos;);
c.Value = t;

if contains(t,&apos;Moduline S1&apos;)
    
else
   
end
    % Get mask context</Initialization>
      <Help>&lt;html&gt;&lt;body style=&quot;font-family:sans-serif&quot;&gt;&lt;h2&gt;Controller Active&lt;/h2&gt;&lt;p&gt;Keeps the controller switched on. Use it to shut down in a controlled way after the ignition (K15) is switched off.&lt;/p&gt;&lt;h3&gt;How to use it&lt;/h3&gt;&lt;ul&gt;&lt;li&gt;Input: boolean. While it is true and the battery supply (K30) is present, the controller stays on, also after K15 drops.&lt;/li&gt;&lt;li&gt;When the input becomes false the controller switches off. It starts again only when a K15 input becomes high.&lt;/li&gt;&lt;li&gt;Typical use: read K15 with &lt;i&gt;K15 Voltage&lt;/i&gt;; when it drops, store what has to be kept (Memory write), then make the input false. The model templates contain this example.&lt;/li&gt;&lt;li&gt;If the input is never true, the controller switches off as soon as K15 drops.&lt;/li&gt;&lt;/ul&gt;&lt;h3&gt;Controllers&lt;/h3&gt;&lt;p&gt;All controllers: Moduline S1, M1, L4 and HMI1. The greyed-out field &lt;i&gt;Controller type&lt;/i&gt;, when the block has one, shows the controller chosen under &lt;i&gt;Configuration Parameters &amp;gt; Code Generation &amp;gt; GOcontroll options &amp;gt; Target&lt;/i&gt;; the choices in the block follow it.&lt;/p&gt;&lt;h3&gt;GOcontroll knowledge base&lt;/h3&gt;&lt;ul&gt;&lt;li&gt;&lt;a href=&quot;https://gocontroll.com/knowledge-base/start/connections/supply/&quot;&gt;Supply voltage&lt;/a&gt;&lt;br&gt;https://gocontroll.com/knowledge-base/start/connections/supply/&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;https://gocontroll.com/knowledge-base/getting-started/wiring/main-controller/&quot;&gt;Wiring of the main controller&lt;/a&gt;&lt;br&gt;https://gocontroll.com/knowledge-base/getting-started/wiring/main-controller/&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;https://gocontroll.com/knowledge-base/getting-started/programming/simulink/blockset-information/&quot;&gt;Using the blockset&lt;/a&gt;&lt;br&gt;https://gocontroll.com/knowledge-base/getting-started/programming/simulink/blockset-information/&lt;/li&gt;&lt;/ul&gt;&lt;/body&gt;&lt;/html&gt;</Help>
      <MaskParameter Name="ContrType" Type="edit" Evaluate="off" Enabled="off">
        <Prompt>Controller type</Prompt>
        <Value>Unknown controller</Value>
      </MaskParameter>
      <MaskParameter Name="tsamp" Type="edit" Tunable="off">
        <Prompt>Sample time</Prompt>
        <Value>1</Value>
      </MaskParameter>
      <DialogControl Type="Group" Name="DescGroupVar">
        <Prompt>%&lt;MaskType&gt;</Prompt>
        <DialogControl Type="Text" Name="DescTextVar">
          <Prompt>%&lt;MaskDescription&gt;</Prompt>
        </DialogControl>
      </DialogControl>
      <DialogControl Type="Group" Name="ParameterGroupVar">
        <Prompt>Parameters</Prompt>
        <DialogControl Type="Edit" Name="ContrType">
          <Prompt>Controller type</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="Edit" Name="tsamp">
          <Prompt>Sample time</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
      </DialogControl>
    </Mask>
  </Block>
  <Block BlockType="M-S-Function" Name="K15 Voltage" SID="4095">
    <PortCounts out="1"/>
    <P Name="Position">[110, 399, 260, 441]</P>
    <P Name="ZOrder">8</P>
    <P Name="BackgroundColor">[1.000000, 0.666667, 0.000000]</P>
    <List ListType="RTWdata">
      <P Name="k15pin">1</P>
    </List>
    <P Name="FunctionName">sfcn_gocontroll_k15_voltage</P>
    <P Name="Parameters">tsamp,k15pin</P>
    <Mask SelfModifiable="on">
      <Type>Contact Voltage</Type>
      <Display IconUnits="pixels">if ContrType == &quot;Unknown controller&quot;
fprintf(&apos;K15 pin measurement&apos;);
else
fprintf(&apos;ADC voltage\n%s&apos;,get_param(gcb, &apos;k15pin&apos;));
end
text(2, 6, GOcontroll_Simulink_version());</Display>
      <Description>&lt;p&gt;&lt;b&gt;K15 Voltage Measurement&lt;/b&gt;&lt;/p&gt;

&lt;p&gt;
The K15 Voltage block provides the measured K15 input voltage in millivolts (mV) 
that is applied to the controller’s K15 ignition pins.
&lt;/p&gt;

&lt;p&gt;
A positive voltage on any of these pins will initiate controller startup.
&lt;/p&gt;

&lt;p&gt;&lt;b&gt;Startup Source Identification&lt;/b&gt;&lt;/p&gt;

&lt;p&gt;
The available function blocks can be used to determine which specific 
K15 input pin triggered the startup event.
&lt;/p&gt;</Description>
      <Initialization>% Get model context and target (t)
mdl = bdroot;
cs  = getActiveConfigSet(mdl);
try
t = go_target_name(get_param(cs,&apos;tlcGOcontrollTarget&apos;));
catch
t = &quot;Unknown controller&quot;;
end
msk = Simulink.Mask.get(gcb);
c = msk.getParameter(&apos;ContrType&apos;);
k = msk.getParameter(&apos;k15pin&apos;);
c.Value = t;

if contains(t,&apos;Moduline S1&apos;)
    k.TypeOptions = {&apos;K15 Connector pin 8&apos;};
elseif contains(t,&apos;Moduline M1&apos;)
    k.TypeOptions = {&apos;K15-1 Connector B pin 17&apos;,&apos;K15-2 Connector A pin 16&apos;,&apos;K15-3 Connector A pin 17&apos;};
elseif contains(t,&apos;Moduline L4&apos;)
    k.TypeOptions = {&apos;K15-1 Connector C pin 2&apos;,&apos;K15-2 Connector C pin 3&apos;,&apos;K15-3 Connector C pin 4&apos;};
elseif contains(t,&apos;Moduline HMI1&apos;)
    k.TypeOptions = {&apos;K15 Connector pin 9&apos;,&apos;Sensor (6 pin Minitek pin 3)&apos;,&apos;Adapter board sensor&apos;};
end
    %update RTWdata to run WriteRTW again
    % The number of the input in the list of this controller. The variable k15pin was
    % worked out before the list above was set, so it can still count in the list of the library.
    k15pin = find(strcmp(k.TypeOptions, get_param(gcb, &apos;k15pin&apos;)), 1);
    if isempty(k15pin), k15pin = 1; end
    modelRTWFields = struct(&apos;k15pin&apos;, int2str(k15pin));
    % Insert modelRTWFields in the I/O block S-Function containing the Tag starting with &apos;HANcoder_TARGET_&apos;
    HANcoder_TARGET_DataBlock = find_system(gcb, &apos;RegExp&apos;, &apos;on&apos;, &apos;FollowLinks&apos;, &apos;on&apos;, &apos;LookUnderMasks&apos;, &apos;all&apos;, &apos;BlockType&apos;, &apos;M-S-Function&apos;);
    set_param(HANcoder_TARGET_DataBlock{1}, &apos;RTWdata&apos;, modelRTWFields);</Initialization>
      <Help>&lt;html&gt;&lt;body style=&quot;font-family:sans-serif&quot;&gt;&lt;h2&gt;Contact Voltage&lt;/h2&gt;&lt;p&gt;Measures the voltage on a K15 (ignition) input of the controller, in mV.&lt;/p&gt;&lt;h3&gt;How to use it&lt;/h3&gt;&lt;ul&gt;&lt;li&gt;&lt;b&gt;K15 input pin&lt;/b&gt;: which input. The list follows the controller: the Moduline S1 has one K15 input, the M1 and the L4 have three.&lt;/li&gt;&lt;li&gt;Use it to detect that the ignition is switched off, for example K15 below 6000 mV, together with &lt;i&gt;Controller Active&lt;/i&gt;.&lt;/li&gt;&lt;/ul&gt;&lt;h3&gt;Controllers&lt;/h3&gt;&lt;p&gt;All controllers: Moduline S1, M1, L4 and HMI1. The greyed-out field &lt;i&gt;Controller type&lt;/i&gt;, when the block has one, shows the controller chosen under &lt;i&gt;Configuration Parameters &amp;gt; Code Generation &amp;gt; GOcontroll options &amp;gt; Target&lt;/i&gt;; the choices in the block follow it.&lt;/p&gt;&lt;h3&gt;GOcontroll knowledge base&lt;/h3&gt;&lt;ul&gt;&lt;li&gt;&lt;a href=&quot;https://gocontroll.com/knowledge-base/start/connections/supply/&quot;&gt;Supply voltage&lt;/a&gt;&lt;br&gt;https://gocontroll.com/knowledge-base/start/connections/supply/&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;https://gocontroll.com/knowledge-base/getting-started/wiring/main-controller/&quot;&gt;Wiring of the main controller&lt;/a&gt;&lt;br&gt;https://gocontroll.com/knowledge-base/getting-started/wiring/main-controller/&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;https://gocontroll.com/knowledge-base/getting-started/programming/simulink/blockset-information/&quot;&gt;Using the blockset&lt;/a&gt;&lt;br&gt;https://gocontroll.com/knowledge-base/getting-started/programming/simulink/blockset-information/&lt;/li&gt;&lt;/ul&gt;&lt;/body&gt;&lt;/html&gt;</Help>
      <MaskParameter Name="ContrType" Type="edit" Evaluate="off" Enabled="off">
        <Prompt>Controller type</Prompt>
        <Value>Unknown controller</Value>
      </MaskParameter>
      <MaskParameter Name="tsamp" Type="edit" Tunable="off">
        <Prompt>Sample time</Prompt>
        <Value>1</Value>
      </MaskParameter>
      <MaskParameter Name="k15pin" Type="popup" Tunable="off">
        <Prompt>K15 input pin</Prompt>
        <Value>K15-1 Connector C pin 2</Value>
        <TypeOptions>
          <Option>K15-1 Connector C pin 2</Option>
          <Option>K15-2 Connector C pin 3</Option>
          <Option>K15-3 Connector C pin 4</Option>
          <Option>K15-1 Connector B pin 17</Option>
          <Option>K15-2 Connector A pin 16</Option>
          <Option>K15-3 Connector A pin 17</Option>
          <Option>K15 Connector pin 8</Option>
          <Option>K15 Connector pin 9</Option>
          <Option>Sensor (6 pin Minitek pin 3)</Option>
          <Option>Adapter board sensor</Option>
        </TypeOptions>
      </MaskParameter>
      <DialogControl Type="Group" Name="DescGroupVar">
        <Prompt>%&lt;MaskType&gt;</Prompt>
        <DialogControl Type="Text" Name="DescTextVar">
          <Prompt>%&lt;MaskDescription&gt;</Prompt>
        </DialogControl>
      </DialogControl>
      <DialogControl Type="Group" Name="ParameterGroupVar">
        <Prompt>Parameters</Prompt>
        <DialogControl Type="Edit" Name="ContrType">
          <Prompt>Controller type</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="Edit" Name="tsamp">
          <Prompt>Sample time</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="Popup" Name="k15pin">
          <Prompt>K15 input pin</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
      </DialogControl>
    </Mask>
  </Block>
  <Block BlockType="M-S-Function" Name="K30 Voltage" SID="4096">
    <PortCounts out="1"/>
    <P Name="Position">[110, 464, 260, 506]</P>
    <P Name="ZOrder">9</P>
    <P Name="BackgroundColor">[1.000000, 0.666667, 0.000000]</P>
    <P Name="FunctionName">sfcn_gocontroll_k30_voltage</P>
    <P Name="Parameters">tsamp</P>
    <Mask>
      <Type>Supply voltage</Type>
      <Display RunInitForIconRedraw="on" IconUnits="pixels">if ContrType == &quot;Moduline S1&quot;
    fprintf(&apos;K30 Voltage\nConnector pin 9&apos;);
elseif ContrType == &quot;Moduline L4&quot;
    fprintf(&apos;K30 Voltage\nConnector C pin 5-6-7&apos;);
elseif ContrType == &quot;Moduline M1&quot;
    fprintf(&apos;K30 Voltage\nConnector B pin 8-9&apos;);
elseif ContrType == &quot;Moduline HMI1&quot;
    fprintf(&apos;K30 Voltage\nConnector A pin 9&apos;);
elseif ContrType == &quot;Unknown controller&quot;
    fprintf(&apos;K30 pin measurement&apos;);
end
text(2, 6, GOcontroll_Simulink_version());</Display>
      <Description>&lt;p&gt;&lt;b&gt;K30 Voltage Measurement&lt;/b&gt;&lt;/p&gt;

&lt;p&gt;
The K30 Voltage block provides the measured supply voltage in millivolts (mV) 
that is applied to the controller’s K30 power pins.
&lt;/p&gt;</Description>
      <Initialization>% Get model context and target (t)
mdl = bdroot;
cs  = getActiveConfigSet(mdl);
try
t = go_target_name(get_param(cs,&apos;tlcGOcontrollTarget&apos;));
catch
t = &quot;Unknown controller&quot;;
end
msk = Simulink.Mask.get(gcb);
c = msk.getParameter(&apos;ContrType&apos;);
c.Value = t;
</Initialization>
      <Help>&lt;html&gt;&lt;body style=&quot;font-family:sans-serif&quot;&gt;&lt;h2&gt;Supply voltage&lt;/h2&gt;&lt;p&gt;Measures the battery supply voltage (K30) of the controller, in mV.&lt;/p&gt;&lt;h3&gt;How to use it&lt;/h3&gt;&lt;ul&gt;&lt;li&gt;Use it to monitor the battery, for example to warn at a low voltage or to switch off loads.&lt;/li&gt;&lt;/ul&gt;&lt;h3&gt;Controllers&lt;/h3&gt;&lt;p&gt;All controllers: Moduline S1, M1, L4 and HMI1. The greyed-out field &lt;i&gt;Controller type&lt;/i&gt;, when the block has one, shows the controller chosen under &lt;i&gt;Configuration Parameters &amp;gt; Code Generation &amp;gt; GOcontroll options &amp;gt; Target&lt;/i&gt;; the choices in the block follow it.&lt;/p&gt;&lt;h3&gt;GOcontroll knowledge base&lt;/h3&gt;&lt;ul&gt;&lt;li&gt;&lt;a href=&quot;https://gocontroll.com/knowledge-base/start/connections/supply/&quot;&gt;Supply voltage&lt;/a&gt;&lt;br&gt;https://gocontroll.com/knowledge-base/start/connections/supply/&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;https://gocontroll.com/knowledge-base/getting-started/programming/simulink/external-monitoring/&quot;&gt;Monitoring a signal with HANtune over XCP&lt;/a&gt;&lt;br&gt;https://gocontroll.com/knowledge-base/getting-started/programming/simulink/external-monitoring/&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;https://gocontroll.com/knowledge-base/getting-started/programming/simulink/blockset-information/&quot;&gt;Using the blockset&lt;/a&gt;&lt;br&gt;https://gocontroll.com/knowledge-base/getting-started/programming/simulink/blockset-information/&lt;/li&gt;&lt;/ul&gt;&lt;/body&gt;&lt;/html&gt;</Help>
      <MaskParameter Name="ContrType" Type="edit" Evaluate="off" Enabled="off">
        <Prompt>Controller type</Prompt>
        <Value>Unknown controller</Value>
      </MaskParameter>
      <MaskParameter Name="tsamp" Type="edit" Tunable="off">
        <Prompt>Sample time</Prompt>
        <Value>1</Value>
      </MaskParameter>
      <DialogControl Type="Group" Name="DescGroupVar">
        <Prompt>%&lt;MaskType&gt;</Prompt>
        <DialogControl Type="Text" Name="DescTextVar">
          <Prompt>%&lt;MaskDescription&gt;</Prompt>
        </DialogControl>
      </DialogControl>
      <DialogControl Type="Group" Name="ParameterGroupVar">
        <Prompt>Parameters</Prompt>
        <DialogControl Type="Edit" Name="ContrType">
          <Prompt>Controller type</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="Edit" Name="tsamp">
          <Prompt>Sample time</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
      </DialogControl>
    </Mask>
  </Block>
</System>

__MWOPC_PART_BEGIN__ /simulink/systems/system_3989.xml
<?xml version="1.0" encoding="utf-8"?>
<System>
  <P Name="Location">[2596, 984, 3730, 1960]</P>
  <P Name="PaperType">usletter</P>
  <P Name="ZoomFactor">150</P>
  <Block BlockType="M-S-Function" Name="Input Module (10 channel)" SID="4109">
    <PortCounts out="10"/>
    <P Name="Position">[205, 216, 390, 379]</P>
    <P Name="ZOrder">8</P>
    <P Name="BackgroundColor">[1.000000, 0.666667, 0.000000]</P>
    <List ListType="RTWdata">
      <P Name="moduleSlot">1</P>
      <P Name="C1func">1</P>
      <P Name="C1pu">1</P>
      <P Name="C1pd">1</P>
      <P Name="C2func">1</P>
      <P Name="C2pu">1</P>
      <P Name="C2pd">1</P>
      <P Name="C3func">1</P>
      <P Name="C3pu">1</P>
      <P Name="C3pd">1</P>
      <P Name="C4func">1</P>
      <P Name="C4pu">1</P>
      <P Name="C4pd">1</P>
      <P Name="C5func">1</P>
      <P Name="C5pu">1</P>
      <P Name="C5pd">1</P>
      <P Name="C6func">1</P>
      <P Name="C6pu">1</P>
      <P Name="C6pd">1</P>
      <P Name="C7func">1</P>
      <P Name="C7pu">1</P>
      <P Name="C7pd">1</P>
      <P Name="C8func">1</P>
      <P Name="C8pu">1</P>
      <P Name="C8pd">1</P>
      <P Name="C9func">1</P>
      <P Name="C9pu">1</P>
      <P Name="C9pd">1</P>
      <P Name="C10func">1</P>
      <P Name="C10pu">1</P>
      <P Name="C10pd">1</P>
      <P Name="SensSup1">1</P>
      <P Name="SensSup2">1</P>
    </List>
    <P Name="FunctionName">sfcn_gocontroll_input_module_10</P>
    <P Name="Parameters">tsamp</P>
    <Mask SelfModifiable="on">
      <Type>Input Module</Type>
      <Display RunInitForIconRedraw="on" IconUnits="pixels">fprintf(&apos;10 Channel Input Module \n%s\n\n Controller Connector: %s&apos;, moduleSlotInfoStr,connectorId);
port_label(&apos;output&apos;, 1, pin1Id);
port_label(&apos;output&apos;, 2, pin2Id);
port_label(&apos;output&apos;, 3, pin3Id);
port_label(&apos;output&apos;, 4, pin4Id);
port_label(&apos;output&apos;, 5, pin5Id);
port_label(&apos;output&apos;, 6, pin6Id);
port_label(&apos;output&apos;, 7, pin7Id);
port_label(&apos;output&apos;, 8, pin8Id);
port_label(&apos;output&apos;, 9, pin9Id);
port_label(&apos;output&apos;, 10, pin10Id);
text(2, 6, GOcontroll_Simulink_version());</Display>
      <Description>With this block, you can configure each channel of the 10 channel input module (201002xx). The configuration of the module is set once at initialization. During runtime, the block outputs the measured values from each channel. 

Module location:
Sets the location of the module slot where the module is physically 
plugged into.

Channel tabs:
Each channel has its own configuration tab.

Function select:
Select the desired input signal configuration.

Pull Up:
If required, a pull-up resistance can be added to the input signal.

Pull Down:
If required, a pull-down resistance can be added to the input signal.</Description>
      <Initialization>% Mirror the model target into Controller type and limit the slots to that controller
t = go_module_slot_setup(gcb);
% array with module slot infos
moduleSlotInfoStrings = {  	&apos;Module slot 1&apos;,  ...\
							&apos;Module slot 2&apos;,  ...\
							&apos;Module slot 3&apos;,  ...\
							&apos;Module slot 4&apos;,  ...\
							&apos;Module slot 5&apos;,  ...\
							&apos;Module slot 6&apos;,  ...\
							&apos;Module slot 7&apos;,  ...\
							&apos;Module slot 8&apos;};

% construct the module slot info string
moduleSlotInfoStr = moduleSlotInfoStrings{moduleSlot};

if(moduleSlot == 1 || moduleSlot == 2)
connectorId = &apos;A&apos;;
elseif(moduleSlot == 3 || moduleSlot == 4)
connectorId = &apos;B&apos;;
elseif(moduleSlot == 5 || moduleSlot == 6)
connectorId = &apos;D&apos;;
else
connectorId = &apos;E&apos;;
end

if contains(t, &apos;Moduline L4&apos;)
	if(moduleSlot == 1 || moduleSlot == 3 || moduleSlot == 5 || moduleSlot == 7)
		pin1Id = &apos;Pin 13&apos;;
		pin2Id = &apos;Pin 19&apos;;
		pin3Id = &apos;Pin 12&apos;;
		pin4Id = &apos;Pin 18&apos;;
		pin5Id = &apos;Pin 11&apos;;
		pin6Id = &apos;Pin 17&apos;;
		pin7Id = &apos;Pin 25&apos;;
		pin8Id = &apos;Pin 24&apos;;
		pin9Id = &apos;Pin 5&apos;;
		pin10Id = &apos;Pin 4&apos;;
	else
		pin1Id = &apos;Pin 8&apos;;
		pin2Id = &apos;Pin 14&apos;;
		pin3Id = &apos;Pin 9&apos;;
		pin4Id = &apos;Pin 15&apos;;
		pin5Id = &apos;Pin 10&apos;;
		pin6Id = &apos;Pin 16&apos;;
		pin7Id = &apos;Pin 21&apos;;
		pin8Id = &apos;Pin 22&apos;;
		pin9Id = &apos;Pin 3&apos;;
		pin10Id = &apos;Pin 23&apos;;
	end
else % Moduline M1, HMI1 and S1 share the module-slot pinout
	if(moduleSlot == 1 || moduleSlot == 3)
		pin1Id = &apos;Pin 15&apos;;
		pin2Id = &apos;Pin 23&apos;;
		pin3Id = &apos;Pin 14&apos;;
		pin4Id = &apos;Pin 22&apos;;
		pin5Id = &apos;Pin 13&apos;;
		pin6Id = &apos;Pin 21&apos;;
		pin7Id = &apos;Pin 31&apos;;
		pin8Id = &apos;Pin 30&apos;;
		pin9Id = &apos;Pin 5&apos;;
		pin10Id = &apos;Pin 4&apos;;
	else
		pin1Id = &apos;Pin 10&apos;;
		pin2Id = &apos;Pin 18&apos;;
		pin3Id = &apos;Pin 11&apos;;
		pin4Id = &apos;Pin 19&apos;;
		pin5Id = &apos;Pin 12&apos;;
		pin6Id = &apos;Pin 20&apos;;
		pin7Id = &apos;Pin 27&apos;;
		pin8Id = &apos;Pin 28&apos;;
		pin9Id = &apos;Pin 3&apos;;
		pin10Id = &apos;Pin 29&apos;;
	end
end

% Create resource keywords to be reserved in resource database
modelRTWFields = struct(&apos;moduleSlot&apos;, int2str(moduleSlot),	&apos;C1func&apos;,int2str(C1func),&apos;C1pu&apos;, int2str(C1pu),&apos;C1pd&apos;, int2str(C1pd),...
															&apos;C2func&apos;, int2str(C2func),&apos;C2pu&apos;, int2str(C2pu),&apos;C2pd&apos;, int2str(C2pd),...
															&apos;C3func&apos;, int2str(C3func),&apos;C3pu&apos;, int2str(C3pu),&apos;C3pd&apos;, int2str(C3pd),...
															&apos;C4func&apos;, int2str(C4func),&apos;C4pu&apos;, int2str(C4pu),&apos;C4pd&apos;, int2str(C4pd),...
															&apos;C5func&apos;, int2str(C5func),&apos;C5pu&apos;, int2str(C5pu),&apos;C5pd&apos;, int2str(C5pd),...
															&apos;C6func&apos;, int2str(C6func),&apos;C6pu&apos;, int2str(C6pu),&apos;C6pd&apos;, int2str(C6pd),...
															&apos;C7func&apos;, int2str(C7func),&apos;C7pu&apos;, int2str(C7pu),&apos;C7pd&apos;, int2str(C7pd),...
															&apos;C8func&apos;, int2str(C8func),&apos;C8pu&apos;, int2str(C8pu),&apos;C8pd&apos;, int2str(C8pd),...
															&apos;C9func&apos;, int2str(C9func),&apos;C9pu&apos;, int2str(C9pu),&apos;C9pd&apos;, int2str(C9pd),...
															&apos;C10func&apos;, int2str(C10func),&apos;C10pu&apos;, int2str(C10pu),&apos;C10pd&apos;, int2str(C10pd),...
															&apos;SensSup1&apos;, int2str(SensSup1), &apos;SensSup2&apos;, int2str(SensSup2));

set_param(gcb, &apos;RTWdata&apos;, modelRTWFields);</Initialization>
      <Help>&lt;html&gt;&lt;body style=&quot;font-family:sans-serif&quot;&gt;&lt;h2&gt;Input Module&lt;/h2&gt;&lt;p&gt;Reads the ten inputs of a 10 Channel Input Module. Each output of the block is one input of the module.&lt;/p&gt;&lt;h3&gt;How to use it&lt;/h3&gt;&lt;ul&gt;&lt;li&gt;&lt;b&gt;Module slot&lt;/b&gt;: the slot the module is fitted in. The list follows the controller: 2 slots on the Moduline S1 and HMI1, 4 on the M1, 8 on the L4. The block icon shows the connector pins of that slot.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Sample time&lt;/b&gt;: how often the block exchanges values with the module. The module is configured once when the application starts.&lt;/li&gt;&lt;li&gt;Per channel choose the &lt;b&gt;function&lt;/b&gt;: analog input (as a 12 bit value or in mV), digital status, frequency (1 Hz to 10 kHz), duty cycle, low or high time, rotation speed (rpm) or pulse counter.&lt;/li&gt;&lt;li&gt;Per channel also the &lt;b&gt;pull-up&lt;/b&gt; (10 k) and &lt;b&gt;pull-down&lt;/b&gt; (3.3 k) resistor.&lt;/li&gt;&lt;li&gt;The two &lt;b&gt;5 V sensor supplies&lt;/b&gt; of the module are switched on in this block.&lt;/li&gt;&lt;li&gt;Use one block per module. Do not drive the same module from Simulink and from Node-RED at the same time.&lt;/li&gt;&lt;/ul&gt;&lt;h3&gt;Controllers&lt;/h3&gt;&lt;p&gt;All controllers: Moduline S1, M1, L4 and HMI1. The greyed-out field &lt;i&gt;Controller type&lt;/i&gt;, when the block has one, shows the controller chosen under &lt;i&gt;Configuration Parameters &amp;gt; Code Generation &amp;gt; GOcontroll options &amp;gt; Target&lt;/i&gt;; the choices in the block follow it.&lt;/p&gt;&lt;h3&gt;GOcontroll knowledge base&lt;/h3&gt;&lt;ul&gt;&lt;li&gt;&lt;a href=&quot;https://gocontroll.com/knowledge-base/modular-hardware/modules/input-10ch/&quot;&gt;10 Channel Input Module&lt;/a&gt;&lt;br&gt;https://gocontroll.com/knowledge-base/modular-hardware/modules/input-10ch/&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;https://gocontroll.com/knowledge-base/configuration/gocontroll-services/go-modules/&quot;&gt;go-modules: module firmware&lt;/a&gt;&lt;br&gt;https://gocontroll.com/knowledge-base/configuration/gocontroll-services/go-modules/&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;https://gocontroll.com/knowledge-base/getting-started/programming/simulink/blockset-information/&quot;&gt;Using the blockset&lt;/a&gt;&lt;br&gt;https://gocontroll.com/knowledge-base/getting-started/programming/simulink/blockset-information/&lt;/li&gt;&lt;/ul&gt;&lt;/body&gt;&lt;/html&gt;</Help>
      <MaskParameter Name="tsamp" Type="edit" Tunable="off">
        <Prompt>Sample time</Prompt>
        <Value>0.1</Value>
      </MaskParameter>
      <MaskParameter Name="ContrType" Type="edit" Evaluate="off" Tunable="off" Enabled="off">
        <Prompt>Controller type</Prompt>
        <Value>Unknown controller</Value>
      </MaskParameter>
      <MaskParameter Name="moduleSlot" Type="popup" Tunable="off">
        <Prompt>Module Slot</Prompt>
        <Value>Moduleslot 1</Value>
        <TypeOptions>
          <Option>Moduleslot 1</Option>
          <Option>Moduleslot 2</Option>
          <Option>Moduleslot 3</Option>
          <Option>Moduleslot 4</Option>
          <Option>Moduleslot 5</Option>
          <Option>Moduleslot 6</Option>
          <Option>Moduleslot 7</Option>
          <Option>Moduleslot 8</Option>
        </TypeOptions>
      </MaskParameter>
