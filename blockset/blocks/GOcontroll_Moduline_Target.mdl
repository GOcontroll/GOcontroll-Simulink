      <Display>fprintf(&apos;CAN FD&apos;);</Display>
    </Mask>
    <System Ref="system_4403"/>
  </Block>
</System>

__MWOPC_PART_BEGIN__ /simulink/systems/system_3212.xml
<?xml version="1.0" encoding="utf-8"?>
<System>
  <P Name="Location">[2085, 478, 3219, 1465]</P>
  <P Name="PaperType">usletter</P>
  <P Name="ZoomFactor">125</P>
  <Block BlockType="S-Function" Name="CAN Receive-msg" SID="4132">
    <PortCounts out="2"/>
    <P Name="Position">[185, 265, 315, 345]</P>
    <P Name="ZOrder">226</P>
    <P Name="BackgroundColor">[1.000000, 0.666667, 0.000000]</P>
    <List ListType="RTWdata">
      <P Name="canBus">1</P>
      <P Name="canKey">1</P>
      <P Name="ifname">can0</P>
    </List>
    <P Name="FunctionName">sfcn_can_receive_v2</P>
    <P Name="Parameters">canBus, tsamp</P>
    <P Name="SFunctionDeploymentMode">off</P>
    <P Name="EnableBusSupport">off</P>
    <P Name="SFcnIsStateOwnerBlock">off</P>
    <Mask SelfModifiable="on">
      <Type>CAN Receive</Type>
      <Display IconUnits="pixels">fprintf(&apos;Receive on\n%s&apos;, canLabel);

port_label(&apos;output&apos;, 1, &apos;function call&apos;);
port_label(&apos;output&apos;, 2, &apos;message&apos;);
text(2, 6, GOcontroll_Simulink_version());</Display>
      <Description>&lt;p&gt;&lt;b&gt;CAN Receive&lt;/b&gt;&lt;/p&gt;

&lt;p&gt;
Receive messages from the CAN bus.
&lt;/p&gt;

&lt;p&gt;
The output of this block is a CAN_MESSAGE object. Use the CAN Unpack block
to extract the signal data from the CAN_MESSAGE object.
&lt;/p&gt;

&lt;p&gt;
A function-call subsystem is triggered each time a new CAN message is received.
&lt;/p&gt;

&lt;p&gt;
Only one CAN Receive block can be used per CAN channel. This block receives
all messages on the selected bus.
&lt;/p&gt;

&lt;p&gt;
To filter specific messages, use CAN Unpack blocks inside the triggered
function-call subsystem.
&lt;/p&gt;
&lt;p&gt;&lt;b&gt;CAN channel:&lt;/b&gt; a CAN bus of the controller itself or, on the Moduline M1, L4 and HMI1, a CAN bus of a Multibus Module: &lt;i&gt;Multibus CAN 1&lt;/i&gt; (connector interface 1, mb_can1), &lt;i&gt;Multibus CAN 2&lt;/i&gt; (interface 3, mb_can2) and &lt;i&gt;Multibus CAN 3&lt;/i&gt; (interface 4, mb_can3). The Moduline S1 has no Multibus CAN channels.&lt;/p&gt;&lt;p&gt;&lt;b&gt;A Multibus CAN bus is set up on the controller, not in the model:&lt;/b&gt;&lt;br&gt;1. Set the connector interface of the module to CAN or CAN FD with the tool &lt;b&gt;go-multibus&lt;/b&gt;.&lt;br&gt;2. Set the bitrate, and for CAN FD the data bitrate, with the tool &lt;b&gt;go-can&lt;/b&gt;, for example &lt;i&gt;go-can set mb_can1 bitrate 500000&lt;/i&gt;.&lt;br&gt;Whether a Multibus Module is fitted is not known when the model is built. If the bus is not there when the application starts, a message is printed and the block does nothing. Click &lt;b&gt;Help&lt;/b&gt; for the steps and the pages of the GOcontroll knowledge base.&lt;/p&gt;&lt;p&gt;This block sends and receives classic CAN frames of up to 8 data bytes, also on a bus that is set to CAN FD.&lt;/p&gt;</Description>
      <Initialization>% Target, CAN channel list and the choice between a controller bus and a Multibus Module bus
[t, can] = go_can_bus_setup(gcb);
canLabel = can.label;

% canBus: bus number of the controller (S1). canKey and ifname: name in the generated code and
% Linux interface, for example can0 or mb_can1.
modelRTWFields = struct(&apos;canBus&apos;, can.canBus, &apos;canKey&apos;, can.key, &apos;ifname&apos;, can.ifname);
set_param(gcb, &apos;RTWdata&apos;, modelRTWFields);
</Initialization>
      <Help>&lt;html&gt;&lt;body style=&quot;font-family:sans-serif&quot;&gt;&lt;h2&gt;CAN Receive&lt;/h2&gt;&lt;h3&gt;CAN channels&lt;/h3&gt;&lt;p&gt;The list &lt;i&gt;CAN channel&lt;/i&gt; follows the controller that is selected under &lt;i&gt;Configuration Parameters &amp;gt; Code Generation &amp;gt; GOcontroll options &amp;gt; Target&lt;/i&gt;.&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;b&gt;CAN1 ... CAN4&lt;/b&gt;: the CAN buses of the controller itself (Linux names can0 ... can3). The Moduline L4 has four, the Moduline M1, HMI1 and S1 have two.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Multibus CAN 1, 2, 3&lt;/b&gt;: the CAN buses of a Multibus Module, on the Moduline M1, L4 and HMI1 only. Multibus CAN 1 is connector interface 1 of the module (Linux name mb_can1), Multibus CAN 2 is interface 3 (mb_can2) and Multibus CAN 3 is interface 4 (mb_can3).&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;These are the buses of one Multibus Module in the controller. A controller with two Multibus Modules is not supported by these blocks yet.&lt;/p&gt;&lt;h3&gt;Setting up a Multibus CAN bus on the controller&lt;/h3&gt;&lt;p&gt;The model only says which bus the block uses. What the bus is and how fast it runs is set on the controller, in an SSH session:&lt;/p&gt;&lt;ol&gt;&lt;li&gt;&lt;b&gt;go-multibus&lt;/b&gt; sets what each connector interface of the module is: classic CAN, CAN FD, RS485 or off. Set the interface you use to CAN or CAN FD in the terminal interface of go-multibus, or from the command line, for example &lt;code&gt;go-multibus set 1 canfd&lt;/code&gt; followed by &lt;code&gt;systemctl restart go-multibus&lt;/code&gt;. Which modes an interface accepts and which versions support CAN FD is on the knowledge base page:&lt;br&gt;&lt;a href=&quot;https://gocontroll.com/knowledge-base/configuration/gocontroll-services/go-multibus/&quot;&gt;https://gocontroll.com/knowledge-base/configuration/gocontroll-services/go-multibus/&lt;/a&gt;&lt;/li&gt;&lt;li&gt;&lt;b&gt;go-can&lt;/b&gt; sets the bitrate and, for a CAN FD bus, the data bitrate, for example &lt;code&gt;go-can set mb_can1 bitrate 500000&lt;/code&gt; and &lt;code&gt;go-can set mb_can1 data-bitrate 2000000&lt;/code&gt;. &lt;code&gt;go-can list&lt;/code&gt; shows every CAN bus with its state. The setting is stored and applied again at every start of the controller:&lt;br&gt;&lt;a href=&quot;https://gocontroll.com/knowledge-base/configuration/gocontroll-services/go-can/&quot;&gt;https://gocontroll.com/knowledge-base/configuration/gocontroll-services/go-can/&lt;/a&gt;&lt;/li&gt;&lt;/ol&gt;&lt;p&gt;The Multibus Module itself, its connector and its interfaces:&lt;br&gt;&lt;a href=&quot;https://gocontroll.com/knowledge-base/modular-hardware/modules/multibus/&quot;&gt;https://gocontroll.com/knowledge-base/modular-hardware/modules/multibus/&lt;/a&gt;&lt;/p&gt;&lt;p&gt;The bitrate of the CAN buses of a Linux controller itself (can0 ... can3) is also set with go-can. On the Moduline S1 the bitrate is set in the model, with the block &lt;i&gt;CAN configuration&lt;/i&gt;.&lt;/p&gt;&lt;h3&gt;When the bus is not there&lt;/h3&gt;&lt;p&gt;Whether a Multibus Module is fitted is not known when the model is built. If the selected bus does not exist when the application starts, the application prints &lt;code&gt;CAN &amp;lt;name&amp;gt;: interface not found, this bus is not used.&lt;/code&gt; and the block does nothing; the rest of the application keeps running.&lt;/p&gt;&lt;h3&gt;Classic CAN and CAN FD&lt;/h3&gt;&lt;p&gt;The blocks &lt;i&gt;CAN Receive-msg&lt;/i&gt; and &lt;i&gt;CAN Send-msg&lt;/i&gt; use classic CAN frames of up to 8 data bytes, also on a bus that is set to CAN FD. The blocks &lt;i&gt;CAN FD Receive&lt;/i&gt; and &lt;i&gt;CAN FD Send&lt;/i&gt; (Linux controllers only) use the CAN FD message of the Vehicle Network Toolbox and handle both classic and CAN FD frames. One bus uses either the classic blocks or the CAN FD blocks, not both. Use one receive block per bus.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</Help>
      <MaskParameter Name="ContrType" Type="edit" Evaluate="off" Enabled="off">
        <Prompt>Controller type</Prompt>
        <Value>Unknown controller</Value>
      </MaskParameter>
      <MaskParameter Name="canBus" Type="popup" Tunable="off">
        <Prompt>CAN channel</Prompt>
        <Value>CAN1 - Connector C pin 14 (L) and pin 15 (H)</Value>
        <Callback>go_can_bus_setup(gcb);</Callback>
        <TypeOptions>
          <Option>CAN1 - Connector C pin 14 (L) and pin 15 (H)</Option>
          <Option>CAN2 - Connector C pin 20 (L) and pin 21 (H)</Option>
          <Option>CAN3 - Connector C pin 19 (L) and pin 18 (H)</Option>
          <Option>CAN4 - Connector C pin 13 (L) and pin 12 (H)</Option>
          <Option>CAN1 - Connector B pin 24 (L) and pin 25 (H)</Option>
          <Option>CAN2 - Connector A pin 24 (L) and pin 25 (H)</Option>
          <Option>CAN1 - Connector A pin 16 (L) and pin 17 (H)</Option>
          <Option>CAN1 - Connector pin 16 (L) and pin 17 (H)</Option>
          <Option>CAN2 - Connector pin 24 (L) and pin 25 (H)</Option>
          <Option>Multibus CAN 1 - connector interface 1 (mb_can1)</Option>
          <Option>Multibus CAN 2 - connector interface 3 (mb_can2)</Option>
          <Option>Multibus CAN 3 - connector interface 4 (mb_can3)</Option>
        </TypeOptions>
      </MaskParameter>
      <MaskParameter Name="tsamp" Type="edit" Tunable="off">
        <Prompt>Sample time</Prompt>
        <Value>-1</Value>
      </MaskParameter>
      <DialogControl Type="Group" Name="DescGroupVar">
        <Prompt>%&lt;MaskType&gt;</Prompt>
        <DialogControl Type="Text" Name="DescTextVar">
          <Prompt>%&lt;MaskDescription&gt;</Prompt>
        </DialogControl>
      </DialogControl>
      <DialogControl Type="Group" Name="ParameterGroupVar">
        <Prompt>Simulink:studio:ToolBarParametersMenu</Prompt>
        <DialogControl Type="Edit" Name="ContrType">
          <Prompt>Controller type</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="Popup" Name="canBus">
          <Prompt>CAN channel</Prompt>
        </DialogControl>
        <DialogControl Type="Edit" Name="tsamp">
          <Prompt>Sample time</Prompt>
        </DialogControl>
      </DialogControl>
    </Mask>
  </Block>
  <Block BlockType="S-Function" Name="CAN Send-msg" SID="4133">
    <PortCounts in="1"/>
    <P Name="Position">[15, 265, 145, 345]</P>
    <P Name="ZOrder">225</P>
    <P Name="BackgroundColor">[1.000000, 0.666667, 0.000000]</P>
    <List ListType="RTWdata">
      <P Name="canBus">1</P>
      <P Name="canKey">1</P>
      <P Name="ifname">can0</P>
    </List>
    <P Name="FunctionName">sfcn_can_send_v2</P>
    <P Name="Parameters">canBus, tsamp</P>
    <P Name="SFunctionDeploymentMode">off</P>
    <P Name="EnableBusSupport">off</P>
    <P Name="SFcnIsStateOwnerBlock">off</P>
    <Mask SelfModifiable="on">
      <Type>CAN Send</Type>
      <Display IconUnits="pixels">fprintf(&apos;Send on\n%s&apos;, canLabel);
port_label(&apos;input&apos;, 1, &apos;Msg&apos;);

text(2, 6, GOcontroll_Simulink_version());</Display>
      <Description>&lt;p&gt;&lt;b&gt;CAN Send&lt;/b&gt;&lt;/p&gt;

&lt;p&gt;
Send a CAN message.
&lt;/p&gt;

&lt;p&gt;
The block expects a CAN_MESSAGE object as input. Use the CAN Pack block
to create the CAN_MESSAGE object.
&lt;/p&gt;

&lt;p&gt;
Channel: Select the CAN channel on which the message will be transmitted.
&lt;/p&gt;

&lt;p&gt;
Sample Time: Defines the execution rate of the block and therefore the
transmission rate of the CAN message.
&lt;/p&gt;
&lt;p&gt;&lt;b&gt;CAN channel:&lt;/b&gt; a CAN bus of the controller itself or, on the Moduline M1, L4 and HMI1, a CAN bus of a Multibus Module: &lt;i&gt;Multibus CAN 1&lt;/i&gt; (connector interface 1, mb_can1), &lt;i&gt;Multibus CAN 2&lt;/i&gt; (interface 3, mb_can2) and &lt;i&gt;Multibus CAN 3&lt;/i&gt; (interface 4, mb_can3). The Moduline S1 has no Multibus CAN channels.&lt;/p&gt;&lt;p&gt;&lt;b&gt;A Multibus CAN bus is set up on the controller, not in the model:&lt;/b&gt;&lt;br&gt;1. Set the connector interface of the module to CAN or CAN FD with the tool &lt;b&gt;go-multibus&lt;/b&gt;.&lt;br&gt;2. Set the bitrate, and for CAN FD the data bitrate, with the tool &lt;b&gt;go-can&lt;/b&gt;, for example &lt;i&gt;go-can set mb_can1 bitrate 500000&lt;/i&gt;.&lt;br&gt;Whether a Multibus Module is fitted is not known when the model is built. If the bus is not there when the application starts, a message is printed and the block does nothing. Click &lt;b&gt;Help&lt;/b&gt; for the steps and the pages of the GOcontroll knowledge base.&lt;/p&gt;&lt;p&gt;This block sends and receives classic CAN frames of up to 8 data bytes, also on a bus that is set to CAN FD.&lt;/p&gt;</Description>
      <Initialization>% Target, CAN channel list and the choice between a controller bus and a Multibus Module bus
[t, can] = go_can_bus_setup(gcb);
canLabel = can.label;

% canBus: bus number of the controller (S1). canKey and ifname: name in the generated code and
% Linux interface, for example can0 or mb_can1.
modelRTWFields = struct(&apos;canBus&apos;, can.canBus, &apos;canKey&apos;, can.key, &apos;ifname&apos;, can.ifname);
set_param(gcb, &apos;RTWdata&apos;, modelRTWFields);
</Initialization>
      <Help>&lt;html&gt;&lt;body style=&quot;font-family:sans-serif&quot;&gt;&lt;h2&gt;CAN Send&lt;/h2&gt;&lt;h3&gt;CAN channels&lt;/h3&gt;&lt;p&gt;The list &lt;i&gt;CAN channel&lt;/i&gt; follows the controller that is selected under &lt;i&gt;Configuration Parameters &amp;gt; Code Generation &amp;gt; GOcontroll options &amp;gt; Target&lt;/i&gt;.&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;b&gt;CAN1 ... CAN4&lt;/b&gt;: the CAN buses of the controller itself (Linux names can0 ... can3). The Moduline L4 has four, the Moduline M1, HMI1 and S1 have two.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Multibus CAN 1, 2, 3&lt;/b&gt;: the CAN buses of a Multibus Module, on the Moduline M1, L4 and HMI1 only. Multibus CAN 1 is connector interface 1 of the module (Linux name mb_can1), Multibus CAN 2 is interface 3 (mb_can2) and Multibus CAN 3 is interface 4 (mb_can3).&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;These are the buses of one Multibus Module in the controller. A controller with two Multibus Modules is not supported by these blocks yet.&lt;/p&gt;&lt;h3&gt;Setting up a Multibus CAN bus on the controller&lt;/h3&gt;&lt;p&gt;The model only says which bus the block uses. What the bus is and how fast it runs is set on the controller, in an SSH session:&lt;/p&gt;&lt;ol&gt;&lt;li&gt;&lt;b&gt;go-multibus&lt;/b&gt; sets what each connector interface of the module is: classic CAN, CAN FD, RS485 or off. Set the interface you use to CAN or CAN FD in the terminal interface of go-multibus, or from the command line, for example &lt;code&gt;go-multibus set 1 canfd&lt;/code&gt; followed by &lt;code&gt;systemctl restart go-multibus&lt;/code&gt;. Which modes an interface accepts and which versions support CAN FD is on the knowledge base page:&lt;br&gt;&lt;a href=&quot;https://gocontroll.com/knowledge-base/configuration/gocontroll-services/go-multibus/&quot;&gt;https://gocontroll.com/knowledge-base/configuration/gocontroll-services/go-multibus/&lt;/a&gt;&lt;/li&gt;&lt;li&gt;&lt;b&gt;go-can&lt;/b&gt; sets the bitrate and, for a CAN FD bus, the data bitrate, for example &lt;code&gt;go-can set mb_can1 bitrate 500000&lt;/code&gt; and &lt;code&gt;go-can set mb_can1 data-bitrate 2000000&lt;/code&gt;. &lt;code&gt;go-can list&lt;/code&gt; shows every CAN bus with its state. The setting is stored and applied again at every start of the controller:&lt;br&gt;&lt;a href=&quot;https://gocontroll.com/knowledge-base/configuration/gocontroll-services/go-can/&quot;&gt;https://gocontroll.com/knowledge-base/configuration/gocontroll-services/go-can/&lt;/a&gt;&lt;/li&gt;&lt;/ol&gt;&lt;p&gt;The Multibus Module itself, its connector and its interfaces:&lt;br&gt;&lt;a href=&quot;https://gocontroll.com/knowledge-base/modular-hardware/modules/multibus/&quot;&gt;https://gocontroll.com/knowledge-base/modular-hardware/modules/multibus/&lt;/a&gt;&lt;/p&gt;&lt;p&gt;The bitrate of the CAN buses of a Linux controller itself (can0 ... can3) is also set with go-can. On the Moduline S1 the bitrate is set in the model, with the block &lt;i&gt;CAN configuration&lt;/i&gt;.&lt;/p&gt;&lt;h3&gt;When the bus is not there&lt;/h3&gt;&lt;p&gt;Whether a Multibus Module is fitted is not known when the model is built. If the selected bus does not exist when the application starts, the application prints &lt;code&gt;CAN &amp;lt;name&amp;gt;: interface not found, this bus is not used.&lt;/code&gt; and the block does nothing; the rest of the application keeps running.&lt;/p&gt;&lt;h3&gt;Classic CAN and CAN FD&lt;/h3&gt;&lt;p&gt;The blocks &lt;i&gt;CAN Receive-msg&lt;/i&gt; and &lt;i&gt;CAN Send-msg&lt;/i&gt; use classic CAN frames of up to 8 data bytes, also on a bus that is set to CAN FD. The blocks &lt;i&gt;CAN FD Receive&lt;/i&gt; and &lt;i&gt;CAN FD Send&lt;/i&gt; (Linux controllers only) use the CAN FD message of the Vehicle Network Toolbox and handle both classic and CAN FD frames. One bus uses either the classic blocks or the CAN FD blocks, not both. Use one receive block per bus.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</Help>
      <MaskParameter Name="ContrType" Type="edit" Evaluate="off" Enabled="off">
        <Prompt>Controller type</Prompt>
        <Value>Unknown controller</Value>
      </MaskParameter>
      <MaskParameter Name="canBus" Type="popup" Tunable="off">
        <Prompt>CAN channel</Prompt>
        <Value>CAN1 - Connector C pin 14 (L) and pin 15 (H)</Value>
        <Callback>go_can_bus_setup(gcb);</Callback>
        <TypeOptions>
          <Option>CAN1 - Connector C pin 14 (L) and pin 15 (H)</Option>
          <Option>CAN2 - Connector C pin 20 (L) and pin 21 (H)</Option>
          <Option>CAN3 - Connector C pin 19 (L) and pin 18 (H)</Option>
          <Option>CAN4 - Connector C pin 13 (L) and pin 12 (H)</Option>
          <Option>CAN1 - Connector B pin 24 (L) and pin 25 (H)</Option>
          <Option>CAN2 - Connector A pin 24 (L) and pin 25 (H)</Option>
          <Option>CAN1 - Connector A pin 16 (L) and pin 17 (H)</Option>
          <Option>CAN1 - Connector pin 16 (L) and pin 17 (H)</Option>
          <Option>CAN2 - Connector pin 24 (L) and pin 25 (H)</Option>
          <Option>Multibus CAN 1 - connector interface 1 (mb_can1)</Option>
          <Option>Multibus CAN 2 - connector interface 3 (mb_can2)</Option>
          <Option>Multibus CAN 3 - connector interface 4 (mb_can3)</Option>
        </TypeOptions>
      </MaskParameter>
      <MaskParameter Name="tsamp" Type="edit" Tunable="off">
        <Prompt>Sample time</Prompt>
        <Value>0.1</Value>
      </MaskParameter>
      <DialogControl Type="Group" Name="DescGroupVar">
        <Prompt>%&lt;MaskType&gt;</Prompt>
        <DialogControl Type="Text" Name="DescTextVar">
          <Prompt>%&lt;MaskDescription&gt;</Prompt>
        </DialogControl>
      </DialogControl>
      <DialogControl Type="Group" Name="ParameterGroupVar">
        <Prompt>Simulink:studio:ToolBarParametersMenu</Prompt>
        <DialogControl Type="Edit" Name="ContrType">
          <Prompt>Controller type</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="Popup" Name="canBus">
          <Prompt>CAN channel</Prompt>
        </DialogControl>
        <DialogControl Type="Edit" Name="tsamp">
          <Prompt>Sample time</Prompt>
        </DialogControl>
      </DialogControl>
    </Mask>
  </Block>
  <Block BlockType="M-S-Function" Name="CAN configuration" SID="4343">
    <PortCounts/>
    <P Name="Position">[115, 419, 235, 491]</P>
    <P Name="ZOrder">229</P>
    <P Name="BackgroundColor">[1.000000, 0.666667, 0.000000]</P>
    <List ListType="RTWdata">
      <P Name="canBus">1</P>
      <P Name="baudrate">1</P>
      <P Name="autort">1</P>
      <P Name="canTxBuff">20</P>
      <P Name="canRxBuff">20</P>
    </List>
    <P Name="CopyFcn">go_block_platform_check(gcb, &apos;STM&apos;, &apos;notify&apos;);</P>
    <P Name="FunctionName">sfcn_can_config</P>
    <Mask SelfModifiable="on">
      <Type>CAN configuration</Type>
      <Display RunInitForIconRedraw="on" IconUnits="pixels">fprintf(&apos;CAN %x\n%s&apos;, canBus, get_param(gcb, &quot;baudrate&quot;));

text(2, 6, GOcontroll_Simulink_version());</Display>
      <Description>&lt;p&gt;&lt;b&gt;CAN Interface Configuration&lt;/b&gt;&lt;/p&gt;

&lt;p&gt;
Configure the CAN interface on the Moduline S1
&lt;/p&gt;

&lt;p&gt;
Auto retransmit enables automatic retry of a CAN message until it is
successfully transmitted. If disabled, a message that loses arbitration
or encounters an interruption may not be sent.
&lt;/p&gt;

&lt;p&gt;
This setting are applied to the selected CAN bus.
&lt;/p&gt;

&lt;p&gt;
The CAN transmit and receive buffer sizes define how many messages can
be stored in the respective queues.
&lt;/p&gt;

&lt;p&gt;
If the buffer size is too small, messages may be lost and not transmitted
or received correctly.
&lt;/p&gt;

&lt;p&gt;
This block has no effect on Linux-based targets.
&lt;/p&gt;&lt;p&gt;&lt;b&gt;For the Moduline S1 only.&lt;/b&gt; On the Linux controllers the bitrate of a CAN bus is set on the controller itself.&lt;/p&gt;</Description>
      <Initialization>go_block_platform_check(gcb, &apos;STM&apos;);
mdl = bdroot;
cs  = getActiveConfigSet(mdl);
try
t = go_target_name(get_param(cs,&apos;tlcGOcontrollTarget&apos;));
catch
t = &quot;Unknown controller&quot;;
end
msk = Simulink.Mask.get(gcb);
c = msk.getParameter(&apos;ContrType&apos;);
c.Value = t;

modelRTWFields = struct(&apos;canBus&apos;, int2str(canBus),...
                        &apos;baudrate&apos;, int2str(baudrate-1),...
                        &apos;autort&apos;, int2str(autort),...
                        &apos;canTxBuff&apos;, int2str(canTxBuff),...
                        &apos;canRxBuff&apos;, int2str(canRxBuff));

set_param(gcb, &apos;RTWdata&apos;, modelRTWFields);</Initialization>
      <Help>&lt;html&gt;&lt;body style=&quot;font-family:sans-serif&quot;&gt;&lt;h2&gt;CAN configuration&lt;/h2&gt;&lt;p&gt;Sets up a CAN bus of the Moduline S1: the bitrate and the size of the message buffers.&lt;/p&gt;&lt;h3&gt;How to use it&lt;/h3&gt;&lt;ul&gt;&lt;li&gt;&lt;b&gt;CAN channel&lt;/b&gt;: the bus to set up. Use one block per bus you use.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Baudrate&lt;/b&gt;: 125 kbit/s, 250 kbit/s, 500 kbit/s or 1 Mbit/s. Every device on the bus must use the same bitrate.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Auto retransmit&lt;/b&gt;: repeat a message that was not acknowledged. Leave it on unless the bus needs single-shot transmission.&lt;/li&gt;&lt;li&gt;&lt;b&gt;CAN tx buffer size&lt;/b&gt; and &lt;b&gt;CAN rx buffer size&lt;/b&gt;: how many messages can wait to be sent or processed.&lt;/li&gt;&lt;li&gt;The block has no ports. Place it once next to the CAN and XCP blocks.&lt;/li&gt;&lt;li&gt;On the Linux controllers the bitrate is not set in the model but on the controller, with go-can.&lt;/li&gt;&lt;/ul&gt;&lt;h3&gt;Controllers&lt;/h3&gt;&lt;p&gt;Moduline S1 only. In a model for a Linux controller (Moduline M1, L4, HMI1) the block gives an error. The greyed-out field &lt;i&gt;Controller type&lt;/i&gt;, when the block has one, shows the controller chosen under &lt;i&gt;Configuration Parameters &amp;gt; Code Generation &amp;gt; GOcontroll options &amp;gt; Target&lt;/i&gt;; the choices in the block follow it.&lt;/p&gt;&lt;h3&gt;GOcontroll knowledge base&lt;/h3&gt;&lt;ul&gt;&lt;li&gt;&lt;a href=&quot;https://gocontroll.com/knowledge-base/modular-hardware/controllers/s1/&quot;&gt;Moduline S1&lt;/a&gt;&lt;br&gt;https://gocontroll.com/knowledge-base/modular-hardware/controllers/s1/&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;https://gocontroll.com/knowledge-base/configuration/gocontroll-services/go-can/&quot;&gt;go-can: CAN bus settings on the controller&lt;/a&gt;&lt;br&gt;https://gocontroll.com/knowledge-base/configuration/gocontroll-services/go-can/&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;https://gocontroll.com/knowledge-base/getting-started/programming/simulink/blockset-information/&quot;&gt;Using the blockset&lt;/a&gt;&lt;br&gt;https://gocontroll.com/knowledge-base/getting-started/programming/simulink/blockset-information/&lt;/li&gt;&lt;/ul&gt;&lt;/body&gt;&lt;/html&gt;</Help>
      <MaskParameter Name="ContrType" Type="edit" Evaluate="off" Enabled="off">
        <Prompt>Controller type</Prompt>
        <Value>Unknown controller</Value>
      </MaskParameter>
      <MaskParameter Name="canBus" Type="popup" Tunable="off">
        <Prompt>CAN channel</Prompt>
        <Value>CAN1 - Connector A pin 16 (L) and pin 17 (H)</Value>
        <TypeOptions>
          <Option>CAN1 - Connector A pin 16 (L) and pin 17 (H)</Option>
          <Option>CAN2 - Connector A pin 24 (L) and pin 25 (H)</Option>
        </TypeOptions>
      </MaskParameter>
      <MaskParameter Name="baudrate" Type="popup" Tunable="off">
        <Prompt>Baudrate</Prompt>
        <Value>250kbit/s</Value>
        <TypeOptions>
          <Option>125kbit/s</Option>
          <Option>250kbit/s</Option>
          <Option>500kbit/s</Option>
          <Option>1Mbit/s</Option>
        </TypeOptions>
      </MaskParameter>
      <MaskParameter Name="autort" Type="checkbox">
        <Prompt>Auto retransmit</Prompt>
        <Value>on</Value>
      </MaskParameter>
      <MaskParameter Name="canTxBuff" Type="edit">
        <Prompt>CAN tx buffer size</Prompt>
        <Value>20</Value>
      </MaskParameter>
      <MaskParameter Name="canRxBuff" Type="edit">
        <Prompt>CAN rx buffer size</Prompt>
        <Value>20</Value>
      </MaskParameter>
      <DialogControl Type="Group" Name="DescGroupVar">
        <Prompt>%&lt;MaskType&gt;</Prompt>
        <DialogControl Type="Text" Name="DescTextVar">
          <Prompt>%&lt;MaskDescription&gt;</Prompt>
        </DialogControl>
      </DialogControl>
      <DialogControl Type="Group" Name="ParameterGroupVar">
        <Prompt>Parameters</Prompt>
        <DialogControl Type="Edit" Name="ContrType">
          <Prompt>Controller type</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="Popup" Name="canBus">
          <Prompt>CAN channel</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="Popup" Name="baudrate">
          <Prompt>Baudrate</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="CheckBox" Name="autort">
          <Prompt>Auto retransmit</Prompt>
        </DialogControl>
        <DialogControl Type="Edit" Name="canTxBuff">
          <Prompt>CAN tx buffer size</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="Edit" Name="canRxBuff">
          <Prompt>CAN rx buffer size</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
      </DialogControl>
    </Mask>
  </Block>
  <Block BlockType="M-S-Function" Name="CAN receive" SID="4134">
    <PortCounts in="1" out="2"/>
    <P Name="Position">[185, 40, 290, 200]</P>
    <P Name="ZOrder">227</P>
    <P Name="BackgroundColor">[1.000000, 0.666667, 0.000000]</P>
    <List ListType="RTWdata">
      <P Name="canBus">0</P>
      <P Name="outputNumber">1</P>
      <P Name="dataType">2</P>
      <P Name="byteOrder">1</P>
      <P Name="dataLength">1</P>
    </List>
    <P Name="FunctionName">sfcn_can_receive</P>
    <P Name="Parameters">tsamp,canBus,outputNumber,dataType, byteOrder</P>
    <Mask SelfModifiable="on">
      <Type>CAN receive (Legacy)</Type>
      <Display RunInitForIconRedraw="on" IconUnits="pixels">fprintf(&apos;Receive on\nCAN %x&apos;, canBus);
port_label(&apos;output&apos;, 1, &apos;new&apos;)
port_label(&apos;input&apos;, 1, &apos;ID&apos;);
text(2, 6, GOcontroll_Simulink_version());</Display>
      <Description>&lt;p&gt;&lt;b&gt;CAN receive (Legacy)&lt;/b&gt;&lt;/p&gt;

&lt;p&gt;
Receive the newest message from the specified CAN channel by CAN ID.
&lt;/p&gt;

&lt;p&gt;
&lt;b&gt;!! Legacy block — use CAN Receive-msg in new projects !!&lt;/b&gt;&lt;br/&gt;
These blocks will not work together with the -msg blocks in the same model.
&lt;/p&gt;

&lt;p&gt;&lt;b&gt;Parameters&lt;/b&gt;&lt;/p&gt;
&lt;p&gt;
&lt;b&gt;Controller type:&lt;/b&gt; Auto-detected from model configuration. Updates pinout labels and CAN channel options.&lt;br/&gt;
&lt;b&gt;CAN channel:&lt;/b&gt; The CAN channel to receive messages on.&lt;br/&gt;
&lt;b&gt;Output ports:&lt;/b&gt; The number of output data ports.&lt;br/&gt;
&lt;b&gt;Output datatype:&lt;/b&gt; The datatype of the output ports.&lt;br/&gt;
&lt;b&gt;Byte order:&lt;/b&gt; Checked = MSB first, unchecked = LSB first.&lt;br/&gt;
&lt;b&gt;Sample time:&lt;/b&gt; -1 or divisible by base sample time [seconds].
&lt;/p&gt;

&lt;p&gt;&lt;b&gt;Input&lt;/b&gt;&lt;/p&gt;
&lt;p&gt;
Port 1: CAN ID (uint32) in hexadecimal, e.g. hex2dec(&apos;0a&apos;)
&lt;/p&gt;

&lt;p&gt;&lt;b&gt;Output&lt;/b&gt;&lt;/p&gt;
&lt;p&gt;
Port 1: New message flag (bool)&lt;br/&gt;
Port 2..N: Message data bytes
&lt;/p&gt;</Description>
      <Initialization>mdl = bdroot;
cs  = getActiveConfigSet(mdl);
try
t = go_target_name(get_param(cs,&apos;tlcGOcontrollTarget&apos;));
catch
t = &quot;Unknown controller&quot;;
end
msk = Simulink.Mask.get(gcb);
cb = msk.getParameter(&apos;canBus&apos;);
c = msk.getParameter(&apos;ContrType&apos;);
c.Value = t;

if contains(t,&apos;Moduline S1&apos;)
    cb.TypeOptions = {&apos;CAN1 - Connector pin 16 (L) and pin 17 (H)&apos;,&apos;CAN2 - Connector pin 24 (L) and pin 25 (H)&apos;};
elseif contains(t,&apos;Moduline M1&apos;)
    cb.TypeOptions = {&apos;CAN1 - Connector B pin 24 (L) and pin 25 (H)&apos;,&apos;CAN2 - Connector A pin 24 (L) and pin 25 (H)&apos;};
elseif contains(t,&apos;Moduline L4&apos;)
    cb.TypeOptions = {&apos;CAN1 - Connector C pin 14 (L) and pin 15 (H)&apos;,&apos;CAN2 - Connector C pin 20 (L) and pin 21 (H)&apos;,...
        &apos;CAN3 - Connector C pin 19 (L) and pin 18 (H)&apos;,&apos;CAN4 - Connector C pin 13 (L) and pin 12 (H)&apos;};
elseif contains(t,&apos;Moduline HMI1&apos;)
    cb.TypeOptions = {&apos;CAN1 - Connector A pin 16 (L) and pin 17 (H)&apos;,&apos;CAN2 - Connector A pin 24 (L) and pin 25 (H)&apos;};
end

% calculate the data length (target specific)
dataLength = 0;
switch(dataType)
    case {1,2,7}
        % data length of 1 byte
        dataLength = outputNumber * 1;
    case {3,4}
        % data length of 2 bytes
        dataLength = outputNumber * 2;
    case {5,6}
        % data length of 4 bytes
        dataLength = outputNumber * 4;
end

% check if number of outputs, combined with the data type, is exceeding the
% maximum data length
if (dataLength &lt; 1)
    error (&apos;The CAN message has a minimum of 1 byte&apos;);
elseif (dataLength &gt; 8)
    error(&apos;The CAN message supports only up to 8 data bytes&apos;);
end

% Create resource keywords to be reserved in resource database
modelRTWFields = struct(&apos;canBus&apos;, int2str(canBus-1),...
    &apos;outputNumber&apos;, int2str(outputNumber), &apos;dataType&apos;, int2str(dataType), &apos;byteOrder&apos;, int2str(byteOrder),...
    &apos;dataLength&apos;, int2str(dataLength));

set_param(gcb, &apos;RTWdata&apos;, modelRTWFields);
</Initialization>
      <Help>&lt;html&gt;&lt;body style=&quot;font-family:sans-serif&quot;&gt;&lt;h2&gt;CAN receive (Legacy)&lt;/h2&gt;&lt;p&gt;Receives one CAN message by its identifier and outputs its data bytes. This is the older block that works on raw bytes; for new models use &lt;i&gt;CAN Receive-msg&lt;/i&gt; with a CAN Unpack block.&lt;/p&gt;&lt;h3&gt;How to use it&lt;/h3&gt;&lt;ul&gt;&lt;li&gt;Input: the CAN identifier (uint32).&lt;/li&gt;&lt;li&gt;Outputs: a flag that is 1 when a new message arrived, and 1 to N data ports.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Output ports&lt;/b&gt;, &lt;b&gt;Output datatype&lt;/b&gt; and &lt;b&gt;Byte order&lt;/b&gt; decide how the data bytes are grouped into values.&lt;/li&gt;&lt;li&gt;Do not use this block in one model together with the &lt;i&gt;-msg&lt;/i&gt; blocks.&lt;/li&gt;&lt;/ul&gt;&lt;h3&gt;Controllers&lt;/h3&gt;&lt;p&gt;All controllers: Moduline S1, M1, L4 and HMI1. The greyed-out field &lt;i&gt;Controller type&lt;/i&gt;, when the block has one, shows the controller chosen under &lt;i&gt;Configuration Parameters &amp;gt; Code Generation &amp;gt; GOcontroll options &amp;gt; Target&lt;/i&gt;; the choices in the block follow it.&lt;/p&gt;&lt;h3&gt;GOcontroll knowledge base&lt;/h3&gt;&lt;ul&gt;&lt;li&gt;&lt;a href=&quot;https://gocontroll.com/knowledge-base/getting-started/programming/simulink/blockset-information/&quot;&gt;Using the blockset&lt;/a&gt;&lt;br&gt;https://gocontroll.com/knowledge-base/getting-started/programming/simulink/blockset-information/&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;https://gocontroll.com/knowledge-base/configuration/gocontroll-services/go-can/&quot;&gt;go-can: CAN bus settings on the controller&lt;/a&gt;&lt;br&gt;https://gocontroll.com/knowledge-base/configuration/gocontroll-services/go-can/&lt;/li&gt;&lt;/ul&gt;&lt;/body&gt;&lt;/html&gt;</Help>
      <MaskParameter Name="ContrType" Type="edit" Evaluate="off" Enabled="off">
        <Prompt>Controller type</Prompt>
        <Value>Unknown controller</Value>
      </MaskParameter>
      <MaskParameter Name="canBus" Type="popup" Tunable="off">
        <Prompt>CAN channel</Prompt>
        <Value>CAN1 - Connector C pin 14 (L) and pin 15 (H)</Value>
        <TypeOptions>
          <Option>CAN1 - Connector C pin 14 (L) and pin 15 (H)</Option>
          <Option>CAN2 - Connector C pin 20 (L) and pin 21 (H)</Option>
          <Option>CAN3 - Connector C pin 19 (L) and pin 18 (H)</Option>
          <Option>CAN4 - Connector C pin 13 (L) and pin 12 (H)</Option>
        </TypeOptions>
      </MaskParameter>
      <MaskParameter Name="outputNumber" Type="edit" Tunable="off">
        <Prompt>Output ports</Prompt>
        <Value>1</Value>
      </MaskParameter>
      <MaskParameter Name="dataType" Type="popup" Tunable="off">
        <Prompt>Output datatype</Prompt>
        <Value>uint8</Value>
        <TypeOptions>
          <Option>int8</Option>
          <Option>uint8</Option>
          <Option>int16</Option>
          <Option>uint16</Option>
          <Option>int32</Option>
          <Option>uint32</Option>
          <Option>boolean</Option>
        </TypeOptions>
      </MaskParameter>
      <MaskParameter Name="byteOrder" Type="checkbox" Tunable="off">
        <Prompt>Byte order: Checked = MSB first, unchecked = LSB first.</Prompt>
        <Value>on</Value>
      </MaskParameter>
      <MaskParameter Name="tsamp" Type="edit" Tunable="off">
        <Prompt>Sample time</Prompt>
        <Value>-1</Value>
      </MaskParameter>
      <DialogControl Type="Group" Name="DescGroupVar">
        <Prompt>%&lt;MaskType&gt;</Prompt>
        <DialogControl Type="Text" Name="DescTextVar">
          <Prompt>%&lt;MaskDescription&gt;</Prompt>
        </DialogControl>
      </DialogControl>
      <DialogControl Type="Group" Name="ParameterGroupVar">
        <Prompt>Simulink:studio:ToolBarParametersMenu</Prompt>
        <DialogControl Type="Edit" Name="ContrType">
          <Prompt>Controller type</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="Popup" Name="canBus">
          <Prompt>CAN channel</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="Edit" Name="outputNumber">
          <Prompt>Output ports</Prompt>
        </DialogControl>
        <DialogControl Type="Popup" Name="dataType">
          <Prompt>Output datatype</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="CheckBox" Name="byteOrder">
          <Prompt>Byte order: Checked = MSB first, unchecked = LSB first.</Prompt>
        </DialogControl>
        <DialogControl Type="Edit" Name="tsamp">
          <Prompt>Sample time</Prompt>
        </DialogControl>
      </DialogControl>
    </Mask>
  </Block>
  <Block BlockType="M-S-Function" Name="CAN send" SID="4135">
    <PortCounts in="2"/>
    <P Name="Position">[40, 39, 145, 201]</P>
    <P Name="ZOrder">228</P>
    <P Name="BackgroundColor">[1.000000, 0.666667, 0.000000]</P>
    <List ListType="RTWdata">
      <P Name="canBus">0</P>
      <P Name="frameType">1</P>
      <P Name="inputNumber">1</P>
      <P Name="dataLength">1</P>
      <P Name="RTR">0</P>
    </List>
    <P Name="FunctionName">sfcn_can_send</P>
    <P Name="Parameters">tsamp, canBus, frameType, inputNumber,RTR</P>
    <Mask SelfModifiable="on">
      <Type>CAN send (Legacy)</Type>
      <Display RunInitForIconRedraw="on" IconUnits="pixels">fprintf(&apos;Send on\nCAN%x&apos;, canBus);
port_label(&apos;input&apos;, 1, &apos;ID&apos;);
if RTR
    fprintf(&apos;\n\n\n\nRTR&apos;);
end
text(2, 6, GOcontroll_Simulink_version());</Display>
      <Description>&lt;p&gt;&lt;b&gt;CAN send (Legacy)&lt;/b&gt;&lt;/p&gt;

&lt;p&gt;
Send a message on the CAN channel.
&lt;/p&gt;

&lt;p&gt;
&lt;b&gt;!! Legacy block — use CAN Send-msg in new projects !!&lt;/b&gt;&lt;br/&gt;
These blocks will not work together with the -msg blocks in the same model.
&lt;/p&gt;

&lt;p&gt;&lt;b&gt;Parameters&lt;/b&gt;&lt;/p&gt;
&lt;p&gt;
&lt;b&gt;Controller type:&lt;/b&gt; Auto-detected from model configuration. Updates pinout labels and CAN channel options.&lt;br/&gt;
&lt;b&gt;CAN channel:&lt;/b&gt; The CAN channel to send the message on.&lt;br/&gt;
&lt;b&gt;Identifier type:&lt;/b&gt; Standard (11-bit) or Extended (29-bit) identifier.&lt;br/&gt;
&lt;b&gt;Input ports:&lt;/b&gt; The number of input data ports.&lt;br/&gt;
&lt;b&gt;Remote frame (RTR):&lt;/b&gt; Enable to send a Remote Transmission Request frame.&lt;br/&gt;
&lt;b&gt;Sample time:&lt;/b&gt; -1 or divisible by base sample time [seconds].
&lt;/p&gt;

&lt;p&gt;&lt;b&gt;Input&lt;/b&gt;&lt;/p&gt;
&lt;p&gt;
Port 1: CAN ID (uint32) in hexadecimal, e.g. hex2dec(&apos;0a&apos;)&lt;br/&gt;
Port 2..N: CAN message data bytes (uint8)
&lt;/p&gt;</Description>
      <Initialization>mdl = bdroot;
cs  = getActiveConfigSet(mdl);
try
t = go_target_name(get_param(cs,&apos;tlcGOcontrollTarget&apos;));
catch
t = &quot;Unknown controller&quot;;
end
msk = Simulink.Mask.get(gcb);
cb = msk.getParameter(&apos;canBus&apos;);
c = msk.getParameter(&apos;ContrType&apos;);
c.Value = t;

if contains(t,&apos;Moduline S1&apos;)
    cb.TypeOptions = {&apos;CAN1 - Connector pin 16 (L) and pin 17 (H)&apos;,&apos;CAN2 - Connector pin 24 (L) and pin 25 (H)&apos;};
elseif contains(t,&apos;Moduline M1&apos;)
    cb.TypeOptions = {&apos;CAN1 - Connector B pin 24 (L) and pin 25 (H)&apos;,&apos;CAN2 - Connector A pin 24 (L) and pin 25 (H)&apos;};
elseif contains(t,&apos;Moduline L4&apos;)
    cb.TypeOptions = {&apos;CAN1 - Connector C pin 14 (L) and pin 15 (H)&apos;,&apos;CAN2 - Connector C pin 20 (L) and pin 21 (H)&apos;,...
        &apos;CAN3 - Connector C pin 19 (L) and pin 18 (H)&apos;,&apos;CAN4 - Connector C pin 13 (L) and pin 12 (H)&apos;};
elseif contains(t,&apos;Moduline HMI1&apos;)
    cb.TypeOptions = {&apos;CAN1 - Connector A pin 16 (L) and pin 17 (H)&apos;,&apos;CAN2 - Connector A pin 24 (L) and pin 25 (H)&apos;};
end

% check if number of inputs is exceeding the maximum data length
if (inputNumber &gt; 8)
    error(&apos;The CAN message supports only up to 8 data bytes&apos;);
elseif (inputNumber &lt; 0)
	error(&apos;The CAN message cant have a negative number of bytes&apos;);
end

% Create resource keywords to be reserved in resource database
modelRTWFields = struct(&apos;canBus&apos;, int2str(canBus-1), &apos;frameType&apos;, int2str(frameType),...
    &apos;inputNumber&apos;, int2str(inputNumber), &apos;dataLength&apos;, int2str(inputNumber), &apos;RTR&apos;, int2str(RTR));

set_param(gcb, &apos;RTWdata&apos;, modelRTWFields);</Initialization>
      <Help>&lt;html&gt;&lt;body style=&quot;font-family:sans-serif&quot;&gt;&lt;h2&gt;CAN send (Legacy)&lt;/h2&gt;&lt;p&gt;Sends one CAN message built from data bytes. This is the older block that works on raw bytes; for new models use a CAN Pack block with &lt;i&gt;CAN Send-msg&lt;/i&gt;.&lt;/p&gt;&lt;h3&gt;How to use it&lt;/h3&gt;&lt;ul&gt;&lt;li&gt;Inputs: the CAN identifier and the data bytes (uint8).&lt;/li&gt;&lt;li&gt;&lt;b&gt;Identifier type&lt;/b&gt;: standard (11 bit) or extended (29 bit).&lt;/li&gt;&lt;li&gt;&lt;b&gt;Input ports&lt;/b&gt;: the number of data bytes. &lt;b&gt;Remote Transmission Request&lt;/b&gt; sends a remote frame.&lt;/li&gt;&lt;li&gt;The sample time is the transmit rate.&lt;/li&gt;&lt;li&gt;Do not use this block in one model together with the &lt;i&gt;-msg&lt;/i&gt; blocks.&lt;/li&gt;&lt;/ul&gt;&lt;h3&gt;Controllers&lt;/h3&gt;&lt;p&gt;All controllers: Moduline S1, M1, L4 and HMI1. The greyed-out field &lt;i&gt;Controller type&lt;/i&gt;, when the block has one, shows the controller chosen under &lt;i&gt;Configuration Parameters &amp;gt; Code Generation &amp;gt; GOcontroll options &amp;gt; Target&lt;/i&gt;; the choices in the block follow it.&lt;/p&gt;&lt;h3&gt;GOcontroll knowledge base&lt;/h3&gt;&lt;ul&gt;&lt;li&gt;&lt;a href=&quot;https://gocontroll.com/knowledge-base/getting-started/programming/simulink/blockset-information/&quot;&gt;Using the blockset&lt;/a&gt;&lt;br&gt;https://gocontroll.com/knowledge-base/getting-started/programming/simulink/blockset-information/&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;https://gocontroll.com/knowledge-base/configuration/gocontroll-services/go-can/&quot;&gt;go-can: CAN bus settings on the controller&lt;/a&gt;&lt;br&gt;https://gocontroll.com/knowledge-base/configuration/gocontroll-services/go-can/&lt;/li&gt;&lt;/ul&gt;&lt;/body&gt;&lt;/html&gt;</Help>
      <MaskParameter Name="ContrType" Type="edit" Evaluate="off" Enabled="off">
        <Prompt>Controller type</Prompt>
        <Value>Unknown controller</Value>
      </MaskParameter>
      <MaskParameter Name="canBus" Type="popup" Tunable="off">
        <Prompt>CAN channel</Prompt>
        <Value>CAN1 - Connector C pin 14 (L) and pin 15 (H)</Value>
        <TypeOptions>
          <Option>CAN1 - Connector C pin 14 (L) and pin 15 (H)</Option>
          <Option>CAN2 - Connector C pin 20 (L) and pin 21 (H)</Option>
          <Option>CAN3 - Connector C pin 19 (L) and pin 18 (H)</Option>
          <Option>CAN4 - Connector C pin 13 (L) and pin 12 (H)</Option>
        </TypeOptions>
      </MaskParameter>
      <MaskParameter Name="frameType" Type="popup" Tunable="off">
        <Prompt>Identifier type</Prompt>
        <Value>Standard (11 bit)</Value>
        <TypeOptions>
          <Option>Standard (11 bit)</Option>
          <Option>Extended (29 bit)</Option>
        </TypeOptions>
      </MaskParameter>
      <MaskParameter Name="inputNumber" Type="edit" Tunable="off">
        <Prompt>Input ports</Prompt>
        <Value>1</Value>
      </MaskParameter>
      <MaskParameter Name="RTR" Type="checkbox" Tunable="off">
        <Prompt>Remote Transmission Request</Prompt>
        <Value>off</Value>
      </MaskParameter>
      <MaskParameter Name="tsamp" Type="edit" Tunable="off">
        <Prompt>Sample time</Prompt>
        <Value>-1</Value>
      </MaskParameter>
      <DialogControl Type="Group" Name="DescGroupVar">
        <Prompt>%&lt;MaskType&gt;</Prompt>
        <DialogControl Type="Text" Name="DescTextVar">
          <Prompt>%&lt;MaskDescription&gt;</Prompt>
        </DialogControl>
      </DialogControl>
      <DialogControl Type="Group" Name="ParameterGroupVar">
        <Prompt>Simulink:studio:ToolBarParametersMenu</Prompt>
        <DialogControl Type="Edit" Name="ContrType">
          <Prompt>Controller type</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="Popup" Name="canBus">
          <Prompt>CAN channel</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="Popup" Name="frameType">
          <Prompt>Identifier type</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="Edit" Name="inputNumber">
          <Prompt>Input ports</Prompt>
        </DialogControl>
        <DialogControl Type="CheckBox" Name="RTR">
          <Prompt>Remote Transmission Request</Prompt>
        </DialogControl>
        <DialogControl Type="Edit" Name="tsamp">
          <Prompt>Sample time</Prompt>
        </DialogControl>
      </DialogControl>
    </Mask>
  </Block>
</System>

