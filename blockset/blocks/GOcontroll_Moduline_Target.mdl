__MWOPC_PART_BEGIN__ /simulink/systems/system_4403.xml
<?xml version="1.0" encoding="utf-8"?>
<System>
  <P Name="Location">[0, 0, 0, 0]</P>
  <P Name="PaperType">usletter</P>
  <P Name="PaperUnits">inches</P>
  <P Name="TiledPaperMargins">[0.500000, 0.500000, 0.500000, 0.500000]</P>
  <Block BlockType="Reference" Name="CAN FD Pack" SID="4406">
    <PortCounts in="1" out="1"/>
    <P Name="Position">[320, 190, 540, 270]</P>
    <P Name="ZOrder">229</P>
    <P Name="LibraryVersion">8.1</P>
    <P Name="SourceBlock">canfdmsglib/CAN FD Pack</P>
    <P Name="SourceType">CAN FD Pack</P>
    <InstanceData>
      <P Name="MultithreadedSim">auto</P>
      <P Name="DataFormat">raw data</P>
      <P Name="MsgList">(none)</P>
      <P Name="MsgName">Msg</P>
      <P Name="ProtocolMode">CAN FD</P>
      <P Name="MsgIDType">Standard (11-bit identifier)</P>
      <P Name="MsgIdentifier">0</P>
      <P Name="MsgLength">8</P>
      <P Name="Remote">off</P>
      <P Name="BRSSwitch">off</P>
      <P Name="ApplyMinMax">off</P>
      <P Name="SignalInfo">{}</P>
    </InstanceData>
  </Block>
  <Block BlockType="S-Function" Name="CAN FD Receive" SID="4404">
    <PortCounts out="2"/>
    <P Name="Position">[60, 60, 190, 140]</P>
    <P Name="ZOrder">227</P>
    <P Name="BackgroundColor">[1.000000, 0.666667, 0.000000]</P>
    <List ListType="RTWdata">
      <P Name="canBus">1</P>
      <P Name="canKey">1</P>
      <P Name="ifname">can0</P>
    </List>
    <P Name="CopyFcn">go_block_platform_check(gcb, &apos;Linux&apos;, &apos;notify&apos;);</P>
    <P Name="FunctionName">sfcn_canfd_receive</P>
    <P Name="Parameters">canBus, tsamp</P>
    <P Name="SFunctionDeploymentMode">off</P>
    <P Name="EnableBusSupport">off</P>
    <P Name="SFcnIsStateOwnerBlock">off</P>
    <Mask SelfModifiable="on">
      <Type>CAN FD Receive</Type>
      <Display IconUnits="pixels">fprintf(&apos;Receive FD on\n%s&apos;, canLabel);

port_label(&apos;output&apos;, 1, &apos;function call&apos;);
port_label(&apos;output&apos;, 2, &apos;message&apos;);
text(2, 6, GOcontroll_Simulink_version());</Display>
      <Description>&lt;h2&gt;CAN FD Receive&lt;/h2&gt;&lt;p&gt;Receives every frame on one CAN bus, classic CAN and CAN FD. The output is a CAN_FD_MESSAGE_BUS, the message type of the CAN FD Pack and CAN FD Unpack blocks (in this library, next to this block). A function-call subsystem is triggered for each received frame; put CAN FD Unpack blocks in it to select messages and extract their signals.&lt;/p&gt;&lt;p&gt;Only one receive block can be used per CAN bus. A bus uses either the CAN FD blocks or the classic CAN blocks, not both; the CAN FD blocks also handle classic CAN frames.&lt;/p&gt;
&lt;p&gt;&lt;b&gt;CAN channel:&lt;/b&gt; a CAN bus of the controller itself or, on the Moduline M1, L4 and HMI1, a CAN bus of a Multibus Module: &lt;i&gt;Multibus CAN 1&lt;/i&gt; (connector interface 1, mb_can1), &lt;i&gt;Multibus CAN 2&lt;/i&gt; (interface 3, mb_can2) and &lt;i&gt;Multibus CAN 3&lt;/i&gt; (interface 4, mb_can3). The Moduline S1 has no Multibus CAN channels.&lt;/p&gt;&lt;p&gt;&lt;b&gt;A Multibus CAN bus is set up on the controller, not in the model:&lt;/b&gt;&lt;br&gt;1. Set the connector interface of the module to CAN or CAN FD with the tool &lt;b&gt;go-multibus&lt;/b&gt;.&lt;br&gt;2. Set the bitrate, and for CAN FD the data bitrate, with the tool &lt;b&gt;go-can&lt;/b&gt;, for example &lt;i&gt;go-can set mb_can1 bitrate 500000&lt;/i&gt;.&lt;br&gt;Whether a Multibus Module is fitted is not known when the model is built. If the bus is not there when the application starts, a message is printed and the block does nothing. Click &lt;b&gt;Help&lt;/b&gt; for the steps and the pages of the GOcontroll knowledge base.&lt;/p&gt;&lt;p&gt;CAN FD frames need a bus that is set to CAN FD. On a classic CAN bus the block works for classic frames only.&lt;/p&gt;&lt;p&gt;&lt;b&gt;For the Linux controllers (Moduline M1, L4, HMI1) only.&lt;/b&gt;&lt;/p&gt;</Description>
      <Initialization>go_block_platform_check(gcb, &apos;Linux&apos;);
% Target, CAN channel list and the choice between a controller bus and a Multibus Module bus
[t, can] = go_can_bus_setup(gcb);
canLabel = can.label;

% canBus: bus number of the controller (S1). canKey and ifname: name in the generated code and
% Linux interface, for example can0 or mb_can1.
modelRTWFields = struct(&apos;canBus&apos;, can.canBus, &apos;canKey&apos;, can.key, &apos;ifname&apos;, can.ifname);
set_param(gcb, &apos;RTWdata&apos;, modelRTWFields);
</Initialization>
      <Help>&lt;html&gt;&lt;body style=&quot;font-family:sans-serif&quot;&gt;&lt;h2&gt;CAN FD Receive&lt;/h2&gt;&lt;h3&gt;CAN channels&lt;/h3&gt;&lt;p&gt;The list &lt;i&gt;CAN channel&lt;/i&gt; follows the controller that is selected under &lt;i&gt;Configuration Parameters &amp;gt; Code Generation &amp;gt; GOcontroll options &amp;gt; Target&lt;/i&gt;.&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;b&gt;CAN1 ... CAN4&lt;/b&gt;: the CAN buses of the controller itself (Linux names can0 ... can3). The Moduline L4 has four, the Moduline M1, HMI1 and S1 have two.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Multibus CAN 1, 2, 3&lt;/b&gt;: the CAN buses of a Multibus Module, on the Moduline M1, L4 and HMI1 only. Multibus CAN 1 is connector interface 1 of the module (Linux name mb_can1), Multibus CAN 2 is interface 3 (mb_can2) and Multibus CAN 3 is interface 4 (mb_can3).&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;These are the buses of one Multibus Module in the controller. A controller with two Multibus Modules is not supported by these blocks yet.&lt;/p&gt;&lt;h3&gt;Setting up a Multibus CAN bus on the controller&lt;/h3&gt;&lt;p&gt;The model only says which bus the block uses. What the bus is and how fast it runs is set on the controller, in an SSH session:&lt;/p&gt;&lt;ol&gt;&lt;li&gt;&lt;b&gt;go-multibus&lt;/b&gt; sets what each connector interface of the module is: classic CAN, CAN FD, RS485 or off. Set the interface you use to CAN or CAN FD in the terminal interface of go-multibus, or from the command line, for example &lt;code&gt;go-multibus set 1 canfd&lt;/code&gt; followed by &lt;code&gt;systemctl restart go-multibus&lt;/code&gt;. Which modes an interface accepts and which versions support CAN FD is on the knowledge base page:&lt;br&gt;&lt;a href=&quot;https://gocontroll.com/knowledge-base/configuration/gocontroll-services/go-multibus/&quot;&gt;https://gocontroll.com/knowledge-base/configuration/gocontroll-services/go-multibus/&lt;/a&gt;&lt;/li&gt;&lt;li&gt;&lt;b&gt;go-can&lt;/b&gt; sets the bitrate and, for a CAN FD bus, the data bitrate, for example &lt;code&gt;go-can set mb_can1 bitrate 500000&lt;/code&gt; and &lt;code&gt;go-can set mb_can1 data-bitrate 2000000&lt;/code&gt;. &lt;code&gt;go-can list&lt;/code&gt; shows every CAN bus with its state. The setting is stored and applied again at every start of the controller:&lt;br&gt;&lt;a href=&quot;https://gocontroll.com/knowledge-base/configuration/gocontroll-services/go-can/&quot;&gt;https://gocontroll.com/knowledge-base/configuration/gocontroll-services/go-can/&lt;/a&gt;&lt;/li&gt;&lt;/ol&gt;&lt;p&gt;The Multibus Module itself, its connector and its interfaces:&lt;br&gt;&lt;a href=&quot;https://gocontroll.com/knowledge-base/modular-hardware/modules/multibus/&quot;&gt;https://gocontroll.com/knowledge-base/modular-hardware/modules/multibus/&lt;/a&gt;&lt;/p&gt;&lt;p&gt;The bitrate of the CAN buses of a Linux controller itself (can0 ... can3) is also set with go-can. On the Moduline S1 the bitrate is set in the model, with the block &lt;i&gt;CAN configuration&lt;/i&gt;.&lt;/p&gt;&lt;h3&gt;When the bus is not there&lt;/h3&gt;&lt;p&gt;Whether a Multibus Module is fitted is not known when the model is built. If the selected bus does not exist when the application starts, the application prints &lt;code&gt;CAN &amp;lt;name&amp;gt;: interface not found, this bus is not used.&lt;/code&gt; and the block does nothing; the rest of the application keeps running.&lt;/p&gt;&lt;h3&gt;Classic CAN and CAN FD&lt;/h3&gt;&lt;p&gt;The blocks &lt;i&gt;CAN Receive-msg&lt;/i&gt; and &lt;i&gt;CAN Send-msg&lt;/i&gt; use classic CAN frames of up to 8 data bytes, also on a bus that is set to CAN FD. The blocks &lt;i&gt;CAN FD Receive&lt;/i&gt; and &lt;i&gt;CAN FD Send&lt;/i&gt; (Linux controllers only) use the CAN FD message of the blocks CAN FD Pack and CAN FD Unpack, which are in this library next to them, and handle both classic and CAN FD frames. One bus uses either the classic blocks or the CAN FD blocks, not both. Use one receive block per bus.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</Help>
      <MaskParameter Name="ContrType" Type="edit" Evaluate="off" Enabled="off">
        <Prompt>Controller type</Prompt>
        <Value>Unknown controller</Value>
      </MaskParameter>
      <MaskParameter Name="canBus" Type="popup" Tunable="off">
        <Prompt>CAN channel</Prompt>
        <Value>CAN1 - Connector C pin 14 (L) and pin 15 (H)</Value>
        <Callback>go_can_bus_setup(gcb);</Callback>
        <TypeOptions>
          <Option>CAN1 - Connector C pin 14 (L) and pin 15 (H)</Option>
          <Option>CAN2 - Connector C pin 20 (L) and pin 21 (H)</Option>
          <Option>CAN3 - Connector C pin 19 (L) and pin 18 (H)</Option>
          <Option>CAN4 - Connector C pin 13 (L) and pin 12 (H)</Option>
          <Option>CAN1 - Connector B pin 24 (L) and pin 25 (H)</Option>
          <Option>CAN2 - Connector A pin 24 (L) and pin 25 (H)</Option>
          <Option>CAN1 - Connector A pin 16 (L) and pin 17 (H)</Option>
          <Option>CAN1 - Connector pin 16 (L) and pin 17 (H)</Option>
          <Option>CAN2 - Connector pin 24 (L) and pin 25 (H)</Option>
          <Option>Multibus CAN 1 - connector interface 1 (mb_can1)</Option>
          <Option>Multibus CAN 2 - connector interface 3 (mb_can2)</Option>
          <Option>Multibus CAN 3 - connector interface 4 (mb_can3)</Option>
        </TypeOptions>
      </MaskParameter>
      <MaskParameter Name="tsamp" Type="edit" Tunable="off">
        <Prompt>Sample time</Prompt>
        <Value>-1</Value>
      </MaskParameter>
      <DialogControl Type="Group" Name="DescGroupVar">
        <Prompt>%&lt;MaskType&gt;</Prompt>
        <DialogControl Type="Text" Name="DescTextVar">
          <Prompt>%&lt;MaskDescription&gt;</Prompt>
        </DialogControl>
      </DialogControl>
      <DialogControl Type="Group" Name="ParameterGroupVar">
        <Prompt>Simulink:studio:ToolBarParametersMenu</Prompt>
        <DialogControl Type="Edit" Name="ContrType">
          <Prompt>Controller type</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="Popup" Name="canBus">
          <Prompt>CAN channel</Prompt>
        </DialogControl>
        <DialogControl Type="Edit" Name="tsamp">
          <Prompt>Sample time</Prompt>
        </DialogControl>
      </DialogControl>
    </Mask>
  </Block>
  <Block BlockType="S-Function" Name="CAN FD Send" SID="4405">
    <PortCounts in="1"/>
    <P Name="Position">[260, 70, 390, 130]</P>
    <P Name="ZOrder">228</P>
    <P Name="BackgroundColor">[1.000000, 0.666667, 0.000000]</P>
    <List ListType="RTWdata">
      <P Name="canBus">1</P>
      <P Name="canKey">1</P>
      <P Name="ifname">can0</P>
    </List>
    <P Name="CopyFcn">go_block_platform_check(gcb, &apos;Linux&apos;, &apos;notify&apos;);</P>
    <P Name="FunctionName">sfcn_canfd_send</P>
    <P Name="Parameters">canBus, tsamp</P>
    <P Name="SFunctionDeploymentMode">off</P>
    <P Name="EnableBusSupport">off</P>
    <P Name="SFcnIsStateOwnerBlock">off</P>
    <Mask SelfModifiable="on">
      <Type>CAN FD Send</Type>
      <Display IconUnits="pixels">fprintf(&apos;Send FD on\n%s&apos;, canLabel);
port_label(&apos;input&apos;, 1, &apos;Msg&apos;);

text(2, 6, GOcontroll_Simulink_version());</Display>
      <Description>&lt;h2&gt;CAN FD Send&lt;/h2&gt;&lt;p&gt;Sends the CAN_FD_MESSAGE_BUS on its input, made with a CAN FD Pack block (in this library, next to this block). The Protocol mode of the message decides the frame: CAN gives a classic CAN frame of up to 8 data bytes, CAN FD gives a CAN FD frame of up to 64 data bytes, with the bit rate switch when BRS is set in the CAN FD Pack block. A length between two valid CAN FD lengths is rounded up and padded with zeros.&lt;/p&gt;&lt;p&gt;The sample time is the transmit rate. A bus uses either the CAN FD blocks or the classic CAN blocks, not both.&lt;/p&gt;
&lt;p&gt;&lt;b&gt;CAN channel:&lt;/b&gt; a CAN bus of the controller itself or, on the Moduline M1, L4 and HMI1, a CAN bus of a Multibus Module: &lt;i&gt;Multibus CAN 1&lt;/i&gt; (connector interface 1, mb_can1), &lt;i&gt;Multibus CAN 2&lt;/i&gt; (interface 3, mb_can2) and &lt;i&gt;Multibus CAN 3&lt;/i&gt; (interface 4, mb_can3). The Moduline S1 has no Multibus CAN channels.&lt;/p&gt;&lt;p&gt;&lt;b&gt;A Multibus CAN bus is set up on the controller, not in the model:&lt;/b&gt;&lt;br&gt;1. Set the connector interface of the module to CAN or CAN FD with the tool &lt;b&gt;go-multibus&lt;/b&gt;.&lt;br&gt;2. Set the bitrate, and for CAN FD the data bitrate, with the tool &lt;b&gt;go-can&lt;/b&gt;, for example &lt;i&gt;go-can set mb_can1 bitrate 500000&lt;/i&gt;.&lt;br&gt;Whether a Multibus Module is fitted is not known when the model is built. If the bus is not there when the application starts, a message is printed and the block does nothing. Click &lt;b&gt;Help&lt;/b&gt; for the steps and the pages of the GOcontroll knowledge base.&lt;/p&gt;&lt;p&gt;CAN FD frames need a bus that is set to CAN FD. On a classic CAN bus the block works for classic frames only.&lt;/p&gt;&lt;p&gt;&lt;b&gt;For the Linux controllers (Moduline M1, L4, HMI1) only.&lt;/b&gt;&lt;/p&gt;</Description>
      <Initialization>go_block_platform_check(gcb, &apos;Linux&apos;);
% Target, CAN channel list and the choice between a controller bus and a Multibus Module bus
[t, can] = go_can_bus_setup(gcb);
canLabel = can.label;

% canBus: bus number of the controller (S1). canKey and ifname: name in the generated code and
% Linux interface, for example can0 or mb_can1.
modelRTWFields = struct(&apos;canBus&apos;, can.canBus, &apos;canKey&apos;, can.key, &apos;ifname&apos;, can.ifname);
set_param(gcb, &apos;RTWdata&apos;, modelRTWFields);
</Initialization>
      <Help>&lt;html&gt;&lt;body style=&quot;font-family:sans-serif&quot;&gt;&lt;h2&gt;CAN FD Send&lt;/h2&gt;&lt;h3&gt;CAN channels&lt;/h3&gt;&lt;p&gt;The list &lt;i&gt;CAN channel&lt;/i&gt; follows the controller that is selected under &lt;i&gt;Configuration Parameters &amp;gt; Code Generation &amp;gt; GOcontroll options &amp;gt; Target&lt;/i&gt;.&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;b&gt;CAN1 ... CAN4&lt;/b&gt;: the CAN buses of the controller itself (Linux names can0 ... can3). The Moduline L4 has four, the Moduline M1, HMI1 and S1 have two.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Multibus CAN 1, 2, 3&lt;/b&gt;: the CAN buses of a Multibus Module, on the Moduline M1, L4 and HMI1 only. Multibus CAN 1 is connector interface 1 of the module (Linux name mb_can1), Multibus CAN 2 is interface 3 (mb_can2) and Multibus CAN 3 is interface 4 (mb_can3).&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;These are the buses of one Multibus Module in the controller. A controller with two Multibus Modules is not supported by these blocks yet.&lt;/p&gt;&lt;h3&gt;Setting up a Multibus CAN bus on the controller&lt;/h3&gt;&lt;p&gt;The model only says which bus the block uses. What the bus is and how fast it runs is set on the controller, in an SSH session:&lt;/p&gt;&lt;ol&gt;&lt;li&gt;&lt;b&gt;go-multibus&lt;/b&gt; sets what each connector interface of the module is: classic CAN, CAN FD, RS485 or off. Set the interface you use to CAN or CAN FD in the terminal interface of go-multibus, or from the command line, for example &lt;code&gt;go-multibus set 1 canfd&lt;/code&gt; followed by &lt;code&gt;systemctl restart go-multibus&lt;/code&gt;. Which modes an interface accepts and which versions support CAN FD is on the knowledge base page:&lt;br&gt;&lt;a href=&quot;https://gocontroll.com/knowledge-base/configuration/gocontroll-services/go-multibus/&quot;&gt;https://gocontroll.com/knowledge-base/configuration/gocontroll-services/go-multibus/&lt;/a&gt;&lt;/li&gt;&lt;li&gt;&lt;b&gt;go-can&lt;/b&gt; sets the bitrate and, for a CAN FD bus, the data bitrate, for example &lt;code&gt;go-can set mb_can1 bitrate 500000&lt;/code&gt; and &lt;code&gt;go-can set mb_can1 data-bitrate 2000000&lt;/code&gt;. &lt;code&gt;go-can list&lt;/code&gt; shows every CAN bus with its state. The setting is stored and applied again at every start of the controller:&lt;br&gt;&lt;a href=&quot;https://gocontroll.com/knowledge-base/configuration/gocontroll-services/go-can/&quot;&gt;https://gocontroll.com/knowledge-base/configuration/gocontroll-services/go-can/&lt;/a&gt;&lt;/li&gt;&lt;/ol&gt;&lt;p&gt;The Multibus Module itself, its connector and its interfaces:&lt;br&gt;&lt;a href=&quot;https://gocontroll.com/knowledge-base/modular-hardware/modules/multibus/&quot;&gt;https://gocontroll.com/knowledge-base/modular-hardware/modules/multibus/&lt;/a&gt;&lt;/p&gt;&lt;p&gt;The bitrate of the CAN buses of a Linux controller itself (can0 ... can3) is also set with go-can. On the Moduline S1 the bitrate is set in the model, with the block &lt;i&gt;CAN configuration&lt;/i&gt;.&lt;/p&gt;&lt;h3&gt;When the bus is not there&lt;/h3&gt;&lt;p&gt;Whether a Multibus Module is fitted is not known when the model is built. If the selected bus does not exist when the application starts, the application prints &lt;code&gt;CAN &amp;lt;name&amp;gt;: interface not found, this bus is not used.&lt;/code&gt; and the block does nothing; the rest of the application keeps running.&lt;/p&gt;&lt;h3&gt;Classic CAN and CAN FD&lt;/h3&gt;&lt;p&gt;The blocks &lt;i&gt;CAN Receive-msg&lt;/i&gt; and &lt;i&gt;CAN Send-msg&lt;/i&gt; use classic CAN frames of up to 8 data bytes, also on a bus that is set to CAN FD. The blocks &lt;i&gt;CAN FD Receive&lt;/i&gt; and &lt;i&gt;CAN FD Send&lt;/i&gt; (Linux controllers only) use the CAN FD message of the blocks CAN FD Pack and CAN FD Unpack, which are in this library next to them, and handle both classic and CAN FD frames. One bus uses either the classic blocks or the CAN FD blocks, not both. Use one receive block per bus.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</Help>
      <MaskParameter Name="ContrType" Type="edit" Evaluate="off" Enabled="off">
        <Prompt>Controller type</Prompt>
        <Value>Unknown controller</Value>
      </MaskParameter>
      <MaskParameter Name="canBus" Type="popup" Tunable="off">
        <Prompt>CAN channel</Prompt>
        <Value>CAN1 - Connector C pin 14 (L) and pin 15 (H)</Value>
        <Callback>go_can_bus_setup(gcb);</Callback>
        <TypeOptions>
          <Option>CAN1 - Connector C pin 14 (L) and pin 15 (H)</Option>
          <Option>CAN2 - Connector C pin 20 (L) and pin 21 (H)</Option>
          <Option>CAN3 - Connector C pin 19 (L) and pin 18 (H)</Option>
          <Option>CAN4 - Connector C pin 13 (L) and pin 12 (H)</Option>
          <Option>CAN1 - Connector B pin 24 (L) and pin 25 (H)</Option>
          <Option>CAN2 - Connector A pin 24 (L) and pin 25 (H)</Option>
          <Option>CAN1 - Connector A pin 16 (L) and pin 17 (H)</Option>
          <Option>CAN1 - Connector pin 16 (L) and pin 17 (H)</Option>
          <Option>CAN2 - Connector pin 24 (L) and pin 25 (H)</Option>
          <Option>Multibus CAN 1 - connector interface 1 (mb_can1)</Option>
          <Option>Multibus CAN 2 - connector interface 3 (mb_can2)</Option>
          <Option>Multibus CAN 3 - connector interface 4 (mb_can3)</Option>
        </TypeOptions>
      </MaskParameter>
      <MaskParameter Name="tsamp" Type="edit" Tunable="off">
        <Prompt>Sample time</Prompt>
        <Value>0.1</Value>
      </MaskParameter>
      <DialogControl Type="Group" Name="DescGroupVar">
        <Prompt>%&lt;MaskType&gt;</Prompt>
        <DialogControl Type="Text" Name="DescTextVar">
          <Prompt>%&lt;MaskDescription&gt;</Prompt>
        </DialogControl>
      </DialogControl>
      <DialogControl Type="Group" Name="ParameterGroupVar">
        <Prompt>Simulink:studio:ToolBarParametersMenu</Prompt>
        <DialogControl Type="Edit" Name="ContrType">
          <Prompt>Controller type</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="Popup" Name="canBus">
          <Prompt>CAN channel</Prompt>
        </DialogControl>
        <DialogControl Type="Edit" Name="tsamp">
          <Prompt>Sample time</Prompt>
        </DialogControl>
      </DialogControl>
    </Mask>
  </Block>
  <Block BlockType="Reference" Name="CAN FD Unpack" SID="4407">
    <PortCounts in="1" out="1"/>
    <P Name="Position">[60, 190, 280, 270]</P>
    <P Name="ZOrder">230</P>
    <P Name="LibraryVersion">8.1</P>
    <P Name="SourceBlock">canfdmsglib/CAN FD Unpack</P>
    <P Name="SourceType">CAN FD Unpack</P>
    <InstanceData>
      <P Name="MultithreadedSim">auto</P>
      <P Name="DataFormat">raw data</P>
      <P Name="MsgList">(none)</P>
      <P Name="MsgName">Msg</P>
      <P Name="ProtocolMode">CAN FD</P>
      <P Name="MsgIDType">Standard (11-bit identifier)</P>
      <P Name="MsgIdentifier">0</P>
      <P Name="MsgLength">8</P>
      <P Name="SignalInfo">{}</P>
      <P Name="IDPort">off</P>
      <P Name="TimestampPort">off</P>
      <P Name="ErrorPort">off</P>
      <P Name="RemotePort">off</P>
      <P Name="LengthPort">off</P>
      <P Name="StatusPort">off</P>
      <P Name="BRSPort">off</P>
      <P Name="ESIPort">off</P>
      <P Name="DLCPort">off</P>
      <P Name="ApplyMinMax">off</P>
    </InstanceData>
  </Block>
</System>

