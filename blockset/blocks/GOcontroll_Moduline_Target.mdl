      <MaskParameter Name="C6func" Type="popup">
        <Prompt>Channel 6 function</Prompt>
        <Value>Disable (output disabled)</Value>
        <Callback>func = get_param(gcb,&apos;C6func&apos;);
p=Simulink.Mask.get(gcb);
pc=p.getParameter(&apos;C6peakCurrent&apos;);
pt=p.getParameter(&apos;C6peakTime&apos;);
c=p.getParameter(&apos;C6cur&apos;);
flm=p.getParameter(&apos;C6flmod&apos;);
flc=p.getParameter(&apos;C6flchan&apos;);
flg=p.getParameter(&apos;C6flgain&apos;);
flbd=p.getParameter(&apos;C6flbasicDuty&apos;);

if( func == &quot;Peak and hold current mode (Half Bridge)&quot;)
pc.set(&apos;Visible&apos;,&apos;on&apos;);
pt.set(&apos;Visible&apos;,&apos;on&apos;);
else
pc.set(&apos;Visible&apos;,&apos;off&apos;);
pt.set(&apos;Visible&apos;,&apos;off&apos;);
end

if( func == &quot;Fast loop half bridge control&quot;)
    flm.set(&apos;Visible&apos;, &apos;on&apos;);
    flc.set(&apos;Visible&apos;, &apos;on&apos;);
    flg.set(&apos;Visible&apos;, &apos;on&apos;);
    flbd.set(&apos;Visible&apos;, &apos;on&apos;);
else
    flm.set(&apos;Visible&apos;, &apos;off&apos;);
    flc.set(&apos;Visible&apos;, &apos;off&apos;);
    flg.set(&apos;Visible&apos;, &apos;off&apos;);
    flbd.set(&apos;Visible&apos;, &apos;off&apos;);
end

if( func == &quot;Disable (output disabled)&quot;)
c.set(&apos;Enabled&apos;,&apos;off&apos;);
else
c.set(&apos;Enabled&apos;,&apos;on&apos;);  
end</Callback>
