__MWOPC_PART_BEGIN__ /simulink/systems/system_4229.xml
<?xml version="1.0" encoding="utf-8"?>
<System>
  <P Name="Location">[2661, 1122, 3795, 2098]</P>
  <P Name="PaperType">usletter</P>
  <P Name="ZoomFactor">111</P>
  <Block BlockType="M-S-Function" Name="TCP Configure" SID="4230">
    <PortCounts in="1" out="1"/>
    <P Name="Position">[1070, 425, 1225, 495]</P>
    <P Name="ZOrder">474</P>
    <P Name="BackgroundColor">[1.000000, 0.666667, 0.000000]</P>
    <List ListType="RTWdata">
      <P Name="port">9001</P>
      <P Name="ip">0.0.0.0</P>
      <P Name="socket_id">id</P>
      <P Name="remote_port">9002</P>
      <P Name="remote_ip">0.0.0.0</P>
      <P Name="socket_mode">1</P>
      <P Name="timeout">1000</P>
    </List>
    <P Name="CopyFcn">go_block_platform_check(gcb, &apos;Linux&apos;, &apos;notify&apos;);</P>
    <P Name="FunctionName">sfcn_TCPConfig</P>
    <Mask SelfModifiable="on">
      <Type>TCP Configure</Type>
      <Display RunInitForIconRedraw="on" IconUnits="pixels">if (socket_mode == 1)
    fprintf(&apos;Configure TCP server\n IP: %s\nPort: %d&apos;,ip,port);
else
    fprintf(&apos;Configure TCP client\n IP: %s\nPort: %d\nRemote IP: %s\n Remote port: %d&apos;,ip,port,remote_ip,remote_port);
end
port_label(&apos;output&apos;, 1, &apos;connected&apos;);
port_label(&apos;input&apos;, 1, &apos;disconnect&apos;);
text(2, 6, GOcontroll_Simulink_version());</Display>
      <Description>Block to configure a TCP socket

The socket ID should be a unique identifier to link the send and receive blocks to.
The name of the actual socket in the C code will be socket_&lt;socket id&gt;, so characters that would not work in a C variable name will not work.

Setting the ip to 0.0.0.0 makes the controller accept messages on all interfaces.
Set it to the ip of a specific interface to limit this.

The socket mode determines whether this socket will listen for a connection or actively try to make one to a given ip and port.
Server will wait for something to connect to it, the client will try to connect to a server at the given ip and port

Setting the timeout to zero disables the timeout

When the disconnect input is true, it will close the current connection if there is one, if there isn&apos;t one it will not allow a connection to be made as long as it is true.

Outputs whether or not the socket currently has an active connection (true means connnected)&lt;p&gt;&lt;b&gt;For the Linux controllers (Moduline M1, L4, HMI1) only.&lt;/b&gt;&lt;/p&gt;</Description>
      <Initialization>go_block_platform_check(gcb, &apos;Linux&apos;);
    if ~is_ip(ip)
        error(&apos;Entered IP is not valid&apos;);
    end
    if mod(port,1) &gt; 0 || port &lt; intmin(&apos;uint16&apos;) || port &gt; intmax(&apos;uint16&apos;)
        error(&apos;Entered Port is not valid, it should be an integer from 0-65335&apos;);
    end

    if ~is_ip(remote_ip)
        error(&apos;Entered remote IP is not valid&apos;);
    end
    if mod(remote_port,1) &gt; 0 || remote_port &lt; intmin(&apos;uint16&apos;) || remote_port &gt; intmax(&apos;uint16&apos;)
        error(&apos;Entered remote Port is not valid, it should be an integer from 0-65335&apos;);
    end

    if mod(timeout,1) &gt; 0 || timeout &lt; intmin(&apos;uint32&apos;) || timeout &gt; intmax(&apos;uint32&apos;)
        error(&apos;Entered timeout is not valid, it should be an integer from 0-4.294.967.295&apos;);
    end

    blockPath = split(gcb, &apos;/&apos;);
    configures = find_system(blockPath(1),&apos;RegExp&apos;, &apos;on&apos;,&apos;FollowLinks&apos;, &apos;on&apos;,&apos;MaskType&apos;,&apos;TCP Configure&apos;);
    options = cell(1,length(configures));
    for idx = 1:length(configures)
        options(idx) = get_param(configures(idx),&apos;socket_id&apos;);
    end

    if length(unique(options)) ~= length(options)
        error(&apos;Socket id is already in use, set a unique socket id&apos;);
    end

	modelRTWFields = struct(&apos;port&apos;, num2str(port), &apos;ip&apos;, ip, &apos;socket_id&apos;, socket_id, ...
        &apos;remote_port&apos;, num2str(remote_port), &apos;remote_ip&apos;, remote_ip, &apos;socket_mode&apos;, num2str(socket_mode), &apos;timeout&apos;, num2str(timeout));

	% Insert modelRTWFields in the I/O block S-Function containing the Tag starting with &apos;HANcoder_TARGET_&apos;
	HANcoder_TARGET_DataBlock = find_system(gcb, &apos;RegExp&apos;, &apos;on&apos;, &apos;FollowLinks&apos;, &apos;on&apos;, &apos;LookUnderMasks&apos;, &apos;all&apos;, &apos;BlockType&apos;, &apos;M-S-Function&apos;);
	set_param(HANcoder_TARGET_DataBlock{1}, &apos;RTWdata&apos;, modelRTWFields);</Initialization>
      <Help>&lt;html&gt;&lt;body style=&quot;font-family:sans-serif&quot;&gt;&lt;h2&gt;TCP Configure&lt;/h2&gt;&lt;p&gt;Opens a TCP connection, as server or as client. The TCP Receive and TCP Send blocks use it by its name.&lt;/p&gt;&lt;h3&gt;How to use it&lt;/h3&gt;&lt;ul&gt;&lt;li&gt;&lt;b&gt;Socket id&lt;/b&gt;: a name for this connection; use letters, digits and underscores. Give the same name in the receive and send blocks.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Socket mode&lt;/b&gt;: &lt;i&gt;Server&lt;/i&gt; waits for a connection on &lt;b&gt;ip&lt;/b&gt; and &lt;b&gt;port&lt;/b&gt; (0.0.0.0 listens on every network interface); &lt;i&gt;Client&lt;/i&gt; connects to &lt;b&gt;remote ip&lt;/b&gt; and &lt;b&gt;remote port&lt;/b&gt;.&lt;/li&gt;&lt;li&gt;&lt;b&gt;connection timeout (ms)&lt;/b&gt;: 0 switches it off.&lt;/li&gt;&lt;li&gt;Input: disconnect. Output: connected.&lt;/li&gt;&lt;/ul&gt;&lt;h3&gt;Controllers&lt;/h3&gt;&lt;p&gt;Linux controllers only: Moduline M1, L4 and HMI1. In a model for the Moduline S1 the block gives an error. The greyed-out field &lt;i&gt;Controller type&lt;/i&gt;, when the block has one, shows the controller chosen under &lt;i&gt;Configuration Parameters &amp;gt; Code Generation &amp;gt; GOcontroll options &amp;gt; Target&lt;/i&gt;; the choices in the block follow it.&lt;/p&gt;&lt;h3&gt;GOcontroll knowledge base&lt;/h3&gt;&lt;ul&gt;&lt;li&gt;&lt;a href=&quot;https://gocontroll.com/knowledge-base/getting-started/programming/simulink/blockset-information/&quot;&gt;Using the blockset&lt;/a&gt;&lt;br&gt;https://gocontroll.com/knowledge-base/getting-started/programming/simulink/blockset-information/&lt;/li&gt;&lt;/ul&gt;&lt;/body&gt;&lt;/html&gt;</Help>
      <MaskParameter Name="socket_id" Type="edit" Evaluate="off" Tunable="off">
        <Prompt>Socket id</Prompt>
        <Value>id</Value>
      </MaskParameter>
      <MaskParameter Name="port" Type="edit" Tunable="off">
        <Prompt>The port on which to listen/send</Prompt>
        <Value>9001</Value>
      </MaskParameter>
      <MaskParameter Name="ip" Type="edit" Tunable="off">
        <Prompt>The ip on which to listen/send</Prompt>
        <Value>&apos;0.0.0.0&apos;</Value>
      </MaskParameter>
      <MaskParameter Name="socket_mode" Type="popup">
        <Prompt>Socket mode:</Prompt>
        <Value>Server</Value>
        <Callback>mode = get_param(gcb, &apos;socket_mode&apos;);
mask = Simulink.Mask.get(gcb);
pars = mask.Parameters;
if strcmp(mode, &apos;Server&apos;)
    pars(5).set(&apos;Visible&apos;, &apos;off&apos;);
    pars(6).set(&apos;Visible&apos;, &apos;off&apos;);
else
    pars(5).set(&apos;Visible&apos;, &apos;on&apos;);
    pars(6).set(&apos;Visible&apos;, &apos;on&apos;);
end</Callback>
        <TypeOptions>
          <Option>Server</Option>
          <Option>Client</Option>
        </TypeOptions>
      </MaskParameter>
      <MaskParameter Name="remote_port" Type="edit" Tunable="off" Visible="off">
        <Prompt>The port to connect to</Prompt>
        <Value>9002</Value>
      </MaskParameter>
      <MaskParameter Name="remote_ip" Type="edit" Tunable="off" Visible="off">
        <Prompt>The ip to connect to</Prompt>
        <Value>&apos;0.0.0.0&apos;</Value>
      </MaskParameter>
      <MaskParameter Name="timeout" Type="edit" Tunable="off">
        <Prompt>The connection timeout (ms)</Prompt>
        <Value>1000</Value>
      </MaskParameter>
      <DialogControl Type="Group" Name="DescGroupVar">
        <Prompt>%&lt;MaskType&gt;</Prompt>
        <DialogControl Type="Text" Name="DescTextVar">
          <Prompt>%&lt;MaskDescription&gt;</Prompt>
        </DialogControl>
      </DialogControl>
      <DialogControl Type="Group" Name="ParameterGroupVar">
        <Prompt>Parameters</Prompt>
        <DialogControl Type="Edit" Name="socket_id">
          <Prompt>Socket id</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="Edit" Name="port">
          <Prompt>The port on which to listen/send</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="Edit" Name="ip">
          <Prompt>The ip on which to listen/send</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="Popup" Name="socket_mode">
          <Prompt>Socket mode:</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="Edit" Name="remote_port">
          <Prompt>The port to connect to</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="Edit" Name="remote_ip">
          <Prompt>The ip to connect to</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="Edit" Name="timeout">
          <Prompt>The connection timeout (ms)</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
      </DialogControl>
    </Mask>
  </Block>
  <Block BlockType="S-Function" Name="TCP Receive" SID="4272">
    <PortCounts out="3"/>
    <P Name="Position">[1070, 524, 1225, 596]</P>
    <P Name="ZOrder">475</P>
    <P Name="BackgroundColor">[1.000000, 0.666667, 0.000000]</P>
    <P Name="CopyFcn">go_block_platform_check(gcb, &apos;Linux&apos;, &apos;notify&apos;);</P>
    <P Name="FunctionName">sfcn_TCPReceive</P>
    <P Name="Parameters">buff_len,socket_mode,socket_id,tsamp</P>
    <P Name="SFunctionDeploymentMode">off</P>
    <P Name="EnableBusSupport">off</P>
    <P Name="SFcnIsStateOwnerBlock">off</P>
    <Mask SelfModifiable="on">
      <Type>TCP Receive</Type>
      <Display RunInitForIconRedraw="on" IconUnits="pixels">fprintf(&apos;TCP Receive\nSocket: %s&apos;, socket_id);
text(2, 6, GOcontroll_Simulink_version());
port_label(&apos;output&apos;, 1, &apos;function call&apos;);
port_label(&apos;output&apos;, 2, &apos;message&apos;);
port_label(&apos;output&apos;, 3, &apos;message length&apos;);</Display>
      <Description>Receive all TCP messages on the given socket

For every message received this block will call the functions attached to the function call output.
In these function calls you can then use the message and message length outputs to process/buffer the received messages.

Outputs:
function call:
Attach to a function call subsystem or something like it to call that function every time a message is received.

message:
The uint8 vector received from the socket. The length of this vector is likely longer than the actual number of bytes received.

message length:
The number of bytes actually received, use this to get the actual fresh bytes from the message.

Parameters:
buffer size:
The maximum number of bytes that can be read from the socket in one message, this also determines the width of the message vector.&lt;p&gt;&lt;b&gt;For the Linux controllers (Moduline M1, L4, HMI1) only.&lt;/b&gt;&lt;/p&gt;</Description>
      <Initialization>go_block_platform_check(gcb, &apos;Linux&apos;);
</Initialization>
      <Help>&lt;html&gt;&lt;body style=&quot;font-family:sans-serif&quot;&gt;&lt;h2&gt;TCP Receive&lt;/h2&gt;&lt;p&gt;Receives data on a TCP connection made with &lt;i&gt;TCP Configure&lt;/i&gt;.&lt;/p&gt;&lt;h3&gt;How to use it&lt;/h3&gt;&lt;ul&gt;&lt;li&gt;Choose the socket of the TCP Configure block.&lt;/li&gt;&lt;li&gt;Outputs: a function call for each received message, the message (uint8 vector of &lt;b&gt;Buffer size&lt;/b&gt;) and its length.&lt;/li&gt;&lt;li&gt;Process the message in a function-call subsystem.&lt;/li&gt;&lt;/ul&gt;&lt;h3&gt;Controllers&lt;/h3&gt;&lt;p&gt;Linux controllers only: Moduline M1, L4 and HMI1. In a model for the Moduline S1 the block gives an error. The greyed-out field &lt;i&gt;Controller type&lt;/i&gt;, when the block has one, shows the controller chosen under &lt;i&gt;Configuration Parameters &amp;gt; Code Generation &amp;gt; GOcontroll options &amp;gt; Target&lt;/i&gt;; the choices in the block follow it.&lt;/p&gt;&lt;h3&gt;GOcontroll knowledge base&lt;/h3&gt;&lt;ul&gt;&lt;li&gt;&lt;a href=&quot;https://gocontroll.com/knowledge-base/getting-started/programming/simulink/blockset-information/&quot;&gt;Using the blockset&lt;/a&gt;&lt;br&gt;https://gocontroll.com/knowledge-base/getting-started/programming/simulink/blockset-information/&lt;/li&gt;&lt;/ul&gt;&lt;/body&gt;&lt;/html&gt;</Help>
      <MaskParameter Name="tsamp" Type="edit">
        <Prompt>Sample time</Prompt>
        <Value>-1</Value>
      </MaskParameter>
      <MaskParameter Name="socket_id" Type="combobox" Evaluate="off" Tunable="off">
        <Prompt>Socket</Prompt>
        <Value>id</Value>
        <Callback>blockPath = split(gcb, &apos;/&apos;);
configures = find_system(blockPath(1),&apos;RegExp&apos;, &apos;on&apos;,&apos;FollowLinks&apos;, &apos;on&apos;,&apos;MaskType&apos;,&apos;TCP Configure&apos;);
mask = Simulink.Mask.get(gcb);
pars = mask.Parameters;
options = cell(1,length(configures));
for idx = 1:length(configures)
    options(idx) = get_param(configures(idx),&apos;socket_id&apos;);
end
mask.getParameter(&apos;socket_id&apos;).TypeOptions = options;
for idx = 1:length(configures)
    if strcmp(get_param(configures(idx),&apos;socket_id&apos;), get_param(gcb, &apos;socket_id&apos;))
        mode = Simulink.Mask.get(configures{idx}).getParameter(&apos;socket_mode&apos;).Value;
        set_param(gcb, &apos;socket_mode&apos;, mode);
    end
end</Callback>
        <TypeOptions>
          <Option>id</Option>
        </TypeOptions>
      </MaskParameter>
      <MaskParameter Name="buff_len" Type="edit" Tunable="off">
        <Prompt>Buffer size</Prompt>
        <Value>1</Value>
      </MaskParameter>
      <MaskParameter Name="socket_mode" Type="popup" Visible="off">
        <Value>Server</Value>
        <TypeOptions>
          <Option>Server</Option>
          <Option>Client</Option>
        </TypeOptions>
      </MaskParameter>
      <DialogControl Type="Group" Name="DescGroupVar">
        <Prompt>%&lt;MaskType&gt;</Prompt>
        <DialogControl Type="Text" Name="DescTextVar">
          <Prompt>%&lt;MaskDescription&gt;</Prompt>
        </DialogControl>
      </DialogControl>
      <DialogControl Type="Group" Name="ParameterGroupVar">
        <Prompt>Parameters</Prompt>
        <DialogControl Type="Edit" Name="tsamp">
          <Prompt>Sample time</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="ComboBox" Name="socket_id">
          <Prompt>Socket</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="Edit" Name="buff_len">
          <Prompt>Buffer size</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="Popup" Name="socket_mode">
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
      </DialogControl>
    </Mask>
  </Block>
  <Block BlockType="M-S-Function" Name="TCP Send" SID="4273">
    <PortCounts in="1"/>
    <P Name="Position">[1070, 627, 1225, 703]</P>
    <P Name="ZOrder">473</P>
    <P Name="BackgroundColor">[1.000000, 0.666667, 0.000000]</P>
    <List ListType="RTWdata">
      <P Name="socket_id">id</P>
      <P Name="socket_mode">1</P>
    </List>
    <P Name="CopyFcn">go_block_platform_check(gcb, &apos;Linux&apos;, &apos;notify&apos;);</P>
    <P Name="FunctionName">sfcn_TCPSend</P>
    <P Name="Parameters">tsamp</P>
    <Mask SelfModifiable="on">
      <Type>TCP Send</Type>
      <Display RunInitForIconRedraw="on" IconUnits="pixels">fprintf(&apos;TCP Send\nSocket: %s&apos;,socket_id);
port_label(&apos;input&apos;, 1, &apos;message&apos;);
text(2, 6, GOcontroll_Simulink_version());</Display>
      <Description>Send a TCP message to the chosen sockets connection, whether it be client or server.

The Message input should be a uint8 vector, if you end up with a [1xn] or [nx1] matrix, use the reshape block to turn it into a vector.&lt;p&gt;&lt;b&gt;For the Linux controllers (Moduline M1, L4, HMI1) only.&lt;/b&gt;&lt;/p&gt;</Description>
      <Initialization>go_block_platform_check(gcb, &apos;Linux&apos;);
    % update RTWdata to call WriteRTW again
    modelRTWFields = struct(&apos;socket_id&apos;, socket_id, &apos;socket_mode&apos;, num2str(socket_mode));

    % Insert modelRTWFields in the I/O block S-Function containing the Tag starting with &apos;HANcoder_TARGET_&apos;
    HANcoder_TARGET_DataBlock = find_system(gcb, &apos;RegExp&apos;, &apos;on&apos;, &apos;FollowLinks&apos;, &apos;on&apos;, &apos;LookUnderMasks&apos;, &apos;all&apos;, &apos;BlockType&apos;, &apos;M-S-Function&apos;);
    set_param(HANcoder_TARGET_DataBlock{1}, &apos;RTWdata&apos;, modelRTWFields);</Initialization>
      <Help>&lt;html&gt;&lt;body style=&quot;font-family:sans-serif&quot;&gt;&lt;h2&gt;TCP Send&lt;/h2&gt;&lt;p&gt;Sends data on a TCP connection made with &lt;i&gt;TCP Configure&lt;/i&gt;.&lt;/p&gt;&lt;h3&gt;How to use it&lt;/h3&gt;&lt;ul&gt;&lt;li&gt;Choose the socket of the TCP Configure block.&lt;/li&gt;&lt;li&gt;Input: the data as a uint8 vector.&lt;/li&gt;&lt;li&gt;The sample time is the send rate.&lt;/li&gt;&lt;/ul&gt;&lt;h3&gt;Controllers&lt;/h3&gt;&lt;p&gt;Linux controllers only: Moduline M1, L4 and HMI1. In a model for the Moduline S1 the block gives an error. The greyed-out field &lt;i&gt;Controller type&lt;/i&gt;, when the block has one, shows the controller chosen under &lt;i&gt;Configuration Parameters &amp;gt; Code Generation &amp;gt; GOcontroll options &amp;gt; Target&lt;/i&gt;; the choices in the block follow it.&lt;/p&gt;&lt;h3&gt;GOcontroll knowledge base&lt;/h3&gt;&lt;ul&gt;&lt;li&gt;&lt;a href=&quot;https://gocontroll.com/knowledge-base/getting-started/programming/simulink/blockset-information/&quot;&gt;Using the blockset&lt;/a&gt;&lt;br&gt;https://gocontroll.com/knowledge-base/getting-started/programming/simulink/blockset-information/&lt;/li&gt;&lt;/ul&gt;&lt;/body&gt;&lt;/html&gt;</Help>
      <MaskParameter Name="socket_id" Type="combobox" Evaluate="off">
        <Prompt>Socket</Prompt>
        <Value>id</Value>
        <Callback>blockPath = split(gcb, &apos;/&apos;);
configures = find_system(blockPath(1),&apos;RegExp&apos;, &apos;on&apos;,&apos;FollowLinks&apos;, &apos;on&apos;,&apos;MaskType&apos;,&apos;TCP Configure&apos;);
mask = Simulink.Mask.get(gcb);
pars = mask.Parameters;
options = cell(1,length(configures));
for idx = 1:length(configures)
    options(idx) = get_param(configures(idx),&apos;socket_id&apos;);
end
mask.getParameter(&apos;socket_id&apos;).TypeOptions = options;
for idx = 1:length(configures)
    if strcmp(get_param(configures(idx),&apos;socket_id&apos;), get_param(gcb, &apos;socket_id&apos;))
        mode = Simulink.Mask.get(configures{idx}).getParameter(&apos;socket_mode&apos;).Value;
        set_param(gcb, &apos;socket_mode&apos;, mode);
    end
end</Callback>
        <TypeOptions>
          <Option>id</Option>
        </TypeOptions>
      </MaskParameter>
      <MaskParameter Name="tsamp" Type="edit">
        <Prompt>Sample time</Prompt>
        <Value>1</Value>
      </MaskParameter>
      <MaskParameter Name="socket_mode" Type="popup" Visible="off">
        <Value>Server</Value>
        <TypeOptions>
          <Option>Server</Option>
          <Option>Client</Option>
        </TypeOptions>
      </MaskParameter>
      <DialogControl Type="Group" Name="DescGroupVar">
        <Prompt>%&lt;MaskType&gt;</Prompt>
        <DialogControl Type="Text" Name="DescTextVar">
          <Prompt>%&lt;MaskDescription&gt;</Prompt>
        </DialogControl>
      </DialogControl>
      <DialogControl Type="Group" Name="ParameterGroupVar">
        <Prompt>Simulink:studio:ToolBarParametersMenu</Prompt>
        <DialogControl Type="ComboBox" Name="socket_id">
          <Prompt>Socket</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="Edit" Name="tsamp">
          <Prompt>Sample time</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="Popup" Name="socket_mode">
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
      </DialogControl>
    </Mask>
  </Block>
</System>

__MWOPC_PART_BEGIN__ /simulink/systems/system_4294.xml
<?xml version="1.0" encoding="utf-8"?>
<System>
  <P Name="Location">[3912, 0, 7680, 2160]</P>
  <P Name="PaperType">usletter</P>
  <P Name="ZoomFactor">193</P>
  <P Name="SIDHighWatermark">4123</P>
  <P Name="SIDPrevWatermark">4123</P>
  <Block BlockType="TriggerPort" Name="Trigger" SID="4294:4122">
    <PortCounts/>
    <P Name="Position">[130, -40, 150, -20]</P>
    <P Name="ZOrder">-3</P>
    <P Name="VariantControl">(inherit)</P>
    <P Name="StatesWhenEnabling">held</P>
    <P Name="PortDimensions">1</P>
  </Block>
  <Block BlockType="M-S-Function" Name="Delete all DTC from memory" SID="4294:4120">
    <PortCounts/>
    <P Name="Position">[20, 21, 260, 59]</P>
    <P Name="ZOrder">106</P>
    <List ListType="RTWdata">
      <P Name="diagType">1</P>
    </List>
    <P Name="FunctionName">sfcn_memory_diagnostic_delete_code</P>
    <Mask SelfModifiable="on">
      <Type>Delete diagnostic codes from memory</Type>
      <Display RunInitForIconRedraw="on" IconUnits="pixels">fprintf(&apos;Delete all DTCs from memory&apos;);
text(2, 6, GOcontroll_Simulink_version());</Display>
      <Description>This function block deletes all stored codes.

Sample time:
-1 for inherited since this block is a triggered system</Description>
      <Initialization>

% Insert modelRTWFields in the I/O block S-Function containing the Tag starting with &apos;HANcoder_TARGET_&apos;
HANcoder_TARGET_DataBlock = find_system(gcb, &apos;RegExp&apos;, &apos;on&apos;, &apos;FollowLinks&apos;, &apos;on&apos;, &apos;LookUnderMasks&apos;, &apos;all&apos;, &apos;BlockType&apos;, &apos;M-S-Function&apos;);
</Initialization>
      <DialogControl Type="Group" Name="DescGroupVar">
        <Prompt>%&lt;MaskType&gt;</Prompt>
        <DialogControl Type="Text" Name="DescTextVar">
          <Prompt>%&lt;MaskDescription&gt;</Prompt>
        </DialogControl>
      </DialogControl>
      <DialogControl Type="Group" Name="ParameterGroupVar">
        <Prompt>Simulink:studio:ToolBarParametersMenu</Prompt>
      </DialogControl>
    </Mask>
  </Block>
</System>

__MWOPC_PART_BEGIN__ /simulink/systems/system_4295.xml
<?xml version="1.0" encoding="utf-8"?>
<System>
  <P Name="Location">[320, 193, 2875, 1708]</P>
  <P Name="PaperType">usletter</P>
  <P Name="ZoomFactor">400</P>
  <P Name="SIDHighWatermark">4130</P>
  <P Name="SIDPrevWatermark">4130</P>
  <Block BlockType="Inport" Name="In1" SID="4295:4126">
    <P Name="Position">[110, 98, 140, 112]</P>
    <P Name="ZOrder">-1</P>
  </Block>
  <Block BlockType="Inport" Name="In2" SID="4295:4130">
    <P Name="Position">[110, 133, 140, 147]</P>
    <P Name="ZOrder">106</P>
    <P Name="Port">2</P>
  </Block>
  <Block BlockType="TriggerPort" Name="Trigger" SID="4295:4127">
    <PortCounts/>
    <P Name="Position">[305, 30, 325, 50]</P>
    <P Name="ZOrder">-2</P>
    <P Name="VariantControl">(inherit)</P>
    <P Name="StatesWhenEnabling">held</P>
  </Block>
  <Block BlockType="M-S-Function" Name="Delete diagnostic code" SID="4295:4129">
    <PortCounts in="2"/>
    <P Name="Position">[160, 87, 475, 158]</P>
    <P Name="ZOrder">105</P>
    <P Name="BackgroundColor">[1.000000, 0.666667, 0.000000]</P>
    <List ListType="RTWdata">
      <P Name="diagType">1</P>
    </List>
    <P Name="FunctionName">sfcn_memory_diagnostic_delete_single_code</P>
    <Mask SelfModifiable="on">
      <Type>Store diagnostic code to memory</Type>
      <Display RunInitForIconRedraw="on" IconUnits="pixels">fprintf(&apos;Delete single DTC from memory&apos;);
port_label(&apos;input&apos;, 1, &apos;SPN&apos;);
port_label(&apos;input&apos;, 2, &apos;FMI&apos;);
text(2, 6, GOcontroll_Simulink_version());</Display>
      <Description>This function block stores a diagnostic code to memory.

Diagnostic code type:
The type defines the severity of the diagnostic code.

This block should be placed in a triggered subsystem</Description>
      <Initialization>
% Insert modelRTWFields in the I/O block S-Function containing the Tag starting with &apos;HANcoder_TARGET_&apos;
HANcoder_TARGET_DataBlock = find_system(gcb, &apos;RegExp&apos;, &apos;on&apos;, &apos;FollowLinks&apos;, &apos;on&apos;, &apos;LookUnderMasks&apos;, &apos;all&apos;, &apos;BlockType&apos;, &apos;M-S-Function&apos;);
</Initialization>
      <DialogControl Type="Group" Name="DescGroupVar">
        <Prompt>%&lt;MaskType&gt;</Prompt>
        <DialogControl Type="Text" Name="DescTextVar">
          <Prompt>%&lt;MaskDescription&gt;</Prompt>
        </DialogControl>
      </DialogControl>
      <DialogControl Type="Group" Name="ParameterGroupVar">
        <Prompt>Simulink:studio:ToolBarParametersMenu</Prompt>
      </DialogControl>
    </Mask>
  </Block>
  <Line>
    <P Name="ZOrder">1</P>
    <P Name="Src">4295:4130#out:1</P>
    <P Name="Dst">4295:4129#in:2</P>
  </Line>
  <Line>
    <P Name="ZOrder">2</P>
    <P Name="Src">4295:4126#out:1</P>
    <P Name="Dst">4295:4129#in:1</P>
  </Line>
</System>

__MWOPC_PART_BEGIN__ /simulink/systems/system_4298.xml
<?xml version="1.0" encoding="utf-8"?>
<System>
  <P Name="Location">[3912, 0, 7680, 2160]</P>
  <P Name="PaperType">usletter</P>
  <P Name="ZoomFactor">199</P>
  <P Name="SIDHighWatermark">4129</P>
  <P Name="SIDPrevWatermark">4129</P>
  <Block BlockType="TriggerPort" Name="Trigger" SID="4298:4127">
    <PortCounts/>
    <P Name="Position">[265, 25, 285, 45]</P>
    <P Name="ZOrder">-2</P>
    <P Name="VariantControl">(inherit)</P>
    <P Name="StatesWhenEnabling">held</P>
  </Block>
  <Block BlockType="M-S-Function" Name="Store DTC code" SID="4298:4129">
    <PortCounts/>
    <P Name="Position">[160, 95, 395, 145]</P>
    <P Name="ZOrder">105</P>
    <P Name="BackgroundColor">[1.000000, 0.666667, 0.000000]</P>
    <List ListType="RTWdata">
      <P Name="spn">1234</P>
      <P Name="fmi">0</P>
    </List>
    <P Name="FunctionName">sfcn_memory_diagnostic_write_code</P>
    <Mask SelfModifiable="on">
      <Type>Store diagnostic code to memory</Type>
      <Display RunInitForIconRedraw="on" IconUnits="pixels">fprintf(&apos;Store DTC in memory\n SPN: %s\nFMI: %s&apos;,spn,fmi);
text(2, 6, GOcontroll_Simulink_version());</Display>
      <Description>This function block stores a diagnostic code to memory.

SPN number:
A code to identify which part has failed

FMI:
How the part has failed

This block should be placed in a triggered subsystem</Description>
      <Initialization>
% Create resource keywords to be reserved in resource database
modelRTWFields = 	struct(	&apos;spn&apos;,int2str(spn),&apos;fmi&apos;,int2str(fmi));

% Insert modelRTWFields in the I/O block S-Function containing the Tag starting with &apos;HANcoder_TARGET_&apos;
HANcoder_TARGET_DataBlock = find_system(gcb, &apos;RegExp&apos;, &apos;on&apos;, &apos;FollowLinks&apos;, &apos;on&apos;, &apos;LookUnderMasks&apos;, &apos;all&apos;, &apos;BlockType&apos;, &apos;M-S-Function&apos;);
set_param(HANcoder_TARGET_DataBlock{1}, &apos;RTWdata&apos;, modelRTWFields);
</Initialization>
      <MaskParameter Name="spn" Type="edit">
        <Prompt>SPN number</Prompt>
        <Value>spn</Value>
      </MaskParameter>
      <MaskParameter Name="fmi" Type="popup">
        <Prompt>Failure Mode Indicator</Prompt>
        <Value>(0) Data valid but above normal operational range, most severe level (3)</Value>
        <EnumerationTypeOptions>
          <EnumNameInGeneratedCode/>
          <EnumerationMember>
            <DescriptiveName>(0) Data valid but above normal operational range, most severe level (3)</DescriptiveName>
            <MemberName/>
            <Value>0</Value>
          </EnumerationMember>
          <EnumerationMember>
            <DescriptiveName>(1) Data valid but below normal operational range, most severe level (3)</DescriptiveName>
            <MemberName/>
            <Value>1</Value>
          </EnumerationMember>
          <EnumerationMember>
            <DescriptiveName>(2) Data erratic, intermittent or incorrect (rationality)</DescriptiveName>
            <MemberName/>
            <Value>2</Value>
          </EnumerationMember>
          <EnumerationMember>
            <DescriptiveName>(3) Voltage above normal, or shorted to high source</DescriptiveName>
            <MemberName/>
            <Value>3</Value>
          </EnumerationMember>
          <EnumerationMember>
            <DescriptiveName>(4) Voltage below normal, or shorted to low source</DescriptiveName>
            <MemberName/>
            <Value>4</Value>
          </EnumerationMember>
          <EnumerationMember>
            <DescriptiveName>(5) Current below normal, or open circuit</DescriptiveName>
            <MemberName/>
            <Value>5</Value>
          </EnumerationMember>
          <EnumerationMember>
            <DescriptiveName>(6) Current above normal, or grounded circuit</DescriptiveName>
            <MemberName/>
            <Value>6</Value>
          </EnumerationMember>
          <EnumerationMember>
            <DescriptiveName>(7) Mechanical system not responding or out of adjustment</DescriptiveName>
            <MemberName/>
            <Value>7</Value>
          </EnumerationMember>
          <EnumerationMember>
            <DescriptiveName>(8) Abnormal frequency or pulse width or period</DescriptiveName>
            <MemberName/>
            <Value>8</Value>
          </EnumerationMember>
          <EnumerationMember>
            <DescriptiveName>(9) Abnormal update rate</DescriptiveName>
            <MemberName/>
            <Value>9</Value>
          </EnumerationMember>
          <EnumerationMember>
            <DescriptiveName>(10) Abnormal rate of change</DescriptiveName>
            <MemberName/>
            <Value>10</Value>
          </EnumerationMember>
          <EnumerationMember>
            <DescriptiveName>(11) Failure code not identifiable</DescriptiveName>
            <MemberName/>
            <Value>11</Value>
          </EnumerationMember>
          <EnumerationMember>
            <DescriptiveName>(12) Bad intelligent device or component</DescriptiveName>
            <MemberName/>
            <Value>12</Value>
          </EnumerationMember>
          <EnumerationMember>
            <DescriptiveName>(13) Out of calibration</DescriptiveName>
            <MemberName/>
            <Value>13</Value>
          </EnumerationMember>
          <EnumerationMember>
            <DescriptiveName>(14) Special instructions</DescriptiveName>
            <MemberName/>
            <Value>14</Value>
          </EnumerationMember>
          <EnumerationMember>
            <DescriptiveName>(15) Data valid but above normal range: least severe level (1)</DescriptiveName>
            <MemberName/>
            <Value>15</Value>
          </EnumerationMember>
          <EnumerationMember>
            <DescriptiveName>(16) Data valid but above normal range: moderately severe level (2)</DescriptiveName>
            <MemberName/>
            <Value>16</Value>
          </EnumerationMember>
          <EnumerationMember>
            <DescriptiveName>(17) Data valid but below normal range: least severe level (1)</DescriptiveName>
            <MemberName/>
            <Value>17</Value>
          </EnumerationMember>
          <EnumerationMember>
            <DescriptiveName>(18) Data Valid but below normal range: moderately severe level (2)</DescriptiveName>
            <MemberName/>
            <Value>18</Value>
          </EnumerationMember>
          <EnumerationMember>
            <DescriptiveName>(19) Received network data in error: (multiplexed data)</DescriptiveName>
            <MemberName/>
            <Value>19</Value>
          </EnumerationMember>
          <EnumerationMember>
            <DescriptiveName>(20) Data drifted high (rationality high)</DescriptiveName>
            <MemberName/>
            <Value>20</Value>
          </EnumerationMember>
          <EnumerationMember>
            <DescriptiveName>(21) Data drifted low (rationality low)</DescriptiveName>
            <MemberName/>
            <Value>21</Value>
          </EnumerationMember>
          <EnumerationMember>
            <DescriptiveName>(22) Condition exists</DescriptiveName>
            <MemberName/>
            <Value>22</Value>
          </EnumerationMember>
        </EnumerationTypeOptions>
      </MaskParameter>
      <DialogControl Type="Group" Name="DescGroupVar">
        <Prompt>%&lt;MaskType&gt;</Prompt>
        <DialogControl Type="Text" Name="DescTextVar">
          <Prompt>%&lt;MaskDescription&gt;</Prompt>
        </DialogControl>
      </DialogControl>
      <DialogControl Type="Group" Name="ParameterGroupVar">
        <Prompt>Simulink:studio:ToolBarParametersMenu</Prompt>
        <DialogControl Type="Edit" Name="spn">
          <Prompt>SPN number</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="Popup" Name="fmi">
          <Prompt>Failure Mode Indicator</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
      </DialogControl>
    </Mask>
  </Block>
</System>

__MWOPC_PART_BEGIN__ /simulink/systems/system_4338.xml
<?xml version="1.0" encoding="utf-8"?>
<System>
  <P Name="Location">[1920, 0, 3840, 2160]</P>
  <P Name="PaperType">usletter</P>
  <P Name="PaperUnits">inches</P>
  <P Name="TiledPaperMargins">[0.500000, 0.500000, 0.500000, 0.500000]</P>
  <P Name="ZoomFactor">250</P>
  <Block BlockType="SubSystem" Name="Actuator diagnostic" SID="4339">
    <PortCounts in="3" out="1" enable="1"/>
    <P Name="Position">[-65, 372, 240, 468]</P>
    <P Name="ZOrder">100000</P>
    <P Name="BackgroundColor">[1.000000, 0.666667, 0.000000]</P>
    <P Name="ContentPreviewEnabled">on</P>
    <Mask SelfModifiable="on">
      <Type>Generic actuator diagnostic block</Type>
      <Display RunInitForIconRedraw="on" IconUnits="pixels">fprintf(&apos;%s\n SPN: %d&apos;,...
    actuatorName,spn);

port_label(&apos;input&apos;, 1, &apos;Reset&apos;);
port_label(&apos;input&apos;, 2, &apos;Duty cycle [0-1000]&apos;);
port_label(&apos;input&apos;, 3, &apos;Measured current [mA]&apos;);

text(2, 6, GOcontroll_Simulink_version());</Display>
      <Description>This block executes diagnostics on an actuator that goes into the block. The current during control is checked.

It must be enabled via the enable input at the top to function, this can be a easy way to toggle diagnostics on or off.

To use this block, error limits should be defined in the workspace. Several pre- and suffixes are needed to work with this block. For example:

Base actuator name is: Valve1 (this will be the signal name in the mask)

- Valve1_ACTIVE_DUTY_CYCLE (This is the dutycycle when the valve is controlles. in case a switch is used, use 1)
- Valve1_MIN_CURRENT (Current in mA that should be the minimal to control the valve)
- Valve1_MAX_CURRENT (Current in mA that should be the minimal to control the valve)

Setting Diagnostic Trouble Code (DTC) in memory:

Configure the SPN number corresponding to the signal in the workspace parameters as:
Valve1_SPN

Output provide two uint8 signals in a bus holding the volatile and permanent fault flags.

</Description>
      <Help>&lt;html&gt;&lt;body style=&quot;font-family:sans-serif&quot;&gt;&lt;h2&gt;Generic actuator diagnostic block&lt;/h2&gt;&lt;p&gt;A ready-made check of an actuator: it stores a diagnostic code when the measured current does not fit the output that is driven.&lt;/p&gt;&lt;h3&gt;How to use it&lt;/h3&gt;&lt;ul&gt;&lt;li&gt;The limits come from workspace variables named after the actuator: &lt;i&gt;name&lt;/i&gt;_ACTIVE_DUTY_CYCLE, &lt;i&gt;name&lt;/i&gt;_MIN_CURRENT, &lt;i&gt;name&lt;/i&gt;_MAX_CURRENT and &lt;i&gt;name&lt;/i&gt;_SPN.&lt;/li&gt;&lt;li&gt;Take the current from the monitor block of the output or bridge module.&lt;/li&gt;&lt;/ul&gt;&lt;h3&gt;Controllers&lt;/h3&gt;&lt;p&gt;All controllers: Moduline S1, M1, L4 and HMI1. The greyed-out field &lt;i&gt;Controller type&lt;/i&gt;, when the block has one, shows the controller chosen under &lt;i&gt;Configuration Parameters &amp;gt; Code Generation &amp;gt; GOcontroll options &amp;gt; Target&lt;/i&gt;; the choices in the block follow it.&lt;/p&gt;&lt;h3&gt;GOcontroll knowledge base&lt;/h3&gt;&lt;ul&gt;&lt;li&gt;&lt;a href=&quot;https://gocontroll.com/knowledge-base/getting-started/programming/simulink/faults/&quot;&gt;Diagnostic codes (Faults)&lt;/a&gt;&lt;br&gt;https://gocontroll.com/knowledge-base/getting-started/programming/simulink/faults/&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;https://gocontroll.com/knowledge-base/getting-started/programming/simulink/blockset-information/&quot;&gt;Using the blockset&lt;/a&gt;&lt;br&gt;https://gocontroll.com/knowledge-base/getting-started/programming/simulink/blockset-information/&lt;/li&gt;&lt;/ul&gt;&lt;/body&gt;&lt;/html&gt;</Help>
      <MaskParameter Name="delay" Type="edit">
        <Prompt>Start delay [ms]</Prompt>
        <Value>1000</Value>
      </MaskParameter>
      <MaskParameter Name="duration" Type="edit">
        <Prompt>Fault duration [ms]</Prompt>
        <Value>2000</Value>
      </MaskParameter>
      <MaskParameter Name="actuatorName" Type="edit" Evaluate="off">
        <Prompt>Actuator name:</Prompt>
        <Value>Valve1</Value>
        <Callback>
set_param(gcb, &apos;MaskSelfModifiable&apos;, &apos;on&apos;);

S = get_param(gcb,&quot;actuatorName&quot;);
set_param(gcb + &quot;/ActiveState&quot;,&apos;const&apos;, S + &quot;_ACTIVE_DUTY_CYCLE&quot;);
set_param(gcb + &quot;/ActiveState2&quot;,&apos;const&apos;, S + &quot;_ACTIVE_DUTY_CYCLE&quot;);
set_param(gcb + &quot;/MinimalCurrent&quot;,&apos;const&apos;, S + &quot;_MIN_CURRENT&quot;);
set_param(gcb + &quot;/MaximalCurrent&quot;,&apos;const&apos;, S + &quot;_MAX_CURRENT&quot;);

set_param(gcb, &apos;spn&apos;, S + &quot;_SPN&quot;);

% Set signal naming 
P = get_param(gcb + &quot;/Per&quot;,&apos;PortHandles&apos;);
PerSubOut = P.Outport(1);
l1 = get_param(PerSubOut,&apos;Line&apos;);
set_param(l1,&apos;Name&apos;,&quot;Per_&quot; + S);

V = get_param(gcb + &quot;/Vol&quot;,&apos;PortHandles&apos;);
VolSubOut = V.Outport(1);
l1 = get_param(VolSubOut,&apos;Line&apos;);
set_param(l1,&apos;Name&apos;,&quot;Vol_&quot; + S);

try
    O = get_param(gcb,&apos;PortHandles&apos;);
    PortOut = O.Outport(1);
    l1 = get_param(PortOut,&apos;Line&apos;);
    set_param(l1,&apos;Name&apos;,S);
end</Callback>
        <Alias>Coolant_Pt1</Alias>
      </MaskParameter>
      <MaskParameter Name="spn" Type="edit" Internal="on" Visible="off">
        <Prompt>SPN:</Prompt>
        <Value>Valve1_SPN</Value>
      </MaskParameter>
      <DialogControl Type="Group" Name="DescGroupVar">
        <Prompt>%&lt;MaskType&gt;</Prompt>
        <DialogControl Type="Text" Name="DescTextVar">
          <Prompt>%&lt;MaskDescription&gt;</Prompt>
        </DialogControl>
      </DialogControl>
      <DialogControl Type="Group" Name="ParameterGroupVar">
        <Prompt>Diagnostic parameters</Prompt>
        <DialogControl Type="Edit" Name="delay">
          <Prompt>Start delay [ms]</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="Edit" Name="duration">
          <Prompt>Fault duration [ms]</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="Edit" Name="actuatorName">
          <Prompt>Actuator name:</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="Edit" Name="spn">
          <Prompt>SPN:</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
      </DialogControl>
    </Mask>
    <PortProperties>
      <Port Type="out" Index="1">
        <P Name="Name">Valve1</P>
      </Port>
    </PortProperties>
    <System Ref="system_4339"/>
  </Block>
  <Block BlockType="SubSystem" Name="Diagnostic simulation" SID="4340">
    <PortCounts in="1"/>
    <P Name="Position">[5, 610, 170, 660]</P>
    <P Name="ZOrder">100000</P>
    <P Name="BackgroundColor">[1.000000, 0.666667, 0.000000]</P>
    <Mask SelfModifiable="on">
      <Type>Diagnostic simulation</Type>
      <Display RunInitForIconRedraw="on" IconUnits="pixels">fprintf(&apos;%s&apos;, signalName);

text(2, 6, GOcontroll_Simulink_version());
</Display>
      <Description>This block works together with the &quot;Signal adaptation&quot; and &quot;Signal diagnostic&quot; blocks to provide an easy way to test the setting of diagnostic codes for analogue inputs.

It needs both of those blocks to be properly set up in the model along with their workspace variables. Then the Simulation variable of this signal must be set to 1.

A diagnostic scenario can then be injected:
== 1/default: normal operation
== 2: low voltage
== 3: high voltage
== 4: too low error
== 5: too high error
== 6: too low warning
== 7: too high warning

To simulate this it requires an extra lookup table which is the inverse of the normal signal lookup table, it should transfor the real world value back into the raw input.</Description>
      <Help>&lt;html&gt;&lt;body style=&quot;font-family:sans-serif&quot;&gt;&lt;h2&gt;Diagnostic simulation&lt;/h2&gt;&lt;p&gt;Injects a fault for testing the diagnostic checks, without a real fault in the machine.&lt;/p&gt;&lt;h3&gt;How to use it&lt;/h3&gt;&lt;ul&gt;&lt;li&gt;Choose one of the fault scenarios 1 to 7.&lt;/li&gt;&lt;li&gt;Use it during development only and remove it from the application that goes into the machine.&lt;/li&gt;&lt;/ul&gt;&lt;h3&gt;Controllers&lt;/h3&gt;&lt;p&gt;All controllers: Moduline S1, M1, L4 and HMI1. The greyed-out field &lt;i&gt;Controller type&lt;/i&gt;, when the block has one, shows the controller chosen under &lt;i&gt;Configuration Parameters &amp;gt; Code Generation &amp;gt; GOcontroll options &amp;gt; Target&lt;/i&gt;; the choices in the block follow it.&lt;/p&gt;&lt;h3&gt;GOcontroll knowledge base&lt;/h3&gt;&lt;ul&gt;&lt;li&gt;&lt;a href=&quot;https://gocontroll.com/knowledge-base/getting-started/programming/simulink/faults/&quot;&gt;Diagnostic codes (Faults)&lt;/a&gt;&lt;br&gt;https://gocontroll.com/knowledge-base/getting-started/programming/simulink/faults/&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;https://gocontroll.com/knowledge-base/getting-started/programming/simulink/blockset-information/&quot;&gt;Using the blockset&lt;/a&gt;&lt;br&gt;https://gocontroll.com/knowledge-base/getting-started/programming/simulink/blockset-information/&lt;/li&gt;&lt;/ul&gt;&lt;/body&gt;&lt;/html&gt;</Help>
      <MaskParameter Name="signalName" Type="edit" Evaluate="off">
        <Prompt>Signal</Prompt>
        <Value>Cb1Pt10</Value>
        <Callback>
set_param(gcb, &apos;MaskSelfModifiable&apos;, &apos;on&apos;);

S = get_param(gcb,&quot;signalName&quot;);
 set_param(gcb + &quot;/LowVoltage&quot;, &apos;Value&apos;, S + &quot;_RAW_ERR_LOW -1&quot;);
 set_param(gcb + &quot;/HighVoltage&quot;, &apos;Value&apos;, S + &quot;_RAW_ERR_HIGH +1&quot;);
 set_param(gcb + &quot;/LowWarning&quot;,  &apos;Value&apos;,S + &quot;_SIG_WAR_LOW -1&quot;);
 set_param(gcb + &quot;/HighWarning&quot;, &apos;Value&apos;, S + &quot;_SIG_WAR_HIGH +1&quot;);
 set_param(gcb + &quot;/LowError&quot;, &apos;Value&apos;, S + &quot;_SIG_ERR_LOW -1&quot;);
 set_param(gcb + &quot;/HighError&quot;, &apos;Value&apos;, S + &quot;_SIG_ERR_HIGH +1&quot;);
 set_param(gcb + &quot;/Normal&quot;, &apos;Value&apos;, &quot;C_&quot; + S);

% Set Goto tags depending on signal naming
set_param(gcb + &quot;/ToRaw&quot;,&quot;GotoTag&quot;,&quot;RawSim_&quot; + S);
set_param(gcb, &quot;sensorCurve&quot;, get_param(gcb,&quot;sensorCurveText&quot;));</Callback>
      </MaskParameter>
      <MaskParameter Name="sensorCurveText" Type="edit" Evaluate="off">
        <Prompt>Sensor curve</Prompt>
        <Value>Pres_0_20_bar_500_4500_mv_inv</Value>
      </MaskParameter>
      <MaskParameter Name="sensorCurve" Type="edit" Visible="off">
        <Value>Pres_0_20_bar_500_4500_mv_inv</Value>
      </MaskParameter>
      <DialogControl Type="Group" Name="DescGroupVar">
        <Prompt>%&lt;MaskType&gt;</Prompt>
        <DialogControl Type="Text" Name="DescTextVar">
          <Prompt>%&lt;MaskDescription&gt;</Prompt>
        </DialogControl>
      </DialogControl>
      <DialogControl Type="Group" Name="ParameterGroupVar">
        <Prompt>Parameters</Prompt>
        <DialogControl Type="Edit" Name="signalName">
          <Prompt>Signal</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="Edit" Name="sensorCurveText">
          <Prompt>Sensor curve</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="Edit" Name="sensorCurve">
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
      </DialogControl>
    </Mask>
    <System Ref="system_4340"/>
  </Block>
  <Block BlockType="SubSystem" Name="Generic diagnostic" SID="4341">
    <PortCounts in="2" out="2"/>
    <P Name="Position">[-75, 699, 230, 786]</P>
    <P Name="ZOrder">100000</P>
    <P Name="BackgroundColor">[1.000000, 0.666667, 0.000000]</P>
    <P Name="ContentPreviewEnabled">on</P>
    <Mask SelfModifiable="on">
      <Type>Generic actuator diagnostic block</Type>
      <Display RunInitForIconRedraw="on" IconUnits="pixels">fprintf(&apos;%s\n\nDTC serverity: %d\nSPN: %d&apos;,...
    naming,fmi,spn);

port_label(&apos;input&apos;, 1, &apos;Reset&apos;);
port_label(&apos;input&apos;, 2, &apos;Trigger&apos;);

port_label(&apos;output&apos;, 1, &apos;Persistant flag&apos;);
port_label(&apos;output&apos;, 2, &apos;Volatile flag&apos;);

text(2, 6, GOcontroll_Simulink_version());
</Display>
      <Description>A simple diagnostic helper, diagnostics start after &quot;Start delay&quot; and then if trigger == 1 for &quot;Fault duration&quot; it will write the fault code to memory.

Once the trigger drops to 0 again, the volatile output will also go back to 0, but the persistant output will remain at 1. Untill the reset input is applied, this will also reset the persistant output. Note that this will not delete the code from memory.

The naming parameter is non functional but helps by naming the output signals and being displayed in the mask.</Description>
      <Help>&lt;html&gt;&lt;body style=&quot;font-family:sans-serif&quot;&gt;&lt;h2&gt;Generic actuator diagnostic block&lt;/h2&gt;&lt;p&gt;A ready-made check that stores a diagnostic code when its trigger input stays active long enough.&lt;/p&gt;&lt;h3&gt;How to use it&lt;/h3&gt;&lt;ul&gt;&lt;li&gt;&lt;b&gt;Start delay&lt;/b&gt;: time after start-up in which the check is not active.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Fault duration&lt;/b&gt;: how long the trigger must stay active before the code is stored.&lt;/li&gt;&lt;li&gt;Outputs: a fault flag that resets itself and one that stays set until the reset input is used.&lt;/li&gt;&lt;/ul&gt;&lt;h3&gt;Controllers&lt;/h3&gt;&lt;p&gt;All controllers: Moduline S1, M1, L4 and HMI1. The greyed-out field &lt;i&gt;Controller type&lt;/i&gt;, when the block has one, shows the controller chosen under &lt;i&gt;Configuration Parameters &amp;gt; Code Generation &amp;gt; GOcontroll options &amp;gt; Target&lt;/i&gt;; the choices in the block follow it.&lt;/p&gt;&lt;h3&gt;GOcontroll knowledge base&lt;/h3&gt;&lt;ul&gt;&lt;li&gt;&lt;a href=&quot;https://gocontroll.com/knowledge-base/getting-started/programming/simulink/faults/&quot;&gt;Diagnostic codes (Faults)&lt;/a&gt;&lt;br&gt;https://gocontroll.com/knowledge-base/getting-started/programming/simulink/faults/&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;https://gocontroll.com/knowledge-base/getting-started/programming/simulink/blockset-information/&quot;&gt;Using the blockset&lt;/a&gt;&lt;br&gt;https://gocontroll.com/knowledge-base/getting-started/programming/simulink/blockset-information/&lt;/li&gt;&lt;/ul&gt;&lt;/body&gt;&lt;/html&gt;</Help>
      <MaskParameter Name="delay" Type="edit">
        <Prompt>Start delay [ms]</Prompt>
        <Value>1000</Value>
      </MaskParameter>
      <MaskParameter Name="duration" Type="edit">
        <Prompt>Fault duration [ms]</Prompt>
        <Value>2000</Value>
      </MaskParameter>
      <MaskParameter Name="naming" Type="edit" Evaluate="off">
        <Prompt>Naming:</Prompt>
        <Value>Valve2</Value>
        <Callback>
set_param(gcb, &apos;MaskSelfModifiable&apos;, &apos;on&apos;);

S = get_param(gcb,&quot;naming&quot;);

% Set signal naming 
try
    P = get_param(gcb,&apos;PortHandles&apos;);
    OutputPort1 = P.Outport(1);
    l1 = get_param(OutputPort1,&apos;Line&apos;);
    set_param(l1,&apos;Name&apos;,&quot;Per_&quot; + S);
    
    OutputPort2 = P.Outport(2);
    l1 = get_param(OutputPort2,&apos;Line&apos;);
    set_param(l1,&apos;Name&apos;,&quot;Vol_&quot; + S);
end</Callback>
        <Alias>Coolant_Pt1</Alias>
      </MaskParameter>
      <MaskParameter Name="spn" Type="promote">
        <Prompt>SPN number</Prompt>
        <Value>1234</Value>
        <TypeOptions>
          <Option>Store diagnostic code/spn</Option>
        </TypeOptions>
      </MaskParameter>
      <MaskParameter Name="fmi" Type="promote">
        <Prompt>Failure Mode Indicator</Prompt>
        <Value>(0) Data valid but above normal operational range, most severe level (3)</Value>
        <TypeOptions>
          <Option>Store diagnostic code/fmi</Option>
        </TypeOptions>
      </MaskParameter>
      <DialogControl Type="Group" Name="DescGroupVar">
        <Prompt>%&lt;MaskType&gt;</Prompt>
        <DialogControl Type="Text" Name="DescTextVar">
          <Prompt>%&lt;MaskDescription&gt;</Prompt>
        </DialogControl>
      </DialogControl>
      <DialogControl Type="Group" Name="ParameterGroupVar">
        <Prompt>Diagnostic parameters</Prompt>
        <DialogControl Type="Edit" Name="delay">
          <Prompt>Start delay [ms]</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="Edit" Name="duration">
          <Prompt>Fault duration [ms]</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="Edit" Name="naming">
          <Prompt>Naming:</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="Edit" Name="spn">
          <Prompt>SPN number</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="Popup" Name="fmi">
          <Prompt>Failure Mode Indicator</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
      </DialogControl>
    </Mask>
    <PortProperties>
      <Port Type="out" Index="1">
        <P Name="Name">Per_Valve2</P>
        <P Name="PropagatedSignals">FlagPersist</P>
      </Port>
      <Port Type="out" Index="2">
        <P Name="Name">Vol_Valve2</P>
        <P Name="PropagatedSignals">FlagVolatile</P>
      </Port>
    </PortProperties>
    <System Ref="system_4341"/>
  </Block>
  <Block BlockType="SubSystem" Name="Signal diagnostic" SID="4342">
    <PortCounts in="3" out="1" enable="1"/>
    <P Name="Position">[-65, 499, 240, 591]</P>
    <P Name="ZOrder">1468</P>
    <P Name="BackgroundColor">[1.000000, 0.666667, 0.000000]</P>
    <P Name="LibraryVersion">*0.33</P>
    <P Name="ContentPreviewEnabled">on</P>
    <Mask SelfModifiable="on">
      <Type>Generic Signal diagnostic block</Type>
      <Display RunInitForIconRedraw="on" IconUnits="pixels">fprintf(&apos;%s\nSPN: %d&apos;,...
    signalName,spn);

port_label(&apos;input&apos;, 1, &apos;Reset&apos;);
port_label(&apos;input&apos;, 2, &apos;RAW signal&apos;);
port_label(&apos;input&apos;, 3, &apos;Physical signal&apos;);

text(2, 6, GOcontroll_Simulink_version());
</Display>
      <Description>This block executes diagnostics on a signal that goes into the block. Both sensor voltage and signal thersholds are checked.

It must be enabled via the enable input at the top to function, this can be a easy way to toggle diagnostics on or off.

To use this block, error and warning limits should be defined in the workspace. Several pre- and suffixes are needed to work with this block. For example:

Base signal name is: Coolant_Pt1 (this will be the signal name in the mask)

- Coolant_Pt1_RAW_ERR_LOW (low voltage error)
- Coolant_Pt1_RAW_ERR_HIGH (high voltage error)
- Coolant_Pt1_SIG_WAR_LOW (Low warning signal threshold)
- Coolant_Pt1_SIG_WAR_HIGH (High warning signal threshold)
- Coolant_Pt1_SIG_ERR_LOW (Low error signal threshold)
- Coolant_Pt1 _SIG_ERR_HIGH (High error signal threshold)

Setting Diagnostic Trouble Code (DTC) in memory:

Configure the SPN number corresponding to the signal in the workspace parameters as:
Coolant_Pt1_SPN

Output provide two uint8 signals in a bus holding the volatile and permanent fault flags.

</Description>
      <Help>&lt;html&gt;&lt;body style=&quot;font-family:sans-serif&quot;&gt;&lt;h2&gt;Generic Signal diagnostic block&lt;/h2&gt;&lt;p&gt;A ready-made check of a sensor signal: it stores a diagnostic code when the raw voltage or the converted signal leaves its limits.&lt;/p&gt;&lt;h3&gt;How to use it&lt;/h3&gt;&lt;ul&gt;&lt;li&gt;The limits come from workspace variables named after the signal: &lt;i&gt;name&lt;/i&gt;_RAW_ERR_LOW/HIGH, &lt;i&gt;name&lt;/i&gt;_SIG_WAR_LOW/HIGH, &lt;i&gt;name&lt;/i&gt;_SIG_ERR_LOW/HIGH and &lt;i&gt;name&lt;/i&gt;_SPN.&lt;/li&gt;&lt;li&gt;Define these variables in the start-up script of the model before you build.&lt;/li&gt;&lt;/ul&gt;&lt;h3&gt;Controllers&lt;/h3&gt;&lt;p&gt;All controllers: Moduline S1, M1, L4 and HMI1. The greyed-out field &lt;i&gt;Controller type&lt;/i&gt;, when the block has one, shows the controller chosen under &lt;i&gt;Configuration Parameters &amp;gt; Code Generation &amp;gt; GOcontroll options &amp;gt; Target&lt;/i&gt;; the choices in the block follow it.&lt;/p&gt;&lt;h3&gt;GOcontroll knowledge base&lt;/h3&gt;&lt;ul&gt;&lt;li&gt;&lt;a href=&quot;https://gocontroll.com/knowledge-base/getting-started/programming/simulink/faults/&quot;&gt;Diagnostic codes (Faults)&lt;/a&gt;&lt;br&gt;https://gocontroll.com/knowledge-base/getting-started/programming/simulink/faults/&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;https://gocontroll.com/knowledge-base/getting-started/programming/simulink/blockset-information/&quot;&gt;Using the blockset&lt;/a&gt;&lt;br&gt;https://gocontroll.com/knowledge-base/getting-started/programming/simulink/blockset-information/&lt;/li&gt;&lt;/ul&gt;&lt;/body&gt;&lt;/html&gt;</Help>
      <MaskParameter Name="delay" Type="edit">
        <Prompt>Start delay [ms]</Prompt>
        <Value>1000</Value>
      </MaskParameter>
      <MaskParameter Name="duration" Type="edit">
        <Prompt>Fault duration [ms]</Prompt>
        <Value>1000</Value>
      </MaskParameter>
      <MaskParameter Name="signalName" Type="edit" Evaluate="off">
        <Prompt>Signal name:</Prompt>
        <Value>signal_x</Value>
        <Callback>
set_param(gcb, &apos;MaskSelfModifiable&apos;, &apos;on&apos;);

S = get_param(gcb,&quot;signalName&quot;);
set_param(gcb + &quot;/LowVoltage&quot;,&apos;const&apos;, S + &quot;_RAW_ERR_LOW&quot;);
set_param(gcb + &quot;/HighVoltage&quot;,&apos;const&apos;, S + &quot;_RAW_ERR_HIGH&quot;);
set_param(gcb + &quot;/LowWarning&quot;,&apos;const&apos;, S + &quot;_SIG_WAR_LOW&quot;);
set_param(gcb + &quot;/HighWarning&quot;,&apos;const&apos;, S + &quot;_SIG_WAR_HIGH&quot;);
set_param(gcb + &quot;/LowError&quot;,&apos;const&apos;, S + &quot;_SIG_ERR_LOW&quot;);
set_param(gcb + &quot;/HighError&quot;,&apos;const&apos;, S + &quot;_SIG_ERR_HIGH&quot;);

set_param(gcb,&apos;spn&apos;, S + &quot;_SPN&quot;);

% Set signal naming
P = get_param(gcb + &quot;/Per&quot;,&apos;PortHandles&apos;);
PerSubOut = P.Outport(1);
l1 = get_param(PerSubOut,&apos;Line&apos;);
set_param(l1,&apos;Name&apos;,&quot;Per_&quot; + S);

V = get_param(gcb + &quot;/Vol&quot;,&apos;PortHandles&apos;);
VolSubOut = V.Outport(1);
l1 = get_param(VolSubOut,&apos;Line&apos;);
set_param(l1,&apos;Name&apos;,&quot;Vol_&quot; + S);

try
    O = get_param(gcb,&apos;PortHandles&apos;);
    PortOut = O.Outport(1);
    l1 = get_param(PortOut,&apos;Line&apos;);
    set_param(l1,&apos;Name&apos;,S);
end</Callback>
        <Alias>signal_x</Alias>
      </MaskParameter>
      <MaskParameter Name="spn" Type="edit" Internal="on" Visible="off">
        <Prompt>SPN:</Prompt>
        <Value>signal_x_SPN</Value>
      </MaskParameter>
      <DialogControl Type="Group" Name="DescGroupVar">
        <Prompt>%&lt;MaskType&gt;</Prompt>
        <DialogControl Type="Text" Name="DescTextVar">
          <Prompt>%&lt;MaskDescription&gt;</Prompt>
        </DialogControl>
      </DialogControl>
      <DialogControl Type="Group" Name="ParameterGroupVar">
        <Prompt>Diagnostic parameters</Prompt>
        <DialogControl Type="Edit" Name="delay">
          <Prompt>Start delay [ms]</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="Edit" Name="duration">
          <Prompt>Fault duration [ms]</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="Edit" Name="signalName">
          <Prompt>Signal name:</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="Edit" Name="spn">
          <Prompt>SPN:</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
      </DialogControl>
    </Mask>
    <PortProperties>
      <Port Type="out" Index="1">
        <P Name="Name">Cs1Pt10</P>
      </Port>
    </PortProperties>
    <System Ref="system_4342"/>
  </Block>
</System>

