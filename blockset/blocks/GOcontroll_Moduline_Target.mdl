__MWOPC_PART_BEGIN__ /simulink/systems/system_3909.xml
<?xml version="1.0" encoding="utf-8"?>
<System>
  <P Name="Location">[1869, 738, 3003, 1725]</P>
  <P Name="PaperType">usletter</P>
  <P Name="ZoomFactor">125</P>
  <Block BlockType="M-S-Function" Name="JSON Constructor" SID="4400">
    <PortCounts in="2" out="2"/>
    <P Name="Position">[330, 562, 485, 638]</P>
    <P Name="ZOrder">479</P>
    <P Name="BackgroundColor">[1.000000, 0.666667, 0.000000]</P>
    <List ListType="RTWdata">
      <P Name="num_signals">2</P>
      <P Name="buf_size">256</P>
      <P Name="key_0">signal1</P>
      <P Name="key_1">signal2</P>
      <P Name="key_2">unused</P>
      <P Name="key_3">unused</P>
      <P Name="key_4">unused</P>
      <P Name="key_5">unused</P>
      <P Name="key_6">unused</P>
      <P Name="key_7">unused</P>
    </List>
    <P Name="CopyFcn">go_block_platform_check(gcb, &apos;STM&apos;, &apos;notify&apos;);</P>
    <P Name="FunctionName">sfcn_json_constructor</P>
    <P Name="Parameters">num_signals, tsamp, buf_size</P>
    <Mask SelfModifiable="on">
      <Type>JSON Constructor</Type>
      <Display RunInitForIconRedraw="on" IconUnits="pixels">fprintf(&quot;JSON constructor&quot;);
n = num_signals;
for i = 1:n
    kname = eval([&apos;key_&apos; num2str(i)]);
    port_label(&apos;input&apos;, i, kname);
end
port_label(&apos;output&apos;, 1, &apos;JSON&apos;);
port_label(&apos;output&apos;, 2, &apos;Len&apos;);
text(2, 6, GOcontroll_Simulink_version());</Display>
      <Description>&lt;p&gt;&lt;b&gt;JSON Constructor&lt;/b&gt;&lt;/p&gt;

&lt;p&gt;
Builds a JSON object string from N scalar input signals.
The resulting byte array is suitable for connecting directly to the
&lt;b&gt;MQTT Publish&lt;/b&gt; payload input.
Moduline S1 target only.
&lt;/p&gt;

&lt;p&gt;&lt;b&gt;Input ports&lt;/b&gt;&lt;/p&gt;

&lt;p&gt;
One port per configured signal (1–8).
Each port accepts any scalar datatype (float, double, int8…int32, uint8…uint32).
The port label shows the configured JSON key name.
&lt;/p&gt;

&lt;p&gt;&lt;b&gt;Output ports&lt;/b&gt;&lt;/p&gt;

&lt;p&gt;
&lt;b&gt;JSON&lt;/b&gt; — uint8 array of length &lt;i&gt;Buffer size&lt;/i&gt;.
Contains the raw JSON bytes, e.g. &lt;tt&gt;{&quot;temp&quot;:23.4,&quot;druk&quot;:230}&lt;/tt&gt;.
Connect to the &lt;b&gt;MQTT Publish&lt;/b&gt; payload input.&lt;br/&gt;
&lt;b&gt;Len&lt;/b&gt; — uint16 scalar.
Actual byte count of the JSON string (excluding null terminator).
Connect to the &lt;b&gt;MQTT Publish&lt;/b&gt; length input (if available).
&lt;/p&gt;

&lt;p&gt;&lt;b&gt;Parameters&lt;/b&gt;&lt;/p&gt;

&lt;p&gt;
&lt;b&gt;Number of signals&lt;/b&gt; — integer 1–8; sets the number of input ports and JSON fields.&lt;br/&gt;
&lt;b&gt;Key 1 … Key N&lt;/b&gt; — JSON key name for each input signal.
Only the first &lt;i&gt;Number of signals&lt;/i&gt; keys are used.&lt;br/&gt;
&lt;b&gt;Sample time&lt;/b&gt; — model sample time in seconds.&lt;br/&gt;
&lt;b&gt;Buffer size (bytes)&lt;/b&gt; — size of the output byte array.
Must be larger than the longest possible JSON string.
Default: 256.
&lt;/p&gt;&lt;p&gt;&lt;b&gt;For the Moduline S1 only.&lt;/b&gt;&lt;/p&gt;</Description>
      <Initialization>go_block_platform_check(gcb, &apos;STM&apos;);
mdl = bdroot;
cs  = getActiveConfigSet(mdl);
try
t = go_target_name(get_param(cs, &apos;tlcGOcontrollTarget&apos;));
catch
t = &quot;Unknown controller&quot;;
end
msk = Simulink.Mask.get(gcb);
c = msk.getParameter(&apos;ContrType&apos;);
c.Value = t;

%% Validate parameters
n = round(num_signals);
if n &lt; 1 || n &gt; 8
    error(&apos;JSON Constructor: Number of signals must be between 1 and 8.&apos;);
end
if buf_size &lt; 32
    error(&apos;JSON Constructor: Buffer size must be at least 32 bytes.&apos;);
end

%% Show/hide key parameters based on number of keys
for i = 1:8
    p = msk.getParameter([&apos;key_&apos; num2str(i)]);
    if i &lt;= n
        p.Visible = &apos;on&apos;;
    else
        p.Visible = &apos;off&apos;;
    end
end

%% Build RTWdata — keys are 0-indexed for TLC %foreach
fields = struct(&apos;num_signals&apos;, num2str(n), &apos;buf_size&apos;, num2str(buf_size));
for i = 1:n
    key_var = [&apos;key_&apos; num2str(i)];
    key_val = strtrim(eval(key_var));
    if isempty(key_val)
        key_val = [&apos;signal&apos; num2str(i)];
    end
    fields.([&apos;key_&apos; num2str(i - 1)]) = key_val;
end

%% Pad unused key fields so RTWdata always has key_0..key_7
for i = n:7
    fields.([&apos;key_&apos; num2str(i)]) = &apos;unused&apos;;
end

set_param(gcb, &apos;RTWdata&apos;, fields);</Initialization>
      <Help>&lt;html&gt;&lt;body style=&quot;font-family:sans-serif&quot;&gt;&lt;h2&gt;JSON Constructor&lt;/h2&gt;&lt;p&gt;Builds a JSON text from 1 to 8 values, to publish with &lt;i&gt;MQTT Publish&lt;/i&gt;.&lt;/p&gt;&lt;h3&gt;How to use it&lt;/h3&gt;&lt;ul&gt;&lt;li&gt;Each input has a &lt;b&gt;key&lt;/b&gt;: the name of the value in the JSON text.&lt;/li&gt;&lt;li&gt;Outputs: the text and its length. Connect both to &lt;i&gt;MQTT Publish&lt;/i&gt; and set its &lt;i&gt;Payload length&lt;/i&gt; to &lt;i&gt;From port&lt;/i&gt;.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Buffer size&lt;/b&gt; must be larger than the longest text (default 256).&lt;/li&gt;&lt;/ul&gt;&lt;h3&gt;Controllers&lt;/h3&gt;&lt;p&gt;Moduline S1 only. In a model for a Linux controller (Moduline M1, L4, HMI1) the block gives an error. The greyed-out field &lt;i&gt;Controller type&lt;/i&gt;, when the block has one, shows the controller chosen under &lt;i&gt;Configuration Parameters &amp;gt; Code Generation &amp;gt; GOcontroll options &amp;gt; Target&lt;/i&gt;; the choices in the block follow it.&lt;/p&gt;&lt;h3&gt;GOcontroll knowledge base&lt;/h3&gt;&lt;ul&gt;&lt;li&gt;&lt;a href=&quot;https://gocontroll.com/knowledge-base/getting-started/programming/simulink/blockset-information/&quot;&gt;Using the blockset&lt;/a&gt;&lt;br&gt;https://gocontroll.com/knowledge-base/getting-started/programming/simulink/blockset-information/&lt;/li&gt;&lt;/ul&gt;&lt;/body&gt;&lt;/html&gt;</Help>
      <MaskParameter Name="ContrType" Type="edit" Evaluate="off" Enabled="off">
        <Prompt>Controller type</Prompt>
        <Value>Unknown controller</Value>
      </MaskParameter>
      <MaskParameter Name="num_signals" Type="edit">
        <Prompt>Number of signals (1-8)</Prompt>
        <Value>2</Value>
      </MaskParameter>
      <MaskParameter Name="key_1" Type="edit" Evaluate="off">
        <Prompt>Key 1</Prompt>
        <Value>signal1</Value>
      </MaskParameter>
      <MaskParameter Name="key_2" Type="edit" Evaluate="off">
        <Prompt>Key 2</Prompt>
        <Value>signal2</Value>
      </MaskParameter>
      <MaskParameter Name="key_3" Type="edit" Evaluate="off" Visible="off">
        <Prompt>Key 3</Prompt>
        <Value>signal3</Value>
      </MaskParameter>
      <MaskParameter Name="key_4" Type="edit" Evaluate="off" Visible="off">
        <Prompt>Key 4</Prompt>
        <Value>signal4</Value>
      </MaskParameter>
      <MaskParameter Name="key_5" Type="edit" Evaluate="off" Visible="off">
        <Prompt>Key 5</Prompt>
        <Value>signal5</Value>
      </MaskParameter>
      <MaskParameter Name="key_6" Type="edit" Evaluate="off" Visible="off">
        <Prompt>Key 6</Prompt>
        <Value>signal6</Value>
      </MaskParameter>
      <MaskParameter Name="key_7" Type="edit" Evaluate="off" Visible="off">
        <Prompt>Key 7</Prompt>
        <Value>signal7</Value>
      </MaskParameter>
      <MaskParameter Name="key_8" Type="edit" Evaluate="off" Visible="off">
        <Prompt>Key 8</Prompt>
        <Value>signal8</Value>
      </MaskParameter>
      <MaskParameter Name="tsamp" Type="edit">
        <Prompt>Sample time</Prompt>
        <Value>1</Value>
      </MaskParameter>
      <MaskParameter Name="buf_size" Type="edit">
        <Prompt>Buffer size (bytes)</Prompt>
        <Value>256</Value>
      </MaskParameter>
      <DialogControl Type="Group" Name="DescGroupVar">
        <Prompt>%&lt;MaskType&gt;</Prompt>
        <DialogControl Type="Text" Name="DescTextVar">
          <Prompt>%&lt;MaskDescription&gt;</Prompt>
        </DialogControl>
      </DialogControl>
      <DialogControl Type="Group" Name="ParameterGroupVar">
        <Prompt>Parameters</Prompt>
        <DialogControl Type="Edit" Name="ContrType">
          <Prompt>Controller type</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="Edit" Name="num_signals">
          <Prompt>Number of signals (1-8)</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="Edit" Name="key_1">
          <Prompt>Key 1</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="Edit" Name="key_2">
          <Prompt>Key 2</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="Edit" Name="key_3">
          <Prompt>Key 3</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="Edit" Name="key_4">
          <Prompt>Key 4</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="Edit" Name="key_5">
          <Prompt>Key 5</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="Edit" Name="key_6">
          <Prompt>Key 6</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="Edit" Name="key_7">
          <Prompt>Key 7</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="Edit" Name="key_8">
          <Prompt>Key 8</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="Edit" Name="tsamp">
          <Prompt>Sample time</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="Edit" Name="buf_size">
          <Prompt>Buffer size (bytes)</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
      </DialogControl>
    </Mask>
  </Block>
  <Block BlockType="M-S-Function" Name="JSON Parser" SID="4402">
    <PortCounts in="3" out="2"/>
    <P Name="Position">[330, 672, 485, 748]</P>
    <P Name="ZOrder">480</P>
    <P Name="BackgroundColor">[1.000000, 0.666667, 0.000000]</P>
    <List ListType="RTWdata">
      <P Name="num_signals">2</P>
      <P Name="buf_size">256</P>
      <P Name="key_0">signal1</P>
      <P Name="key_1">signal2</P>
      <P Name="key_2">unused</P>
      <P Name="key_3">unused</P>
      <P Name="key_4">unused</P>
      <P Name="key_5">unused</P>
      <P Name="key_6">unused</P>
      <P Name="key_7">unused</P>
    </List>
    <P Name="CopyFcn">go_block_platform_check(gcb, &apos;STM&apos;, &apos;notify&apos;);</P>
    <P Name="FunctionName">sfcn_json_parser</P>
    <P Name="Parameters">num_signals, tsamp, buf_size</P>
    <Mask SelfModifiable="on">
      <Type>JSON Parser</Type>
      <Display RunInitForIconRedraw="on" IconUnits="pixels">fprintf(&quot;JSON parser&quot;);
port_label(&apos;input&apos;, 1, &apos;new&apos;);
port_label(&apos;input&apos;, 2, &apos;len&apos;);
port_label(&apos;input&apos;, 3, &apos;payload&apos;);
n = num_signals;
for i = 1:n
    kname = eval([&apos;key_&apos; num2str(i)]);
    port_label(&apos;output&apos;, i, kname);
end
text(2, 6, GOcontroll_Simulink_version());</Display>
      <Description>&lt;p&gt;&lt;b&gt;JSON Parser&lt;/b&gt;&lt;/p&gt;

&lt;p&gt;
Parses an incoming JSON object string received from an &lt;b&gt;MQTT Subscribe&lt;/b&gt; block
and outputs the numeric value for each configured key as a separate port.
Moduline S1 target only.
&lt;/p&gt;

&lt;p&gt;&lt;b&gt;Input ports&lt;/b&gt;&lt;/p&gt;

&lt;p&gt;
&lt;b&gt;new&lt;/b&gt; — uint8 scalar. New-data flag from MQTT Subscribe output 1.
Parsing only occurs when this is 1.&lt;br/&gt;
&lt;b&gt;len&lt;/b&gt; — uint16 scalar. Payload length from MQTT Subscribe output 2.&lt;br/&gt;
&lt;b&gt;payload&lt;/b&gt; — uint8 array. Payload bytes from MQTT Subscribe output 3.
&lt;/p&gt;

&lt;p&gt;&lt;b&gt;Output ports&lt;/b&gt;&lt;/p&gt;

&lt;p&gt;
One &lt;b&gt;real_T&lt;/b&gt; (double) scalar per configured key.
The port label shows the key name.
If a key is absent from the incoming JSON message the output retains its previous value.
&lt;/p&gt;

&lt;p&gt;&lt;b&gt;Parameters&lt;/b&gt;&lt;/p&gt;

&lt;p&gt;
&lt;b&gt;Number of keys&lt;/b&gt; — integer 1–8; sets the number of output ports and JSON keys to search for.&lt;br/&gt;
&lt;b&gt;Key 1 … Key N&lt;/b&gt; — JSON key name to extract from the incoming message.
Only the first &lt;i&gt;Number of keys&lt;/i&gt; fields are used.&lt;br/&gt;
&lt;b&gt;Sample time&lt;/b&gt; — model sample time in seconds.&lt;br/&gt;
&lt;b&gt;Buffer size (bytes)&lt;/b&gt; — internal parse buffer size.
Should match the payload_size of the connected MQTT Subscribe block.
Default: 256.
&lt;/p&gt;&lt;p&gt;&lt;b&gt;For the Moduline S1 only.&lt;/b&gt;&lt;/p&gt;</Description>
      <Initialization>go_block_platform_check(gcb, &apos;STM&apos;);
mdl = bdroot;
cs  = getActiveConfigSet(mdl);
try
t = go_target_name(get_param(cs, &apos;tlcGOcontrollTarget&apos;));
catch
t = &quot;Unknown controller&quot;;
end
msk = Simulink.Mask.get(gcb);
c = msk.getParameter(&apos;ContrType&apos;);
c.Value = t;

%% Validate parameters
n = round(num_signals);
if n &lt; 1 || n &gt; 8
    error(&apos;JSON Parser: Number of keys must be between 1 and 8.&apos;);
end
if buf_size &lt; 32
    error(&apos;JSON Parser: Buffer size must be at least 32 bytes.&apos;);
end

%% Show/hide key parameters based on number of keys
for i = 1:8
    p = msk.getParameter([&apos;key_&apos; num2str(i)]);
    if i &lt;= n
        p.Visible = &apos;on&apos;;
    else
        p.Visible = &apos;off&apos;;
    end
end

%% Build RTWdata — keys are 0-indexed for TLC %foreach
fields = struct(&apos;num_signals&apos;, num2str(n), &apos;buf_size&apos;, num2str(buf_size));
for i = 1:n
    key_var = [&apos;key_&apos; num2str(i)];
    key_val = strtrim(eval(key_var));
    if isempty(key_val)
        key_val = [&apos;signal&apos; num2str(i)];
    end
    fields.([&apos;key_&apos; num2str(i - 1)]) = key_val;
end

%% Pad unused key fields so RTWdata always has key_0..key_7
for i = n:7
    fields.([&apos;key_&apos; num2str(i)]) = &apos;unused&apos;;
end

set_param(gcb, &apos;RTWdata&apos;, fields);</Initialization>
      <Help>&lt;html&gt;&lt;body style=&quot;font-family:sans-serif&quot;&gt;&lt;h2&gt;JSON Parser&lt;/h2&gt;&lt;p&gt;Reads 1 to 8 values from a received JSON message.&lt;/p&gt;&lt;h3&gt;How to use it&lt;/h3&gt;&lt;ul&gt;&lt;li&gt;Connect the three outputs of &lt;i&gt;MQTT Subscribe&lt;/i&gt; to the inputs.&lt;/li&gt;&lt;li&gt;Each output has a &lt;b&gt;key&lt;/b&gt;: the name of the value in the JSON text. The outputs are of type double.&lt;/li&gt;&lt;li&gt;A key that is missing in a message keeps its previous value.&lt;/li&gt;&lt;/ul&gt;&lt;h3&gt;Controllers&lt;/h3&gt;&lt;p&gt;Moduline S1 only. In a model for a Linux controller (Moduline M1, L4, HMI1) the block gives an error. The greyed-out field &lt;i&gt;Controller type&lt;/i&gt;, when the block has one, shows the controller chosen under &lt;i&gt;Configuration Parameters &amp;gt; Code Generation &amp;gt; GOcontroll options &amp;gt; Target&lt;/i&gt;; the choices in the block follow it.&lt;/p&gt;&lt;h3&gt;GOcontroll knowledge base&lt;/h3&gt;&lt;ul&gt;&lt;li&gt;&lt;a href=&quot;https://gocontroll.com/knowledge-base/getting-started/programming/simulink/blockset-information/&quot;&gt;Using the blockset&lt;/a&gt;&lt;br&gt;https://gocontroll.com/knowledge-base/getting-started/programming/simulink/blockset-information/&lt;/li&gt;&lt;/ul&gt;&lt;/body&gt;&lt;/html&gt;</Help>
      <MaskParameter Name="ContrType" Type="edit" Evaluate="off" Enabled="off">
        <Prompt>Controller type</Prompt>
        <Value>Unknown controller</Value>
      </MaskParameter>
      <MaskParameter Name="num_signals" Type="edit">
        <Prompt>Number of signals (1-8)</Prompt>
        <Value>2</Value>
      </MaskParameter>
      <MaskParameter Name="key_1" Type="edit" Evaluate="off">
        <Prompt>Key 1</Prompt>
        <Value>signal1</Value>
      </MaskParameter>
      <MaskParameter Name="key_2" Type="edit" Evaluate="off">
        <Prompt>Key 2</Prompt>
        <Value>signal2</Value>
      </MaskParameter>
      <MaskParameter Name="key_3" Type="edit" Evaluate="off" Visible="off">
        <Prompt>Key 3</Prompt>
        <Value>signal3</Value>
      </MaskParameter>
      <MaskParameter Name="key_4" Type="edit" Evaluate="off" Visible="off">
        <Prompt>Key 4</Prompt>
        <Value>signal4</Value>
      </MaskParameter>
      <MaskParameter Name="key_5" Type="edit" Evaluate="off" Visible="off">
        <Prompt>Key 5</Prompt>
        <Value>signal5</Value>
      </MaskParameter>
      <MaskParameter Name="key_6" Type="edit" Evaluate="off" Visible="off">
        <Prompt>Key 6</Prompt>
        <Value>signal6</Value>
      </MaskParameter>
      <MaskParameter Name="key_7" Type="edit" Evaluate="off" Visible="off">
        <Prompt>Key 7</Prompt>
        <Value>signal7</Value>
      </MaskParameter>
      <MaskParameter Name="key_8" Type="edit" Evaluate="off" Visible="off">
        <Prompt>Key 8</Prompt>
        <Value>signal8</Value>
      </MaskParameter>
      <MaskParameter Name="tsamp" Type="edit">
        <Prompt>Sample time</Prompt>
        <Value>1</Value>
      </MaskParameter>
      <MaskParameter Name="buf_size" Type="edit">
        <Prompt>Buffer size (bytes)</Prompt>
        <Value>256</Value>
      </MaskParameter>
      <DialogControl Type="Group" Name="DescGroupVar">
        <Prompt>%&lt;MaskType&gt;</Prompt>
        <DialogControl Type="Text" Name="DescTextVar">
          <Prompt>%&lt;MaskDescription&gt;</Prompt>
        </DialogControl>
      </DialogControl>
      <DialogControl Type="Group" Name="ParameterGroupVar">
        <Prompt>Parameters</Prompt>
        <DialogControl Type="Edit" Name="ContrType">
          <Prompt>Controller type</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="Edit" Name="num_signals">
          <Prompt>Number of signals (1-8)</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="Edit" Name="key_1">
          <Prompt>Key 1</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="Edit" Name="key_2">
          <Prompt>Key 2</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="Edit" Name="key_3">
          <Prompt>Key 3</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="Edit" Name="key_4">
          <Prompt>Key 4</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="Edit" Name="key_5">
          <Prompt>Key 5</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="Edit" Name="key_6">
          <Prompt>Key 6</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="Edit" Name="key_7">
          <Prompt>Key 7</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="Edit" Name="key_8">
