            </DialogControl>
            <DialogControl Type="Popup" Name="C10pu">
              <Prompt>Pull up on input</Prompt>
              <ControlOptions PromptLocation="left"/>
            </DialogControl>
            <DialogControl Type="Popup" Name="C10pd">
