        <Value>0</Value>
      </MaskParameter>
      <MaskParameter Name="C5dpul" Type="edit">
        <Prompt>Pulses per rotation (1-200)</Prompt>
        <Value>1</Value>
      </MaskParameter>
      <MaskParameter Name="C5pu" Type="popup">
        <Prompt>Pull up on input</Prompt>
