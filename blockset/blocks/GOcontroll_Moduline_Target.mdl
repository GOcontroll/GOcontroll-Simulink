    </Mask>
  </Block>
  <Block BlockType="M-S-Function" Name="Input Module (6 channel)" SID="4108">
    <PortCounts out="6"/>
    <P Name="Position">[205, 92, 390, 183]</P>
    <P Name="ZOrder">7</P>
    <P Name="BackgroundColor">[1.000000, 0.666667, 0.000000]</P>
    <List ListType="RTWdata">
      <P Name="moduleSlot">1</P>
      <P Name="C1func">1</P>
      <P Name="C1volt">1</P>
      <P Name="C1afil">0</P>
      <P Name="C1dpul">1</P>
      <P Name="C1pu">1</P>
      <P Name="C1pd">1</P>
      <P Name="C2func">1</P>
      <P Name="C2volt">1</P>
      <P Name="C2afil">0</P>
      <P Name="C2dpul">1</P>
      <P Name="C2pu">1</P>
      <P Name="C2pd">1</P>
      <P Name="C3func">1</P>
      <P Name="C3volt">1</P>
      <P Name="C3afil">0</P>
      <P Name="C3dpul">1</P>
      <P Name="C3pu">1</P>
      <P Name="C3pd">1</P>
      <P Name="C4func">1</P>
      <P Name="C4volt">1</P>
      <P Name="C4afil">0</P>
      <P Name="C4dpul">1</P>
      <P Name="C4pu">1</P>
      <P Name="C4pd">1</P>
      <P Name="C5func">1</P>
      <P Name="C5volt">1</P>
      <P Name="C5afil">0</P>
      <P Name="C5dpul">1</P>
      <P Name="C5pu">1</P>
      <P Name="C5pd">1</P>
      <P Name="C6func">1</P>
      <P Name="C6volt">1</P>
      <P Name="C6afil">0</P>
      <P Name="C6dpul">1</P>
      <P Name="C6pu">1</P>
      <P Name="C6pd">1</P>
      <P Name="SensSup1">1</P>
      <P Name="SensSup2">1</P>
      <P Name="SensSup3">1</P>
    </List>
    <P Name="FunctionName">sfcn_gocontroll_input_module</P>
    <P Name="Parameters">tsamp</P>
    <Mask SelfModifiable="on">
      <Type>Input Module</Type>
      <Display RunInitForIconRedraw="on" IconUnits="pixels">fprintf(&apos;6 Channel Input Module \n%s\n\n Controller Connector: %s&apos;, moduleSlotInfoStr,connectorId);
port_label(&apos;output&apos;, 1, pin1Id);
port_label(&apos;output&apos;, 2, pin2Id);
port_label(&apos;output&apos;, 3, pin3Id);
port_label(&apos;output&apos;, 4, pin4Id);
port_label(&apos;output&apos;, 5, pin5Id);
port_label(&apos;output&apos;, 6, pin6Id);
text(2, 6, GOcontroll_Simulink_version());</Display>
      <Description>With this function block, you can configure each channel of the 6 channel input module (201001xx). The configuration of the module is set once at initialization. During runtime, the block outputs the measured values from each channel.

Module location:
Sets the location of the module slot where the module is physically 
plugged into.

Channel tabs:
Each channel has its own configuration tab.

Function select:
Select the desired input signal configuration.

Voltage range:
Select the expected input range of the signal.

Analog filter samples:
The number of samples that are passed into a moving average filter. 
(only active in case of an analog input)

Pulses per rotation
The number of pulses for one rotation. This parameter is needed in case the
module needs to calculate the rotation speed from i.e. an axle.

Pull Up:
If required, a pull-up resistance can be added to the input signal.

Pull Down:
If required, a pull-down resistance can be added to the input signal.</Description>
      <Initialization>% Mirror the model target into Controller type and limit the slots to that controller
t = go_module_slot_setup(gcb);
    
    if (contains(t,&apos;Moduline S1&apos;) || contains(t,&apos;Moduline HMI1&apos;))
        moduleSlotInfoStrings = {  	&apos;Module slot 1&apos;,  ...\
								    &apos;Module slot 2&apos;};
    elseif contains(t,&apos;Moduline M1&apos;)
        moduleSlotInfoStrings = {  	&apos;Module slot 1&apos;,  ...\
								    &apos;Module slot 2&apos;,  ...\
								    &apos;Module slot 3&apos;,  ...\
								    &apos;Module slot 4&apos;};
    else
        moduleSlotInfoStrings = {  	&apos;Module slot 1&apos;,  ...\
								    &apos;Module slot 2&apos;,  ...\
								    &apos;Module slot 3&apos;,  ...\
								    &apos;Module slot 4&apos;,  ...\
								    &apos;Module slot 5&apos;,  ...\
								    &apos;Module slot 6&apos;,  ...\
								    &apos;Module slot 7&apos;,  ...\
								    &apos;Module slot 8&apos;};
    end

  % construct the module slot info string
  moduleSlotInfoStr = moduleSlotInfoStrings{moduleSlot};

    if(moduleSlot == 1 || moduleSlot == 2)
	    connectorId = &apos;A&apos;;
    elseif(moduleSlot == 3 || moduleSlot == 4)
	    connectorId = &apos;B&apos;;
    elseif(moduleSlot == 5 || moduleSlot == 6)
	    connectorId = &apos;D&apos;;
    else
	    connectorId = &apos;E&apos;;
    end
    
    
    if (contains(t,&apos;Moduline L4&apos;))
	    if(moduleSlot == 1 || moduleSlot == 3 || moduleSlot == 5 || moduleSlot == 7)
		    pin1Id = &apos;Pin 13&apos;;
		    pin2Id = &apos;Pin 19&apos;;
		    pin3Id = &apos;Pin 12&apos;;
		    pin4Id = &apos;Pin 18&apos;;
		    pin5Id = &apos;Pin 11&apos;;
		    pin6Id = &apos;Pin 17&apos;;
	    else
		    pin1Id = &apos;Pin 8&apos;;
		    pin2Id = &apos;Pin 14&apos;;
		    pin3Id = &apos;Pin 9&apos;;
		    pin4Id = &apos;Pin 15&apos;;
		    pin5Id = &apos;Pin 10&apos;;
		    pin6Id = &apos;Pin 16&apos;;
	    end
    else
	    if(moduleSlot == 1 || moduleSlot == 3)
		    pin1Id = &apos;Pin 15&apos;;
		    pin2Id = &apos;Pin 23&apos;;
		    pin3Id = &apos;Pin 14&apos;;
		    pin4Id = &apos;Pin 22&apos;;
		    pin5Id = &apos;Pin 13&apos;;
		    pin6Id = &apos;Pin 21&apos;;
	    else
		    pin1Id = &apos;Pin 10&apos;;
		    pin2Id = &apos;Pin 18&apos;;
		    pin3Id = &apos;Pin 11&apos;;
		    pin4Id = &apos;Pin 19&apos;;
		    pin5Id = &apos;Pin 12&apos;;
		    pin6Id = &apos;Pin 20&apos;;
	    end
    end
    
    % Update RTWdata
    modelRTWFields = struct(&apos;moduleSlot&apos;, int2str(moduleSlot),	&apos;C1func&apos;, int2str(C1func),&apos;C1volt&apos;, int2str(C1volt), &apos;C1afil&apos;, int2str(C1afil),&apos;C1dpul&apos;, int2str(C1dpul),&apos;C1pu&apos;, int2str(C1pu),&apos;C1pd&apos;, int2str(C1pd),...
															    &apos;C2func&apos;, int2str(C2func),&apos;C2volt&apos;, int2str(C2volt), &apos;C2afil&apos;, int2str(C2afil),&apos;C2dpul&apos;, int2str(C2dpul),&apos;C2pu&apos;, int2str(C2pu),&apos;C2pd&apos;, int2str(C2pd),...
															    &apos;C3func&apos;, int2str(C3func),&apos;C3volt&apos;, int2str(C3volt), &apos;C3afil&apos;, int2str(C3afil),&apos;C3dpul&apos;, int2str(C3dpul),&apos;C3pu&apos;, int2str(C3pu),&apos;C3pd&apos;, int2str(C3pd),...
															    &apos;C4func&apos;, int2str(C4func),&apos;C4volt&apos;, int2str(C4volt), &apos;C4afil&apos;, int2str(C4afil),&apos;C4dpul&apos;, int2str(C4dpul),&apos;C4pu&apos;, int2str(C4pu),&apos;C4pd&apos;, int2str(C4pd),...
															    &apos;C5func&apos;, int2str(C5func),&apos;C5volt&apos;, int2str(C5volt), &apos;C5afil&apos;, int2str(C5afil),&apos;C5dpul&apos;, int2str(C5dpul),&apos;C5pu&apos;, int2str(C5pu),&apos;C5pd&apos;, int2str(C5pd),...
															    &apos;C6func&apos;, int2str(C6func),&apos;C6volt&apos;, int2str(C6volt), &apos;C6afil&apos;, int2str(C6afil),&apos;C6dpul&apos;, int2str(C6dpul),&apos;C6pu&apos;, int2str(C6pu),&apos;C6pd&apos;, int2str(C6pd),...
															    &apos;SensSup1&apos;, int2str(SensSup1),&apos;SensSup2&apos;, int2str(SensSup2), &apos;SensSup3&apos;, int2str(SensSup3));

    set_param(gcb, &apos;RTWdata&apos;, modelRTWFields);</Initialization>
      <Help>&lt;html&gt;&lt;body style=&quot;font-family:sans-serif&quot;&gt;&lt;h2&gt;Input Module&lt;/h2&gt;&lt;p&gt;Reads the six inputs of a 6 Channel Input Module. Each output of the block is one input of the module.&lt;/p&gt;&lt;h3&gt;How to use it&lt;/h3&gt;&lt;ul&gt;&lt;li&gt;&lt;b&gt;Module slot&lt;/b&gt;: the slot the module is fitted in. The list follows the controller: 2 slots on the Moduline S1 and HMI1, 4 on the M1, 8 on the L4. The block icon shows the connector pins of that slot.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Sample time&lt;/b&gt;: how often the block exchanges values with the module. The module is configured once when the application starts.&lt;/li&gt;&lt;li&gt;Per channel choose the &lt;b&gt;function&lt;/b&gt;: analog input (as a 12 bit value or in mV), digital status, frequency (1 Hz to 10 kHz), duty cycle, low or high time, rotation speed (rpm) or pulse counter.&lt;/li&gt;&lt;li&gt;Per channel also: &lt;b&gt;voltage range&lt;/b&gt; (0-5 V, 0-10 V, 0-24 V), &lt;b&gt;analog filter samples&lt;/b&gt;, &lt;b&gt;pulses per rotation&lt;/b&gt;, and the &lt;b&gt;pull-up&lt;/b&gt; and &lt;b&gt;pull-down&lt;/b&gt; resistor.&lt;/li&gt;&lt;li&gt;The three &lt;b&gt;5 V sensor supplies&lt;/b&gt; of the module are switched on in this block.&lt;/li&gt;&lt;li&gt;Convert a raw value into a physical value after the block, for example with &lt;i&gt;Signal adaptation&lt;/i&gt; from the GOcontroll_Generic library.&lt;/li&gt;&lt;li&gt;Use one block per module. Do not drive the same module from Simulink and from Node-RED at the same time.&lt;/li&gt;&lt;/ul&gt;&lt;h3&gt;Controllers&lt;/h3&gt;&lt;p&gt;All controllers: Moduline S1, M1, L4 and HMI1. The greyed-out field &lt;i&gt;Controller type&lt;/i&gt;, when the block has one, shows the controller chosen under &lt;i&gt;Configuration Parameters &amp;gt; Code Generation &amp;gt; GOcontroll options &amp;gt; Target&lt;/i&gt;; the choices in the block follow it.&lt;/p&gt;&lt;h3&gt;GOcontroll knowledge base&lt;/h3&gt;&lt;ul&gt;&lt;li&gt;&lt;a href=&quot;https://gocontroll.com/knowledge-base/modular-hardware/modules/input-6ch/&quot;&gt;6 Channel Input Module&lt;/a&gt;&lt;br&gt;https://gocontroll.com/knowledge-base/modular-hardware/modules/input-6ch/&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;https://gocontroll.com/knowledge-base/configuration/gocontroll-services/go-modules/&quot;&gt;go-modules: module firmware&lt;/a&gt;&lt;br&gt;https://gocontroll.com/knowledge-base/configuration/gocontroll-services/go-modules/&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;https://gocontroll.com/knowledge-base/getting-started/programming/simulink/blockset-information/&quot;&gt;Using the blockset&lt;/a&gt;&lt;br&gt;https://gocontroll.com/knowledge-base/getting-started/programming/simulink/blockset-information/&lt;/li&gt;&lt;/ul&gt;&lt;/body&gt;&lt;/html&gt;</Help>
      <MaskParameter Name="ContrType" Type="edit" Evaluate="off" Tunable="off" Enabled="off">
        <Prompt>Controller type</Prompt>
        <Value>Unknown controller</Value>
      </MaskParameter>
      <MaskParameter Name="tsamp" Type="edit" Tunable="off">
        <Prompt>Sample time</Prompt>
        <Value>0.1</Value>
      </MaskParameter>
