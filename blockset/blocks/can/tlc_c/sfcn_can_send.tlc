%implements  sfcn_can_send "C"

%include "go_platform.tlc"
%include "can_common.tlc"

%% Function: BlockTypeSetup ==========================================================
%%
%% Purpose:
%%      Code generation for configuration
%%
%function BlockTypeSetup(block, system) void
	%assign platform = get_platform()
	%if ISEQUAL(platform, "Linux")
		%<LibAddToCommonIncludes("GO_communication_can.h")>
	%elseif ISEQUAL(platform, "STM")
		%if !SLibCodeGenForSim()
			%<LibAddToCommonIncludes("GO_communication_can.h")>
			%<LibAddToCommonIncludes("fdcan.h")>
		%endif
	%endif
%endfunction


%% Function: Start ==========================================================
%%
%% Purpose:
%%      Code generation for initialization
%%
%function Start(block, system) Output
	%assign platform = get_platform()
	%if ISEQUAL(platform, "Linux")
		GO_communication_can_socket(%<block.RTWdata.canBus>); /* Initialize CAN socket */
		%% get the can connection from GO_communication_can.c
		%if EXISTS("::canConnection") == 0
			%openfile tmpBuf
			extern _canConnection canConnection;
			%closefile tmpBuf

			%<LibSetSourceFileSection(LibGetModelDotCFile(), "UserTop", tmpBuf)>
			%assign ::canConnection = 1
		%endif
	%elseif ISEQUAL(platform, "STM")
		%% CAN init and start are owned by the CAN config block.
		%% No additional setup is required here for TX.
	%else
		%<LibBlockReportWarning(block, "This block is not implemented on this target")>
	%endif
%endfunction

%% Function: Update ==========================================================
%%
%% Purpose:
%%      Code generation for signal input
%%
%function Update(block, system) Output
	%assign platform = get_platform()
	%if ISEQUAL(platform, "Linux")
		{
			struct can_frame sendframe; /* Declare a frame to send */
			sendframe.can_id = %<LibBlockInputSignal(0, "", "", 0)>; /* Mask value for ID */

			%if(block.RTWdata.RTR)
				sendframe.can_id |= CAN_RTR_FLAG; /* Add RTR bit to identifier */
			%endif

			%if CAST("Number",block.RTWdata.frameType) == 2
				sendframe.can_id |= CAN_EFF_FLAG; /* Set CAN_EFF_FLAG for extended identifiers */
			%endif

			sendframe.can_dlc = %<block.RTWdata.dataLength>; /* Mask value for number of bytes */

			/* prepare the data */
			%foreach counter = block.RTWdata.dataLength
				sendframe.data[%<counter>] = %<LibBlockInputSignal(counter + 1, "", "", 0)>;
			%endforeach

			write(canConnection.socket[%<block.RTWdata.canBus>], &sendframe, sizeof(struct can_frame));	/* Send message */
		}
	%elseif ISEQUAL(platform, "STM")
		%assign canBusIdx = CAST("Number", block.RTWdata.canBus)
		%assign fdcanN    = canBusIdx + 1
		{
			FDCAN_TxHeaderTypeDef header = {0};
			header.Identifier          = (uint32_t)%<LibBlockInputSignal(0, "", "", 0)>;
			header.DataLength          = %<block.RTWdata.dataLength>;
			%if CAST("Number", block.RTWdata.frameType) == 2
			header.IdType              = FDCAN_EXTENDED_ID;
			%else
			header.IdType              = FDCAN_STANDARD_ID;
			%endif
			%if CAST("Number", block.RTWdata.RTR)
			header.TxFrameType         = FDCAN_REMOTE_FRAME;
			%else
			header.TxFrameType         = FDCAN_DATA_FRAME;
			%endif
			header.ErrorStateIndicator = FDCAN_ESI_ACTIVE;
			header.BitRateSwitch       = FDCAN_BRS_OFF;
			header.FDFormat            = FDCAN_CLASSIC_CAN;
			header.TxEventFifoControl  = FDCAN_NO_TX_EVENTS;
			header.MessageMarker       = 0;

			uint8_t txData[8] = {0};
			/* Copy input data bytes */
			%foreach counter = block.RTWdata.dataLength
				txData[%<counter>] = (uint8_t)%<LibBlockInputSignal(counter + 1, "", "", 0)>;
			%endforeach

			HAL_FDCAN_AddMessageToTxFifoQ(&hfdcan%<fdcanN>, &header, txData);
		}
	%endif
%endfunction


%%******************************* end of sfcn_can_send.tlc ******************************
