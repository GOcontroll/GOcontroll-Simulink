%implements  sfcn_gps "C"

%function BlockTypeSetup(block, system) void
	%<LibAddToCommonIncludes("pthread.h")>
	%<LibAddToCommonIncludes("gps.h")>
	%openfile variables
		pthread_t gps_thread;
		struct gps_data gps_data = {0};
		static pthread_mutex_t gps_data_lock = PTHREAD_MUTEX_INITIALIZER;
		struct gps_thread_args gps_thread_args = {&gps_data, &gps_data_lock, 1};
	%closefile variables
	%<LibSetSourceFileSection(LibGetModelDotCFile(), "Declarations", variables)>
%endfunction

%function BlockInstanceSetup(block, system) void
	%if EXISTS(::gps)
		%<LibBlockReportError(block, "Only one gps block can be in the model")>
	%else
		%assign ::gps = 1
	%endif
%endfunction

%% Function: Start ==========================================================
%%
%% Purpose:
%%      Code generation for initialization
%%
%function Start(block, system) Output
	pthread_create(&gps_thread, NULL, readGpsThread, &gps_thread_args);
%endfunction

%% Function: Outputs ==========================================================
%%
%% Purpose:
%%      Code generation for signal output
%%
%function Outputs(block, system) Output
	pthread_mutex_lock(&gps_data_lock);
	%<LibBlockOutputSignal(0, "", "", 0)> = gps_data.longitude;
	%<LibBlockOutputSignal(1, "", "", 0)> = gps_data.latitude;
	%<LibBlockOutputSignal(2, "", "", 0)> = gps_data.altitude;
	%<LibBlockOutputSignal(3, "", "", 0)> = gps_data.velocity;
	%<LibBlockOutputSignal(4, "", "", 0)> = gps_data.year;
	%<LibBlockOutputSignal(5, "", "", 0)> = gps_data.month;
	%<LibBlockOutputSignal(6, "", "", 0)> = gps_data.day;
	%<LibBlockOutputSignal(7, "", "", 0)> = gps_data.hour;
	%<LibBlockOutputSignal(8, "", "", 0)> = gps_data.minute;
	%<LibBlockOutputSignal(9, "", "", 0)> = gps_data.second;
	pthread_mutex_unlock(&gps_data_lock);
%endfunction

%function Terminate(block, system) Output
	gps_thread_args.thread_run = 0;
	pthread_join(gps_thread, NULL);
%endfunction

