%implements sfcn_gocontroll_rtc "C"

%% Function: BlockTypeSetup ==========================================================
%%
%% Purpose:
%%      Add the controller info header to the generated code includes.
%%
%function BlockTypeSetup(block, system) void
	%<LibAddToCommonIncludes("GO_controller_info.h")>
%endfunction

%% Function: BlockInstanceSetup ======================================================
%%
%% Purpose:
%%      Enforce that only one RTC block is present in the model.
%%
%function BlockInstanceSetup(block, system) void
	%if EXISTS(::rtc)
		%<LibBlockReportError(block, "Only one RTC block can be in the model")>
	%else
		%assign ::rtc = 1
	%endif
%endfunction

%% Function: Start ==========================================================
%%
%% Purpose:
%%      Code generation for initialization.
%%
%function Start(block, system) Output
	%openfile tmpBuf
	_rtcTime rtc_time;
	%closefile tmpBuf
	%assign srcFile = LibGetModelDotCFile()
	%<LibSetSourceFileSection(srcFile, "UserTop", tmpBuf)>
%endfunction

%% Function: Outputs ==========================================================
%%
%% Purpose:
%%      Code generation for signal output.
%%
%function Outputs(block, system) Output
	GO_controller_info_get_rtc_time(&rtc_time);
	%<LibBlockOutputSignal(0, "", "", 0)> = rtc_time.year;
	%<LibBlockOutputSignal(1, "", "", 0)> = rtc_time.month;
	%<LibBlockOutputSignal(2, "", "", 0)> = rtc_time.day;
	%<LibBlockOutputSignal(3, "", "", 0)> = rtc_time.hour;
	%<LibBlockOutputSignal(4, "", "", 0)> = rtc_time.minute;
	%<LibBlockOutputSignal(5, "", "", 0)> = rtc_time.second;
%endfunction

%%******************************* end of sfcn_gocontroll_rtc.tlc ***************************
