%%***************************************************************************************
%% file         sfcn_MQTT_publish.tlc
%% brief        Target Language Compiler file for the MQTT Publish block.
%%              STM target only (STM32H5 + ESP32 via EspInterface over UART).
%%
%%              Generated code (model Output):
%%                GO_communication_esp_mqtt_publish(topic, payload_ptr, payload_len, qos, retain)
%%
%%              Input port 0 (topic)  : cast to const char *, runtime-variable uint8 array.
%%              Input port 1 (payload): cast to const uint8_t *, size determined by length source.
%%              Input port 2 (length, optional): uint16 scalar with the actual byte count.
%%                When present (len_source = "1"): the port value is used as payload length.
%%                When absent  (len_source = "0"): sizeof(type)*width is used.
%%
%%              Note: requires the MQTT Broker block to be present in the model so
%%              that EspInterface_Init, GO_communication_esp_set_mqtt_config and
%%              GO_communication_esp_enable_mqtt are generated.
%%
%%              Mask RTWdata fields expected (set by the mask initialisation callback):
%%                qos    : QoS level - 0, 1 or 2
%%                retain : retain flag - 0 = no retain, 1 = broker retains for new subscribers
%%
%%---------------------------------------------------------------------------------------
%%                          C O P Y R I G H T
%%---------------------------------------------------------------------------------------
