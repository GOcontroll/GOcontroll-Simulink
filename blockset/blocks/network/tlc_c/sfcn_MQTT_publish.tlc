%% INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR
%% PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE
%% FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR
%% OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER
%% DEALINGS IN THE SOFTWARE.
%% endinternal
%%***************************************************************************************

%implements sfcn_MQTT_publish "C"

%include "go_platform.tlc"

%% Function: BlockTypeSetup ============================================================
%function BlockTypeSetup(block, system) void
	%assign platform = get_platform()
	%if ISEQUAL(platform, "STM")
		%<LibAddToCommonIncludes("GO_communication_esp.h")>
		%<LibAddToCommonIncludes("string.h")>
	%endif
%endfunction

%% Function: Outputs ===================================================================
%% Port 0: topic string   -> copied to a null-terminated local buffer before use.
%%         The Simulink signal is a raw uint8 array with no guaranteed null terminator.
%%         Concatenation bugs occur when string functions read past the end into
%%         adjacent signal memory. A local buffer with explicit null-termination prevents this.
%% Port 1: payload signal -> raw bytes
%function Outputs(block, system) Output
	%assign platform = get_platform()
	%if !ISEQUAL(platform, "STM")
		%<LibBlockReportError(block, "The MQTT Publish block is only supported on the Moduline S1 target.")>
	%endif

	%assign qos         = block.RTWdata.qos
	%assign retain      = block.RTWdata.retain
	%assign dtype       = LibBlockInputSignalDataTypeName(1, "")
	%assign width       = LibBlockInputSignalWidth(1)
	%assign topic_width = LibBlockInputSignalWidth(0)
	%if topic_width > 64
		%assign topic_width = 64
	%endif

    {
        char mqtt_pub_topic[65];
        memcpy(mqtt_pub_topic, %<LibBlockInputSignalAddr(0, "", "", 0)>, (size_t)%<topic_width>);
        mqtt_pub_topic[%<topic_width>] = '\0';
        GO_communication_esp_mqtt_publish(
            mqtt_pub_topic,
            (const uint8_t *)%<LibBlockInputSignalAddr(1, "", "", 0)>,
		%if ISEQUAL(block.RTWdata.len_source, "2")
            (uint16_t)%<LibBlockInputSignal(2, "", "", 0)>,
		%else
            (uint16_t)(sizeof(%<dtype>) * %<width>),
		%endif
            (uint8_t)%<qos>,
            (uint8_t)%<retain>
        );
    }
%endfunction
