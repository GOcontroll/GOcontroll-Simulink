%% DEALINGS IN THE SOFTWARE.
%% endinternal
%%***************************************************************************************

%implements sfcn_MQTT_broker "C"

%include "go_platform.tlc"

%% Function: BlockTypeSetup ============================================================
%% Add the ESP communication header once per model.
%function BlockTypeSetup(block, system) void
	%<LibAddToCommonIncludes("GO_communication_esp.h")>
%endfunction

%% Function: BlockInstanceSetup ========================================================
%% Guard against multiple MQTT Broker blocks in the same model.
%function BlockInstanceSetup(block, system) void
	%if EXISTS(::mqtt_broker_initialized)
		%<LibBlockReportError(block, "Multiple MQTT Broker blocks exist in the model. Only one is allowed.")>
	%endif
	%assign ::mqtt_broker_initialized = 1
%endfunction

%% Function: Start =====================================================================
%% Generates:
%%   - GO_communication_esp_set_modem_config(apn, sim_pin) (modem APN + optional SIM PIN)
%%   - GO_communication_esp_enable_lte(true)              (start LTE modem on ESP)
%%   - GO_communication_esp_set_mqtt_config(...)           (broker credentials)
%%   - GO_communication_esp_enable_mqtt(true)             (start MQTT client on ESP)
%function Start(block, system) Output
	%assign platform = get_platform()
	%if !ISEQUAL(platform, "STM")
		%<LibBlockReportError(block, "The MQTT Broker block is only supported on the Moduline S1 target.")>
	%endif

	%% Extract modem parameters from the mask RTWdata struct.
	%assign apn        = block.RTWdata.apn
	%assign sim_pin    = block.RTWdata.pin

	%% Extract broker parameters from the mask RTWdata struct.
	%assign url        = block.RTWdata.broker
	%assign port       = block.RTWdata.port
	%assign user       = block.RTWdata.user
	%assign pass       = block.RTWdata.password
	%assign client_id  = block.RTWdata.client
	%assign keep_alive = block.RTWdata.ttl

    GO_communication_esp_set_modem_config(
        "%<apn>",
        "%<sim_pin>"
    );
    GO_communication_esp_enable_lte(true);
    GO_communication_esp_set_mqtt_config(
        "%<url>",
        (uint16_t)%<port>,
        "%<user>",
        "%<pass>",
        "%<client_id>",
        (uint16_t)%<keep_alive>
    );
    GO_communication_esp_enable_mqtt(true);
%endfunction
