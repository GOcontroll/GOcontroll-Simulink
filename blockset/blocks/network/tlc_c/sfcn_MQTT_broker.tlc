%%***************************************************************************************
%% file         sfcn_MQTT_broker.tlc
%% brief        Target Language Compiler file for the MQTT Broker configuration block.
%%              STM target only (STM32H5 + ESP32 via EspInterface over UART).
%%
%%              Generated code (model Start):
%%                1. GO_communication_esp_set_modem_config(apn, sim_pin) - modem APN + SIM PIN
%%                2. GO_communication_esp_enable_lte(true)              - start LTE modem on ESP
%%                3. GO_communication_esp_set_mqtt_config(...)           - broker credentials from mask
%%                4. GO_communication_esp_enable_mqtt(true)             - start MQTT client on ESP
%%
%%              Note: EspInterface_Init(&huart2) is unconditionally generated by
%%              ert_stm_main.tlc - it always runs regardless of which blocks are used.
%%
%%              Mask RTWdata fields expected (set by the mask initialisation callback):
%%                apn        : APN string          (e.g. "internet")
%%                sim_pin    : SIM PIN string       ("" = the PIN set on the controller)
%%                broker     : broker URL string    ("" = the broker set on the controller)
%%                port       : broker port number   (0 = the port set on the controller)
%%                user       : username string      ("" = user + password of the controller)
%%                password   : password string      (used together with user)
%%                client     : client ID string     ("" = the controller serial number)
%%                ttl        : keep-alive interval in seconds (e.g. 60)
%%              Empty fields are sent as such: the ESP fills them from the settings
%%              commissioned on the controller (S1-kennisbank mqtt.md §2.1).
%%
%%---------------------------------------------------------------------------------------
%%                          C O P Y R I G H T
%%---------------------------------------------------------------------------------------
%%  Copyright 2025 (c) by GOcontroll      http://www.gocontroll.com     All rights reserved
