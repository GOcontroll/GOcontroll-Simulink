%implements  sfcn_memory_emulation_read "C"

%include "mem_emu_common.tlc"

%% Function: BlockTypeSetup ==========================================================
%function BlockTypeSetup(block, system) void
	%<mem_emu_type_setup()>
%endfunction

%% Function: Start ==========================================================
%%
%% Purpose:
%%      Code generation for initialization
%%
%function Start(block, system) Output
	%<mem_emu_start()>

	%% Declare a global float to cache the memory value across steps
	%openfile tmpBuf
	float memorySimulation_%<block.RTWdata.key>;
	%closefile tmpBuf

	%assign srcFile = LibGetModelDotCFile()
	%<LibSetSourceFileSection(srcFile, "UserTop", tmpBuf)>

	%if %<block.RTWdata.memType> == 1
		GO_memory_emulation_write("/usr/mem-sim/%<block.RTWdata.key>", %<block.RTWdata.init>, NULL);
		GO_memory_emulation_read("/usr/mem-sim/%<block.RTWdata.key>", &memorySimulation_%<block.RTWdata.key>);
	%elseif %<block.RTWdata.memType> == 2
		GO_memory_emulation_write("/dev/shm/%<block.RTWdata.key>", %<block.RTWdata.init>, NULL);
		GO_memory_emulation_read("/dev/shm/%<block.RTWdata.key>", &memorySimulation_%<block.RTWdata.key>);
	%elseif %<block.RTWdata.memType> == 3
		GO_memory_emulation_write("/etc/go-simulink/%<block.RTWdata.key>", %<block.RTWdata.init>, NULL);
		GO_memory_emulation_read("/etc/go-simulink/%<block.RTWdata.key>", &memorySimulation_%<block.RTWdata.key>);
	%else
		%assign error = "Memory type did not match any valid value: %<block.RTWdata.memType> is not in [1,2,3]"
		%<LibBlockReportError(block, error)>
	%endif
	%<LibBlockOutputSignal(0, "", "", 0)> = memorySimulation_%<block.RTWdata.key>;
%endfunction

%% Function: Outputs ==========================================================
%%
%% Purpose:
%%      Code generation for signal output
%%
%function Outputs(block, system) Output
	%if %<block.RTWdata.memRead> == 2
		%if %<block.RTWdata.memType> == 1
			GO_memory_emulation_read("/usr/mem-sim/%<block.RTWdata.key>", &memorySimulation_%<block.RTWdata.key>);
		%elseif %<block.RTWdata.memType> == 2
			GO_memory_emulation_read("/dev/shm/%<block.RTWdata.key>", &memorySimulation_%<block.RTWdata.key>);
		%elseif %<block.RTWdata.memType> == 3
			GO_memory_emulation_read("/etc/go-simulink/%<block.RTWdata.key>", &memorySimulation_%<block.RTWdata.key>);
		%else
			%assign error = "Memory type did not match any valid value: %<block.RTWdata.memType> is not in [1,2,3]"
			%<LibBlockReportError(block, error)>
		%endif
	%endif
	%<LibBlockOutputSignal(0, "", "", 0)> = memorySimulation_%<block.RTWdata.key>;
%endfunction

%%******************************* end of sfcn_memory_emulation_read.tlc ***************************
