%% Adopted for use by GOcontroll 2024		http://www.gocontroll.com		All right reserved
%% File : can_common_iot.tlc
%% Brief : help functions for the can tlcs

%% Function: CANCommonBlockTypeSetup ========================================
%% 	Declares and initializes all common variables and constants.

%function CANCommonBlockTypeSetup_iot() void
	%if !SLibCodeGenForSim()
		%%<LibAddToCommonIncludes("can_message.h")>
		%<LibAddToCommonIncludes("can.h")>
	%endif
%endfunction

%function CreateCanSocket_iot(CanNum, Baudrate) void
	%assign can_socket = "::can_%<CanNum>"
	%if EXISTS(%<can_socket>) == 0
		%% Mark the socket as created
		%assign %<can_socket> = 1
		%openfile declBuf
			//CAN_HandleTypeDef can_%<CanNum>;
		%closefile declBuf

		%<LibSetSourceFileSection(LibGetModelDotCFile(), "UserTop", declBuf)>

		%openfile assignBuf
			hcan%<CAST("Number", CanNum) + 1>.Instance = CAN%<CAST("Number", CanNum) + 1>;
		%closefile assignBuf

		%<LibMdlStartCustomCode(assignBuf, "declaration")>

		%openfile initBuf
			init_can(&hcan%<CAST("Number", CanNum) + 1>, %<Baudrate>);
		%closefile initBuf

		%<LibMdlStartCustomCode(initBuf, "execution")>

		%openfile startBuf
			HAL_CAN_Start(&hcan%<CAST("Number", CanNum) + 1>);
		%closefile startBuf

		%<LibMdlStartCustomCode(startBuf, "trailer")>
	%endif
%endfunction

%function InitCanSocket_iot(CanNum, Baudrate) Output
	%assign can_socket = "::can_%<CanNum>_init"
	%if EXISTS(%<can_socket>) == 0
		%% Mark the socket as initialized
		%assign %<can_socket> = 1
	%endif
%endfunction
