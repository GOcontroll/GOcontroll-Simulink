%% Adopted for use by GOcontroll 2024		http://www.gocontroll.com		All right reserved
%% File : can_common_iot.tlc
%% Brief : help functions for the can tlcs

%% Function: CANCommonBlockTypeSetup ========================================
%% 	Declares and initializes all common variables and constants.

%function CANCommonBlockTypeSetup_iot() void
	%if !SLibCodeGenForSim()
		%<LibAddToCommonIncludes("can_message.h")>
	%<LibAddToCommonIncludes("can.h")>
	%endif
%endfunction

%function InitCanSocket_iot(CanNum, Baudrate) Output
	%assign can_socket = "::can_%<CanNum>_init"
	%if EXISTS(%<can_socket>) == 0
		%% Mark the socket as initialized
		%assign %<can_socket> = 1
	%endif
%endfunction

%function StartCanTx_iot(module_id_par, hcan) Output
	%assign can_socket = "::can_tx_%<module_id_par>_init"
	%if EXISTS(%<can_socket>) == 0
		%assign %<can_socket> = 1
		%assign can_tx_buf = "::can_%<module_id_par>_tx"
		%assign can_tx_buff = %<can_tx_buf>

		%assign srcFile = LibGetModelDotCFile()
		%openfile define
			#define CAN%<module_id_par>_TX_FREE_MASK 0b1UL
		%closefile define

		%<LibSetSourceFileSection(srcFile, "Defines", define)>

		%openfile queue
			osMessageQueueId_t can%<module_id_par>_tx_queue;
			osEventFlagsId_t can%<module_id_par>_tx_free;
			osThreadId_t can%<module_id_par>_tx_thread;
		%closefile queue

		
		%<LibSetSourceFileSection(srcFile, "Definitions", queue)>

		%openfile decls
			const osThreadAttr_t can%<module_id_par>_tx_thread_attributes = {
					.name = "can%<module_id_par>_tx_thread",
					.stack_size = 128 * 4,
					.priority = (osPriority_t) osPriorityAboveNormal,
				};
		%closefile decls

		%<LibSetSourceFileSection(srcFile, "Declarations", decls)>

		%openfile callback
			void can%<module_id_par>_tx_empty(CAN_HandleTypeDef *hcan){
				osEventFlagsSet(can%<module_id_par>_tx_free, CAN%<module_id_par>_TX_FREE_MASK);
			}

			void can%<module_id_par>_err(CAN_HandleTypeDef *hcan) {
				if (hcan->ErrorCode | HAL_CAN_ERROR_TX_TERR0 || hcan->ErrorCode | HAL_CAN_ERROR_TX_ALST0) {
					hcan->ErrorCode &= ~(HAL_CAN_ERROR_TX_TERR0 | HAL_CAN_ERROR_TX_ALST0 | HAL_CAN_ERROR_TX_TERR1 | HAL_CAN_ERROR_TX_ALST1 | HAL_CAN_ERROR_TX_TERR2 | HAL_CAN_ERROR_TX_ALST2);
					if (HAL_CAN_GetTxMailboxesFreeLevel(&%<hcan>))
						osEventFlagsSet(can%<module_id_par>_tx_free, CAN%<module_id_par>_TX_FREE_MASK);
				}
			}
		%closefile callback

		%<LibSetSourceFileSection(srcFile, "Functions", callback)>

		%openfile task
			void can%<module_id_par>TxThread(void* args) {
				CAN_TxHeaderTypeDef header = {0};
				struct can_frame message;
				uint32_t dummy;

				osEventFlagsSet(can%<module_id_par>_tx_free, CAN%<module_id_par>_TX_FREE_MASK);

				while (1) {
					while(HAL_CAN_GetTxMailboxesFreeLevel(&%<hcan>)) {
						osMessageQueueGet(can%<module_id_par>_tx_queue, &message, 0 , osWaitForever);
						%% Transmit CAN_MESSAGE
						header.DLC = can_packed_dlc(&message);

						%%Set ID and flags
						if (can_packed_is_ExtId(&message)) {
							header.ExtId = message.id;
							header.IDE = CAN_ID_EXT;
						} else {
							header.StdId = message.id;
							header.IDE = CAN_ID_STD;
						}
						if (can_packed_is_RTR(&message))
							header.RTR = CAN_RTR_REMOTE;
						dbg("can tx stack free: %d\n", osThreadGetStackSpace(osThreadGetId()));
						dbg("sending CAN message, dlc: %d, id: %x\ndata: [", header.DLC, message.id);
						for (int i = 0; i < header.DLC; i++) {
							dbg("%02x,", message.data[i]);
						}
						dbg("]\n");
						HAL_CAN_AddTxMessage(&hcan%<module_id_par>, &header, message.data,&dummy);
					}
					osEventFlagsClear(can%<module_id_par>_tx_free, CAN%<module_id_par>_TX_FREE_MASK);
					osEventFlagsWait(can%<module_id_par>_tx_free, CAN%<module_id_par>_TX_FREE_MASK,osFlagsWaitAny | osFlagsNoClear, osWaitForever);
				}
			}
		%closefile task

		%<LibSetSourceFileSection(srcFile, "Functions", task)>

		%openfile initBuf
			can%<module_id_par>_tx_free = osEventFlagsNew(NULL);
			can%<module_id_par>_tx_queue = osMessageQueueNew(%<can_tx_buff>, sizeof(struct can_frame), NULL);
		%closefile initBuf
		%<LibMdlStartCustomCode(initBuf, "execution")>


		HAL_NVIC_SetPriority(CAN%<module_id_par>_TX_IRQn, 10, 0);
		HAL_NVIC_EnableIRQ(CAN%<module_id_par>_TX_IRQn);
		if (%<hcan>.State == HAL_CAN_STATE_LISTENING)
			HAL_CAN_Stop(&%<hcan>);
		if(HAL_CAN_RegisterCallback(&%<hcan>,
								 HAL_CAN_TX_MAILBOX0_COMPLETE_CB_ID,
								 can%<module_id_par>_tx_empty) != HAL_OK)
			err("Could not register mbox callback: 0x%x\n", %<hcan>.ErrorCode);
		if(HAL_CAN_RegisterCallback(&%<hcan>,
								 HAL_CAN_ERROR_CB_ID,
								 can%<module_id_par>_err) != HAL_OK)
			err("Could not register error callback: 0x%x\n", %<hcan>.ErrorCode);
		if (HAL_CAN_ActivateNotification(&%<hcan>, CAN_IT_TX_MAILBOX_EMPTY) != HAL_OK)
			err("Could not activate notification: 0x%x\n", %<hcan>.ErrorCode);
		if (%<hcan>.State != HAL_CAN_STATE_LISTENING)
			HAL_CAN_Start(&%<hcan>);
		can%<module_id_par>_tx_thread = osThreadNew(can%<module_id_par>TxThread, NULL, &can%<module_id_par>_tx_thread_attributes);
	%endif
%endfunction