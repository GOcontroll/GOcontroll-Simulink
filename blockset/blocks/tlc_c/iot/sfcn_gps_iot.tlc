%function GPSBlockTypeSetup_iot(block, system) void
	%<LibAddToCommonIncludes("cmsis_os2.h")>
	%<LibAddToCommonIncludes("gps.h")>
	%<LibAddToCommonIncludes("uart_handler.h")>
	%<LibAddToCommonIncludes("print.h")>
	%openfile variables
		osThreadId_t simcom_tx_thread;

		const osThreadAttr_t simcom_tx_thread_attributes = {
			.name = "simcom_tx_thread",
			.stack_size = 128 * 4,
			.priority = (osPriority_t) osPriorityAboveNormal,
		};

		osThreadId_t simcom_rx_thread;

		const osThreadAttr_t simcom_rx_thread_attributes = {
			.name = "simcom_rx_thread",
			.stack_size = 128 * 4,
			.priority = (osPriority_t) osPriorityAboveNormal,
		};

		osThreadId_t gps_thread;

		const osThreadAttr_t gps_thread_attributes = {
			.name = "gps_thread",
			.stack_size = 128 * 8,
			.priority = (osPriority_t) osPriorityNormal,
		};

		const osMutexAttr_t gps_data_lock_attr = {
			.name = "gps_data_lock",
			.attr_bits = osMutexPrioInherit,
			.cb_mem = NULL,
			.cb_size = 0U,
		};

		static struct gps_data gps_data = {0};
		static osMutexId_t gps_data_lock;
		struct gps_thread_args gps_thread_args;
	%closefile variables
	%<LibSetSourceFileSection(LibGetModelDotCFile(), "Declarations", variables)>
%endfunction

%% Function: Start ==========================================================
%%
%% Purpose:
%%      Code generation for initialization
%%
%function GPSStart_iot(block, system) Output
	SimcomInit();
	simcom_rx_thread = osThreadNew(SimcomRxThread, NULL, &simcom_rx_thread_attributes);
	simcom_tx_thread = osThreadNew(SimcomTxThread, NULL, &simcom_tx_thread_attributes);

	gps_data_lock = osMutexNew(&gps_data_lock_attr);
	if (gps_data_lock != NULL) {
		gps_thread_args.gps_data = &gps_data;
		gps_thread_args.gps_data_lock = gps_data_lock;
		gps_thread_args.thread_run = 1;
		gps_thread = osThreadNew(ReadGpsThread, &gps_thread_args, &gps_thread_attributes);
	} else {
		err("Could not initialize data lock\n");
	}
%endfunction

%% Function: Outputs ==========================================================
%%
%% Purpose:
%%      Code generation for signal output
%%
%function GPSOutputs_iot(block, system) Output
	if (!osMutexAcquire(gps_data_lock, 1)) {
		%<LibBlockOutputSignal(0, "", "", 0)> = gps_data.longitude;
		%<LibBlockOutputSignal(1, "", "", 0)> = gps_data.latitude;
		%<LibBlockOutputSignal(2, "", "", 0)> = gps_data.altitude;
		%<LibBlockOutputSignal(3, "", "", 0)> = gps_data.velocity;
		%<LibBlockOutputSignal(4, "", "", 0)> = gps_data.year;
		%<LibBlockOutputSignal(5, "", "", 0)> = gps_data.month;
		%<LibBlockOutputSignal(6, "", "", 0)> = gps_data.day;
		%<LibBlockOutputSignal(7, "", "", 0)> = gps_data.hour;
		%<LibBlockOutputSignal(8, "", "", 0)> = gps_data.minute;
		%<LibBlockOutputSignal(9, "", "", 0)> = gps_data.second;
		osMutexRelease(gps_data_lock);
	}
%endfunction

%function GPSTerminate_iot(block, system) Output
	gps_thread_args.thread_run = 0;
%endfunction

