%function k30BlockInstanceSetup_iot(block, system) void
	%<LibAddToCommonIncludes("GocontrollProcessorboardSupply.h")>
	%<LibAddToCommonIncludes("GocontrollProcessorboard.h")>
	%<LibAddToCommonIncludes("adc.h")>
	%<LibAddToCommonIncludes("cmsis_os.h")>
	%if EXISTS(::lowest_adc_sample_time)
		%if %<block.ParamSettings.sample_time> < %<::lowest_adc_sample_time>
			%assign ::lowest_adc_sample_time = %<block.ParamSettings.sample_time>
		%endif
	%else
		%assign ::lowest_adc_sample_time = %<block.ParamSettings.sample_time>
	%endif
%endfunction

%% Function: Start ==========================================================
%%
%% Purpose:
%%      Code generation for initialization
%%
%function k30Start_iot(block, system) Output
	%if EXISTS("adc_thread") == 0
		%assign ::adc_thread = 1

		%if EXISTS(::processorboard_hw) == 0
			%assign ::processorboard_hw = 1
			%openfile tmpBuf
			GocontrollProcessorboard_GetHardwareVersion();
			%closefile tmpBuf

			%<LibMdlStartCustomCode(tmpBuf, "execution")>
		%endif

		%openfile buff
		osThreadId_t adc_thread;

		const osThreadAttr_t adc_thread_attributes = {
		.name = "adc_thread",
		.stack_size = 128 * 4,
		.priority = (osPriority_t) osPriorityNormal,
		};

		struct ControllerSupplyThreadArgs adc_thread_args;
		%closefile buff

		%<LibSetSourceFileSection(LibGetModelDotCFile(), "Declarations", buff)>

		adc_thread_args.sample_time = %<::lowest_adc_sample_time>;
		adc_thread_args.thread_run = 1;
		adc_thread = osThreadNew(GocontrollProcessorboardSupply_ReadAdcThread, &adc_thread_args, &adc_thread_attributes);
	%endif
%endfunction

%% Function: Outputs ==========================================================
%%
%% Purpose:
%%      Code generation for signal output
%%
%function k30Outputs_iot(block, system) Output
	/* Get the battery voltage in mV */
	GocontrollProcessorboardSupply_Voltage(1,%<LibBlockOutputSignalAddr(0, "", "", 0)>);
%endfunction

%function k30Terminate_iot(block, system) Output
	%% Kill the adc thread
	%if EXISTS("terminate_adc_thread") == 0
		%assign ::terminate_adc_thread = 1
		adc_thread_args.thread_run = 0;
	%endif
%endfunction

