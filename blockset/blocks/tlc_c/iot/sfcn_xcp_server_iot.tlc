%%***************************************************************************************
%% Updated for STM32H5 FDCAN

%include "can_common_iot.tlc"

%function XcpBlockTypeSetup_iot(block, system) void
%endfunction

%function XcpBlockInstanceSetup_iot(block, system) void
	%if EXISTS(::xcp_socket) == 0
		%if ISEQUAL(%<block.RTWdata.server_type>, 3)
			%assign module_id_par = %<CAST("Number", block.RTWdata.can_if) + 1>
			%assign hfdcan = "hfdcan%<module_id_par>"
			%openfile tmpBufDecls
				osThreadId_t xcp_thread;

				const osThreadAttr_t xcp_thread_attributes = {
					.name = "xcp_thread",
					.stack_size = 128 * 4,
					.priority = (osPriority_t) osPriorityAboveNormal,
				};
			%closefile tmpBufDecls
			%<LibSetSourceFileSection(LibGetModelDotCFile(), "Declarations", tmpBufDecls)>
		%endif

		%assign ::xcp_socket = 1
	%else
		%<LibBlockReportError(block, "Multiple xcp server blocks exist in the model, this is not allowed")>
	%endif
%endfunction


%function XcpStart_iot(block, system) Output
	%assign module_id_par = %<CAST("Number", block.RTWdata.can_if) + 1>
	%assign hfdcan = "hfdcan%<module_id_par>"
	%switch (%<block.RTWdata.server_type>)
		%case 3
			%<StartCanTx_iot(module_id_par, hfdcan)>
			XcpInit_can(
					&%<hfdcan>,
					can%<module_id_par>_tx_queue,
					%<block.RTWdata.send_id>,
					%<block.RTWdata.receive_id>,
					%<block.RTWdata.send_id_ext>,
					%<block.RTWdata.receive_id_ext>
			);
			xcp_thread = osThreadNew(XcpThread_can, NULL, &xcp_thread_attributes);
			%break
		%default
			%<LibBlockReportError(block, "Invalid XCP server type selected, iot controller only supports xcp over CAN")>
	%endswitch
%endfunction


%function XcpTerminate_iot (block, system) Output
	XcpStopConnection();
%endfunction
