%function XcpBlockTypeSetup_iot(block, system) void
%endfunction


%function XcpBlockInstanceSetup_iot(block, system) void
	%if EXISTS(::xcp_socket) == 0
		%assign ::xcp_socket = 1
	%else
		%<LibBlockReportError(block, "Multiple xcp server blocks exist in the model, this is not allowed")>
	%endif
%endfunction


%function XcpStart_iot(block, system) Output
	%switch (%<block.RTWdata.server_type>)
		%case 3
			InitXcpCan(&can_%<block.RTWdata.can_if>, %<block.RTWdata.send_id>, %<block.RTWdata.receive_id>);
			%break
		%default
			%<LibBlockReportError(block, "Invalid XCP server type selected, iot controller only supports xcp over CAN")>
	%endswitch
%endfunction


%function XcpTerminate_iot (block, system) Output
	XcpStopConnection();
%endfunction
