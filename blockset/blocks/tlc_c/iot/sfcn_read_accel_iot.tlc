%function AccelBlockTypeSetup_iot(block, system) void
	%<LibAddToCommonIncludes("i2c.h")>
%endfunction

%function AccelBlockInstanceSetup_iot(block, system) void
	%%verify that there is only one instance of this block
	%if EXISTS("read_accel") == 0
		%assign ::read_accel = 1
	%else
		%<LibBlockReportError(block, "There cannot be more than one read accelerometer blocks in a model")>
	%endif
%endfunction

%% Function: Start ==========================================================
%%
%% Purpose:
%%      Code generation for initialization
%%
%function AccelStart_iot(block, system) Output
	MX_I2C2_Init();
	{
		%assign freq_arr = [1, 1, 2, 3, 4, 5]
		%assign scale_arr= [0, 2, 1, 3]
		uint8_t data = (%<freq_arr[block.RTWdata.sampling_frequency]> << 4) + (%<scale_arr[block.RTWdata.scale]> << 2);
		HAL_I2C_Mem_Write(&hi2c2, 0xd6, 0x10, 1, &data, 1, 1000);
	}
%endfunction

%% Function: Outputs ==========================================================
%%
%% Purpose:
%%      Code generation for signal output
%%
%function AccelOutputs_iot(block, system) Output
	{
		%assign scale_arr= [0.061, 0.122, 0.244, 0.488]
		uint8_t data[6];
		int16_t result;

		HAL_I2C_Mem_Read(&hi2c2, 0xd6, 0x28, 1, data, 6, 500);
		result = (int16_t)(data[0]+(data[1]<<8));
		%<LibBlockOutputSignal(0, "", "", 0)> = (float)result*%<scale_arr[block.RTWdata.scale]>;
		result = (int16_t)(data[2]+(data[3]<<8));
		%<LibBlockOutputSignal(1, "", "", 0)> = (float)result*%<scale_arr[block.RTWdata.scale]>;
		result = (int16_t)(data[4]+(data[5]<<8));
		%<LibBlockOutputSignal(2, "", "", 0)> = (float)result*%<scale_arr[block.RTWdata.scale]>;
	}
%endfunction