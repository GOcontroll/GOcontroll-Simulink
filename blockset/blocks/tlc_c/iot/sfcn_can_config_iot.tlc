%% File : sfcn_can_config_iot.tlc
%% Brief : tlc file for generating code to setup the CAN interfaces on the moduline iot

%include "can_common_iot.tlc"

%% Function: BlockTypeSetup ====================================================
%function CANConfigBlockTypeSetup_iot(block, system) void
	%<CANCommonBlockTypeSetup_iot()>
%endfunction

%% Function: BlockInstanceSetup ================================================
%function CANConfigBlockInstanceSetup_iot(block, system) void
	%assign canNum = block.RTWdata.canBus
	%assign baudrate = block.RTWdata.baudrate
	%assign autort = block.RTWdata.autort
	%assign can_socket = "::can_%<canNum>"
	%assign can_tx_buff = "::can_%<canNum>_tx"
	%assign can_rx_buff = "::can_%<canNum>_rx"
	%if EXISTS(%<can_socket>) == 0
		%% Mark the socket as created
		%assign %<can_socket> = 1
		%assign %<can_tx_buff> = block.RTWdata.canTxBuff
		%assign %<can_rx_buff> = block.RTWdata.canRxBuff
		%openfile assignBuf
			hcan%<canNum>.Instance = CAN%<canNum>;
		%closefile assignBuf

		%<LibMdlStartCustomCode(assignBuf, "declaration")>

		%openfile initBuf
			init_can(&hcan%<canNum>, %<baudrate>, %<autort>);
		%closefile initBuf

		%<LibMdlStartCustomCode(initBuf, "execution")>
	%else
		%assign error = "2 or more CAN config blocks are configuring CAN %<CAST("Number", CanNum) + 1>, this is not allowed"
		%<LibBlockReportError(block, error)>
	%endif
%endfunction

%% Function: Start =============================================================
%function CANConfigStart_iot(block, system) Output

%endfunction
