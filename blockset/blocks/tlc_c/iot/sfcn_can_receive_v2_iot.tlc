%% File : sfunction_canreceive.tlc
%% Abstract:
%%     TLC file for configuring the CAN RX buffer on the TI TMS570LS3137 MCU
%%
%% References:
%%     BlockTypeSetup() : refs/rtw_tlc.pdf p. 277
%%     Outputs()        : refs/rtw_tlc.pdf p. 281


%% Adopted for use by GOcontroll 2024		http://www.gocontroll.com		All right reserved
%% File : sfcn_can_receive_v2.tlc
%% Brief : tlc file for generating code to receive CAN messages on the Moduline Controllers
%% Updated for STM32H5 FDCAN

%include "can_common_iot.tlc"

%% Function: BlockTypeSetup ====================================================
%function CANrecvv2BlockTypeSetup_iot(block, system) void
	%<CANCommonBlockTypeSetup_iot()>
	%<LibAddToCommonIncludes("print.h")>
%endfunction

%% Function: BlockInstanceSetup ================================================
%function CANrecvv2BlockInstanceSetup_iot(block, system) void
	%assign module_id_par = LibBlockParameterValue(module_id, 0)
	%% There can only be one receive block per socket, check, error if one already exists
	%assign can_recv_socket = "::can_%<module_id_par>_recv"
	%if EXISTS(%<can_recv_socket>) == 1
		%assign error = "2 or more CAN receive blocks are listening on CAN%<module_id_par>, this is not allowed"
		%<LibBlockReportError(block, error)>
	%else
		%% No existing receive block found for this socket, so register it as occupied so the next one can fail
		%assign %<can_recv_socket> = 1
	%endif

	%openfile queue
		osMessageQueueId_t can%<module_id_par>_rx_queue;
	%closefile queue

	%assign srcFile = LibGetModelDotCFile()
	%<LibSetSourceFileSection(srcFile, "Definitions", queue)>

	%openfile callback
		void can%<module_id_par>_rx_pending(FDCAN_HandleTypeDef *hfdcan, uint32_t RxFifo0ITs) {
			FDCAN_RxHeaderTypeDef header;
			struct can_frame message;
			while (HAL_FDCAN_GetRxMessage(hfdcan, FDCAN_RX_FIFO0, &header, message.data) == HAL_OK) {
				can_pack_header(&message, &header);
				osMessageQueuePut(can%<module_id_par>_rx_queue, &message, 0, 0);
			}
		}
	%closefile callback

	%<LibSetSourceFileSection(srcFile, "Functions", callback)>
%endfunction

%% Function: Start =============================================================
%function CANrecvv2Start_iot(block, system) Output
	%assign module_id_par = LibBlockParameterValue(module_id, 0)
	%assign hfdcan = "hfdcan%<module_id_par>"
	%assign can_rx_buf = "::can_%<module_id_par>_rx"
	%assign can_rx_buff = %<can_rx_buf>
	{
		can%<module_id_par>_rx_queue = osMessageQueueNew(%<can_rx_buff>, sizeof(struct can_frame), NULL);

		%% FDCAN GFC reset value (0x0) routes all non-matching frames to RX FIFO0 by default.
		%% XCP block (if present) uses filter element 0 to route its specific ID to FIFO1.
		%if ISEQUAL(%<module_id_par>, 1)
			HAL_NVIC_SetPriority(FDCAN1_IT0_IRQn, 10, 0);
			HAL_NVIC_EnableIRQ(FDCAN1_IT0_IRQn);
		%else
			HAL_NVIC_SetPriority(FDCAN2_IT0_IRQn, 10, 0);
			HAL_NVIC_EnableIRQ(FDCAN2_IT0_IRQn);
		%endif
		if (HAL_FDCAN_RegisterRxFifo0Callback(&%<hfdcan>,
				can%<module_id_par>_rx_pending) != HAL_OK)
			err("Could not register rx callback: 0x%x\n", %<hfdcan>.ErrorCode);
		if (HAL_FDCAN_ActivateNotification(&%<hfdcan>,
				FDCAN_IT_RX_FIFO0_NEW_MESSAGE, 0) != HAL_OK)
			err("Could not activate notification: 0x%x\n", %<hfdcan>.ErrorCode);
	}
%endfunction

%% Function: Outputs ===========================================================
%function CANrecvv2Outputs_iot(block, system) Output
	%if !SLibCodeGenForSim()
		%assign module_id_par = LibBlockParameterValue(module_id, 0)
		%% message will be of the type CAN_MESSAGE, run this command in the matlab console to find the definition:
		%% edit(fullfile(matlabroot, 'toolbox','shared','can','src','scanutil','can_message.h'));
		%assign message = LibBlockOutputSignal(1, "", "", 1)

		{
			struct can_frame sc_frame;

			%% Drain the sockets buffer and decode these messages
			while (!osMessageQueueGet(can%<module_id_par>_rx_queue, &sc_frame, 0, 0)) {
				%% Receive CAN_MESSAGE
				%<message>.Length = can_packed_dlc(&sc_frame);
				%<message>.ID = sc_frame.id;
				%% Check message flags
				%<message>.Extended = can_packed_is_ExtId(&sc_frame);
				%<message>.Remote = can_packed_is_RTR(&sc_frame);

				%%Write all bytes in one go
				*(uint64_t *)&%<message>.Data[0]= *(uint64_t *)&sc_frame.data[0];

				%% Do a function call for every received message
				%foreach callIdx = NumSFcnSysOutputCalls
					%if LibIsEqual(SFcnSystemOutputCall[callIdx].BlockToCall,"unconnected")
						%continue
					%endif
					%% call the downstream system
					%<LibBlockExecuteFcnCall(block, callIdx)>\
				%endforeach
			}
		}
	%endif
%endfunction

%function CANrecvv2Terminate_iot(block, system) Output
%endfunction
