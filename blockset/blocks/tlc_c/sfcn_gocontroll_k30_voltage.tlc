%implements sfcn_gocontroll_k30_voltage "C"

%addincludepath "./linux"
%include "go_platform.tlc"
%include "sfcn_gocontroll_k30_voltage_linux.tlc"

%function BlockInstanceSetup(block, system) void
	%assign platform = get_platform()
	%if ISEQUAL(platform, "i.MX8")
		%<k30BlockInstanceSetup_linux(block, system)>
	%endif
%endfunction

%% Function: Start ==========================================================
%%
%% Purpose:
%%      Code generation for initialization
%%
%function Start(block, system) Output
	%assign platform = get_platform()
	%if ISEQUAL(platform, "i.MX8")
		%<k30Start_linux(block, system)>
	%endif
%endfunction

%% Function: Outputs ==========================================================
%%
%% Purpose:
%%      Code generation for signal output
%%
%function Outputs(block, system) Output
	%assign platform = get_platform()
	%if ISEQUAL(platform, "i.MX8")
		%<k30Outputs_linux(block, system)>
	%endif
%endfunction

%function Terminate(block, system) Output
	%assign platform = get_platform()
	%if ISEQUAL(platform, "i.MX8")
		%<k30Terminate_linux(block, system)>
	%endif
%endfunction

