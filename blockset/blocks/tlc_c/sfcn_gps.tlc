%implements  sfcn_gps "C"

%addincludepath "./linux"
%addincludepath "./iot"
%include "go_platform.tlc"
%include "sfcn_gps_linux.tlc"
%include "sfcn_gps_iot.tlc"

%function BlockTypeSetup(block, system) void
	%assign platform = get_platform()
	%if ISEQUAL(platform, "i.MX8")
		%<GPSBlockTypeSetup_linux(block, system)>
	%elseif ISEQUAL(platform, "IOT")
		%<GPSBlockTypeSetup_iot(block, system)>
	%endif
%endfunction

%function BlockInstanceSetup(block, system) void
	%if EXISTS(::gps)
		%<LibBlockReportError(block, "Only one gps block can be in the model")>
	%else
		%assign ::gps = 1
	%endif
%endfunction

%% Function: Start ==========================================================
%%
%% Purpose:
%%      Code generation for initialization
%%
%function Start(block, system) Output
	%assign platform = get_platform()
	%if ISEQUAL(platform, "i.MX8")
		%<GPSStart_linux(block, system)>
	%elseif ISEQUAL(platform, "IOT")
		%<GPSStart_iot(block, system)>
	%endif
%endfunction

%% Function: Outputs ==========================================================
%%
%% Purpose:
%%      Code generation for signal output
%%
%function Outputs(block, system) Output
	%assign platform = get_platform()
	%if ISEQUAL(platform, "i.MX8")
		%<GPSOutputs_linux(block, system)>
	%elseif ISEQUAL(platform, "IOT")
		%<GPSOutputs_iot(block, system)>
	%endif
%endfunction

%function Terminate(block, system) Output
	%assign platform = get_platform()
	%if ISEQUAL(platform, "i.MX8")
		%<GPSTerminate_linux(block, system)>
	%elseif ISEQUAL(platform, "IOT")
		%<GPSTerminate_iot(block, system)>
	%endif
%endfunction

