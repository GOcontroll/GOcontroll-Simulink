%function get_platform()
	%if EXISTS(::gocontroll_platform)
		%return ::gocontroll_platform
	%else
		%assign modelname = CompiledModel.Name
		%assign target = FEVAL("get_param", modelname, "tlcGOcontrollTarget")
		%if ISEQUAL(target, "GOcontroll Moduline IoT")
			%assign ::gocontroll_platform = "IOT"
		%else
			%assign ::gocontroll_platform = "i.MX8"
		%endif
		%return ::gocontroll_platform
	%endif
%endfunction
