%function XcpBlockTypeSetup_linux(block, system) void
	%<LibAddToCommonIncludes("pthread.h")>
%endfunction


%function XcpBlockInstanceSetup_linux(block, system) void
	%if EXISTS(::xcp_socket) == 0
		%openfile tmpBufDecls
			pthread_t xcp_thread;
			%if ISEQUAL(%<block.RTWdata.server_type>, 3)
				_XCP_CAN_Args xcp_args = {
					"can%<block.RTWdata.can_if>",
					%if ISEQUAL(%<block.RTWdata.send_id_ext>, 1)
						%<block.RTWdata.send_id> | CAN_EFF_FLAG,
					%else
						%<block.RTWdata.send_id>,
					%endif
					%if ISEQUAL(%<block.RTWdata.receive_id_ext>, 1)
						%<block.RTWdata.receive_id> | CAN_EFF_FLAG,
					%else
						%<block.RTWdata.receive_id>,
					%endif
				};
			%endif
		%closefile tmpBufDecls
		%<LibSetSourceFileSection(LibGetModelDotCFile(), "Declarations", tmpBufDecls)>
		%assign ::xcp_socket = 1
	%else
		%<LibBlockReportError(block, "Multiple xcp server blocks exist in the model, this is not allowed")>
	%endif
%endfunction


%function XcpStart_linux(block, system) Output
	%switch (%<block.RTWdata.server_type>)
		%case 1
			pthread_create(&xcp_thread, NULL, &XcpInitialize_tcp, NULL);
			%break
		%case 2
			pthread_create(&xcp_thread, NULL, &XcpInitialize_udp, NULL);
			%break
		%case 3
			pthread_create(&xcp_thread, NULL, &XcpInitialize_can, &xcp_args);
			%break
		%default
			%<LibBlockReportError(block, "Invalid XCP server type selected")>
	%endswitch
%endfunction


%function XcpTerminate_linux (block, system) Output
	pthread_cancel(xcp_thread);
	pthread_join(xcp_thread, NULL);
	XcpStopConnection();
%endfunction