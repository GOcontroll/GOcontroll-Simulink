%% SYSTLC: GOcontroll Embedded Coder \
%%    MAKE: make_rtw EXTMODE: no_ext_comm
%%
%% Copyright 1994-2011 The MathWorks, Inc.
%% Adapted by Jason van Kolfschoten, 2017
%% Adapted by GOcontroll, 2026
%% Abstract: Embedded real-time system target file for GOcontroll Targets.
%%
%selectfile NULL_FILE

%%----------------------------
%% TLC Configuration Variables Section
%%----------------------------
%% Assign code format, language, target type.
%%
%assign CodeFormat = "Embedded-C"
%assign Language   = "C"
%assign TargetType = "RT"

%assign RateBasedStepFcn = 1 	/% Generate only rate-based step functions %/

%% The model_SetEventsForThisBaseRate function is not required for the
%% VxWorks environment, i.e., when using an operating system.
%assign SuppressSetEventsForThisBaseRateFcn = (TargetOS == "VxWorksExample")
%if !EXISTS("InlineSetEventsForThisBaseRateFcn")
  %assign InlineSetEventsForThisBaseRateFcn  = TLC_TRUE
%endif
%if !EXISTS("SuppressMultiTaskScheduler")
  %assign SuppressMultiTaskScheduler = TLC_TRUE
%endif

%assign TargetRegistMutexOp   = 1
%assign TargetRegistSynchroOp = 1
%assign PreCodeGenExecCompliant = 1

%%----------------------------
%% TLC Program Entry Point
%%----------------------------
%% Call entry point function.
%include "codegenentry.tlc"

%%----------------------------
%% RTW_OPTIONS Section
%%----------------------------
/%
  BEGIN_RTW_OPTIONS

  os = computer();

  % -----------------------------------------------------------------------
  % Category header - GOcontroll options
  % default = number of rtwoptions entries that follow (excluding this one)
  % -----------------------------------------------------------------------
  rtwoptions(1).prompt        = 'GOcontroll options';
  rtwoptions(1).type          = 'Category';
  rtwoptions(1).enable        = 'on';
  rtwoptions(1).default       = 11;  % items 2..12
  rtwoptions(1).popupstrings  = '';
  rtwoptions(1).tlcvariable   = '';
  rtwoptions(1).tooltip       = '';
  rtwoptions(1).callback      = '';
  rtwoptions(1).makevariable  = '';

  % -----------------------------------------------------------------------
  % (2) Target selector
  % Changing this popup fires ert_gocontroll_target_changed_callback_handler which
  % shows/hides the target-specific options below.
  % tlcvariable matches what ert_linux_make_rtw_hook.m reads via
  % get_param(model,'tlcGOcontrollTarget').
  % -----------------------------------------------------------------------
  rtwoptions(2).prompt        = 'Target';
  rtwoptions(2).type          = 'Popup';
  rtwoptions(2).default       = 'Moduline S1';
  rtwoptions(2).popupstrings  = 'Moduline S1|Moduline M1|Moduline L4|Moduline HMI1';
  rtwoptions(2).tlcvariable   = 'tlcGOcontrollTarget';
  rtwoptions(2).tooltip       = ['Select the target hardware to build for. ' ...
                                 'Moduline S1 builds for the STM32H5 (STM platform), ' ...
                                 'Moduline M1 / L4 / HMI1 build for embedded Linux.'];
  rtwoptions(2).callback      = 'ert_gocontroll_target_changed_callback_handler(hDlg, hSrc)';

  % -----------------------------------------------------------------------
  % (3) Linux RT priority  [Linux only]
  % -----------------------------------------------------------------------
  rtwoptions(3).prompt        = 'Linux RT priority';
  rtwoptions(3).type          = 'Edit';
  rtwoptions(3).default       = '40';
  rtwoptions(3).tlcvariable   = 'tlcLinuxPriority';
  rtwoptions(3).tooltip       = 'Real-time task priority of the model process on the Linux target';

  % -----------------------------------------------------------------------
  % (4) XCP address (IP)  [Linux only]
  % -----------------------------------------------------------------------
  rtwoptions(4).prompt        = 'XCP address';
  rtwoptions(4).type          = 'Edit';
  rtwoptions(4).default       = '192.168.19.85';
  rtwoptions(4).tlcvariable   = 'tlcXcpTcpAddress';
  rtwoptions(4).tooltip       = 'IP address of the Linux target, written into the generated a2l file';

  % -----------------------------------------------------------------------
  % (5) XCP TCP port  [Linux only]
  % -----------------------------------------------------------------------
  rtwoptions(5).prompt        = 'XCP TCP port';
  rtwoptions(5).type          = 'Edit';
  rtwoptions(5).default       = '50002';
  rtwoptions(5).tlcvariable   = 'tlcXcpTcpPort';
  rtwoptions(5).tooltip       = 'TCP port used for XCP communication with the Linux target';

  % -----------------------------------------------------------------------
  % (6) Compiler  [always visible, options depend on host OS]
  % -----------------------------------------------------------------------
  rtwoptions(6).prompt        = 'Compiler';
  rtwoptions(6).type          = 'Popup';
  rtwoptions(6).tlcvariable   = 'tlcLinuxCompiler';
  rtwoptions(6).tooltip       = 'Compiler to use when building the model';

  if (strcmp(os, 'GLNXA64') || strcmp(os, 'PCWIN64'))
      rtwoptions(6).default      = 'GCC';
      rtwoptions(6).popupstrings = 'GCC|Zig';
  else
      rtwoptions(6).default      = 'Zig';
      rtwoptions(6).popupstrings = 'Zig';
  end

  % -----------------------------------------------------------------------
  % (7) Use precompiled binary  [always visible]
  % -----------------------------------------------------------------------
  rtwoptions(7).prompt        = 'Use precompiled binary';
  rtwoptions(7).type          = 'Popup';
  rtwoptions(7).default       = 'Use precompiled binary';
  rtwoptions(7).popupstrings  = 'Use precompiled binary|Always recompile';
  rtwoptions(7).tlcvariable   = 'tlcUsePrecompiledLib';
  rtwoptions(7).tooltip       = 'STM target: use the cached libGOcontroll_CodeBase.a when available, or recompile the CodeBase on every build';

  % -----------------------------------------------------------------------
  % (8) Delete build files  [always visible]
  % -----------------------------------------------------------------------
  rtwoptions(8).prompt        = 'Delete build files';
  rtwoptions(8).type          = 'Popup';
  rtwoptions(8).default       = 'Keep build files';
  rtwoptions(8).popupstrings  = 'Keep build files|Delete build files after build';
  rtwoptions(8).tlcvariable   = 'tlcDeleteBuildFiles';
  rtwoptions(8).tooltip       = 'Remove slprj/, <model>_generated_code/ and <model>.slxc after a successful build';

  % -----------------------------------------------------------------------
  % (9) Upload  [always visible]
  % 'Auto upload': a successful build puts the application on the controller
  % (ManualUpload from the after_make hook): a Linux controller at the XCP address
  % through its go-upload-server, a Moduline S1 over Bluetooth.
  % 'Do not upload' is the first entry on purpose: a model saved before this
  % option existed falls back to the first entry, and must not start uploading.
  % -----------------------------------------------------------------------
  rtwoptions(9).prompt        = 'Upload';
  rtwoptions(9).type          = 'Popup';
  rtwoptions(9).default       = 'Do not upload';
  rtwoptions(9).popupstrings  = 'Do not upload|Auto upload';
  rtwoptions(9).tlcvariable   = 'tlcAutoUpload';
  rtwoptions(9).tooltip       = ['Auto upload: after a successful build the application is uploaded to the controller. ' ...
                                 'Moduline M1 / L4 / HMI1: to the XCP address, through the go-upload-server on the controller. ' ...
                                 'Moduline S1: over Bluetooth.'];

  % -----------------------------------------------------------------------
  % (10) Upload port  [Linux only]
  % -----------------------------------------------------------------------
  rtwoptions(10).prompt       = 'Upload port';
  rtwoptions(10).type         = 'Edit';
  rtwoptions(10).default      = '8001';
  rtwoptions(10).tlcvariable  = 'tlcUploadPort';
  rtwoptions(10).tooltip      = 'Port of the go-upload-server on the Linux target; the address is the XCP address';

  % -----------------------------------------------------------------------
  % (11) S1 controller  [STM only]
  % -----------------------------------------------------------------------
  rtwoptions(11).prompt       = 'S1 controller';
  rtwoptions(11).type         = 'Edit';
  rtwoptions(11).default      = '';
  rtwoptions(11).tlcvariable  = 'tlcUploadS1Controller';
  rtwoptions(11).tooltip      = ['Serial number (as on the label) or Bluetooth address of the Moduline S1 to upload to. ' ...
                                 'Empty: the Moduline S1 that is in range; with more than one in range the upload stops and lists them.'];

  % -----------------------------------------------------------------------
  % (12) Platform lock  [not shown in the dialog]
  % Empty: every Target can be selected. 'Linux' or 'STM': the model belongs to
  % that platform; the Target callback refuses a Target of the other platform and
  % the build stops on one (go_platform_lock_check). The model templates set it.
  % -----------------------------------------------------------------------
  rtwoptions(12).prompt       = 'Platform lock';
  rtwoptions(12).type         = 'NonUI';
  rtwoptions(12).default      = '';
  rtwoptions(12).tlcvariable  = 'tlcGOcontrollPlatformLock';
  rtwoptions(12).makevariable = '';

  %% Callback fired when the Code Generation panel is shown.
  %% Applies default solver settings and updates option visibility.
  rtwgensettings.SelectCallback    = 'ert_gocontroll_select_callback_handler(hDlg, hSrc)';
  %% Callback fired after the user presses Apply.
  rtwgensettings.PostApplyCallback = 'ert_gocontroll_postapply_callback_handler(hDlg, hSrc)';

  %%----------------------------
  %% rtwgensettings Structure
  %%----------------------------
  rtwgensettings.TargetType     = 'RT';
  rtwgensettings.DerivedFrom    = 'ert.tlc';
  rtwgensettings.BuildDirSuffix = '_generated_code';
  rtwgensettings.Version        = '1';

  END_RTW_OPTIONS
 %/
